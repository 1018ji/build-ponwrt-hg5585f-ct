+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include "an7581-fiberhome-hg5585f-ct-wed.dts"
+
+/* Legacy NPU receive plus host-managed PPE and WED transmit. */
+&{/reserved-memory} {
+	npu_rx_pkt: npu-rx-pkt@98000000 {
+		no-map;
+		reg = <0x0 0x98000000 0x0 0x600000>;
+	};
+
+	npu_rx_ba: npu-rx-ba@98600000 {
+		no-map;
+		reg = <0x0 0x98600000 0x0 0x80000>;
+	};
+};
+
+&npu {
+	reg = <0x0 0x1e900000 0x0 0x313000>,
+	      <0x0 0x1fb30000 0x0 0x2b0>,
+	      <0x0 0x1e800000 0x0 0x78000>;
+	reg-names = "npu", "rx-copy", "rx-sram";
+	resets = <&scuclk EN7581_NPU_RST>, <&scuclk EN7581_GDMA_RST>;
+	reset-names = "npu", "rx-copy";
+	memory-region = <&npu_binary>, <&npu_rx_pkt>, <&npu_rx_ba>;
+	memory-region-names = "binary", "pkt", "ba";
+	airoha,wlan-firmware-abi = "hg5585f-2024";
+	firmware-name = "airoha/en7581_MT7916_npu_rv32.bin",
+			"airoha/en7581_MT7916_npu_data.bin";
+};
+
+&eth {
+	airoha,hg5585f-ppe;
+};
+
+&pcie1 {
+	pcie@0,0 {
+		wifi@0,0 {
+			airoha,hg5585f-rx-offload;
+			airoha,npu-rx-ppe;
+		};
+	};
+};
