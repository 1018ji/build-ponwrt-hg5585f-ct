+ 		goto error;
+ 	stage = "reset";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=reset");
+ 	err = airoha_wed_reset(wed, MTK_WED_RESET_WED);
+ 	if (err)
+ 		goto error;
