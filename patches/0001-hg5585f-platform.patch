diff --git a/files/etc/init.d/mt7916-an-eeprom b/files/etc/init.d/mt7916-an-eeprom
new file mode 100755
index 0000000..910a7eb
--- /dev/null
+++ b/files/etc/init.d/mt7916-an-eeprom
@@ -0,0 +1,21 @@
+#!/bin/sh /etc/rc.common
+# SPDX-License-Identifier: GPL-2.0-only
+
+# Prepare calibration before mtwifi_service (09) and kmodloader (10).
+# Opening a radio from a hotplug callback can otherwise wait for firmware
+# whose extraction is queued behind that same callback on first boot.
+START=08
+
+start() {
+	. /lib/functions.sh
+
+	case "$(board_name)" in
+		fiberhome,hg5585f-ct|fiberhome,hg5585f-cu|znxt,zn515xg-d|h3c,hm2004-du) ;;
+		*) return 0 ;;
+	esac
+
+	FIRMWARE=mt7916-an-eeprom.bin /bin/sh /etc/hotplug.d/firmware/10-mt7916-an-eeprom || {
+		logger -t hg5585f-wifi "component=eeprom event=calibration_failed"
+		return 1
+	}
+}
diff --git a/files/etc/uci-defaults/99-hg5585f-hardware b/files/etc/uci-defaults/99-hg5585f-hardware
new file mode 100755
index 0000000..f4ec657
--- /dev/null
+++ b/files/etc/uci-defaults/99-hg5585f-hardware
@@ -0,0 +1,16 @@
+#!/bin/sh
+. /lib/functions.sh
+case "$(board_name)" in
+    fiberhome,hg5585f-ct) ;;
+    *) exit 0 ;;
+esac
+uci -q batch <<'UCI'
+set firewall.@defaults[0].flow_offloading='1'
+set firewall.@defaults[0].flow_offloading_hw='1'
+set network.globals.packet_steering='0'
+commit firewall
+commit network
+UCI
+/etc/init.d/mt7916-an-eeprom enable
+/etc/init.d/hg5585f-wifi-diag enable
+exit 0
