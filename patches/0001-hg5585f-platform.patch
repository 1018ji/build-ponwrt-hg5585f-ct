+    assert(mt76_npu_legacy_init(&dev.mt76,0)==-EPROBE_DEFER && npu_puts==1);
+    struct airoha_ppe_dev ppe={.ops.prepare_legacy=prepare_ppe};ppe_result=&ppe;
+    memory_error=-EIO;release_error=-EIO;npu_puts=ppe_puts=0;
