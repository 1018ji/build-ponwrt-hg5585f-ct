+    dev.mt76.mmio.npu=&npu;dev.mt76.mmio.npu_legacy_rx=true;dev.mt76.drv=&ops;
+    dev.mt76.q_rx[MT_RXQ_NPU0].queued=dev.mt76.q_rx[MT_RXQ_NPU0].ndesc=256;
+    current_dev=&dev.mt76;peek_result=-EIO;work_calls=0;
+    dev.mt76.mmio.npu_rx_host_errors=UINT64_C(2147483648);
+    assert(mt76_npu_rx_poll(&dev.mt76.napi[MT_RXQ_NPU0],4)==1);
+    assert(work_calls==1 && dev.npu_legacy_failed);
+    assert(dev.mt76.mmio.npu_rx_host_errors==UINT64_C(2147483649));
+    assert(!dev.mt76.mmio.npu_rx_host_packets);
+    puts("PASS: stopped RX rings count errors and schedule recovery; supplier deferral and debug formatting");
+    return 0;
+}''')
+    with tempfile.TemporaryDirectory(prefix='hg5585f-wifi-driver-') as temporary:
+        source, binary = Path(temporary)/'test.c', Path(temporary)/'test'
+        source.write_text('\n\n'.join(pieces))
+        subprocess.run([cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror', '-Wformat=2', '-pthread',
+                        '-fsanitize=address,undefined', str(source), '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+
+def tool_test(root):
+    tool = (root/'files/usr/sbin/hg5585f-wifi-diag').read_text()
+    with tempfile.TemporaryDirectory(prefix='hg5585f-wifi-tool-') as temporary:
+        directory=Path(temporary); commands=directory/'bin';commands.mkdir()
+        parameter=directory/'parameter';parameter.write_text('N\n')
+        state=directory/'state';state.write_text('0')
+        reports=directory/'reports';reports.mkdir()
+        device_tree=directory/'device-tree';device_tree.mkdir()
+        (device_tree/'compatible').write_bytes(b'fiberhome,hg5585f-ct\0airoha,an7581\0')
+        init=directory/'init';init.write_text('#!/bin/sh\nexit 0\n');init.chmod(0o755)
+        mock=commands/'mock'
+        mock.write_text('''#!/usr/bin/env python3
+import os,sys
+from pathlib import Path
+command=Path(sys.argv[0]).name;args=sys.argv[1:];state=Path(os.environ['WIFI_TEST_STATE'])
