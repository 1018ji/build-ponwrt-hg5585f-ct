+static int prepare_ppe(struct airoha_ppe_dev *ppe) { (void)ppe;return 0; }
+'''
+    pieces = [prefix, macro,
+              function(legacy, 'mt7915_npu_is_legacy'),
+              function(legacy, 'mt7915_npu_legacy_fail'),
+              function(legacy, 'mt7915_npu_legacy_poll_complete'),
+              function(rx, 'mt76_npu_legacy_rx_dequeue'),
+              'static struct sk_buff *mt76_npu_dequeue(struct mt76_dev *dev,struct mt76_queue *q,u32 *info)\n{ return mt76_npu_legacy_rx_dequeue(dev,q,info); }',
+              function(npu, 'mt76_npu_rx_poll'),
+              function(npu, 'mt76_npu_legacy_init')]
+    pieces.append(r'''
+static struct airoha_npu *fault_npu;
+static void *fault_thread(void *data)
+{
+    mt7915_npu_legacy_fail(data,fault_npu,-EIO);
+    return NULL;
+}
+int main(void)
+{
+    int evaluated=0;
+    airoha_wlan_dbg(NULL,"test","event=sample error=%d",++evaluated);
+    assert(!evaluated && !record[0]);
