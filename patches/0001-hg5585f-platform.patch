+#!/usr/bin/env python3
+"""Validate DTBs directly or extract the default DTB using U-Boot tools."""
+import argparse
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def get(tree, node, prop, kind='s', optional=False):
+    result = subprocess.run(['fdtget', '-t', kind, str(tree), node, prop],
+                            capture_output=True, text=True)
+    if optional and result.returncode:
+        return None
+    if result.returncode:
+        raise RuntimeError(f'fdtget {node} {prop}: {result.stderr.strip()}')
+    return result.stdout.strip()
+
+
+def check(tree, wed, npu=False):
+    pcie0 = '/soc/pcie@1fc00000'
+    pcie1 = '/soc/pcie@1fc20000'
+    hif2 = pcie0 + '/pcie@0,0/wifi@0,0'
+    primary = pcie1 + '/pcie@0,0/wifi@0,0'
+    provider = '/soc/wed@1fa03000'
+    assert get(tree, '/', 'compatible').split()[0] == 'fiberhome,hg5585f-ct'
+    for node in (pcie0, pcie1):
+        assert get(tree, node, 'status', optional=True) in (None, 'okay', 'ok')
+    for node in (primary, hif2):
+        assert get(tree, node, 'compatible') == 'mediatek,mt76'
+    assert get(tree, primary, 'airoha,npu', 'x') == get(tree, '/soc/npu@1e900000', 'phandle', 'x')
+    assert get(tree, primary, 'airoha,eth', 'x') == get(tree, '/soc/ethernet@1fb50000', 'phandle', 'x')
+    assert get(tree, primary, 'nvmem-cell-names') == 'eeprom'
+    assert get(tree, hif2, 'airoha,wed', 'x', optional=True) is None
+    link = get(tree, primary, 'airoha,wed', 'x', optional=True)
+    if wed or npu:
+        assert link and link == get(tree, provider, 'phandle', 'x')
+        assert get(tree, provider, 'status', optional=True) in (None, 'okay', 'ok')
+        assert get(tree, provider, 'airoha,pcie', 'x') == get(tree, pcie1, 'phandle', 'x')
+        assert get(tree, provider, 'reg', 'x').split() == ['0', '1fa03000', '0', 'b00', '0', '1fa06400', '0', '400']
+        expected = ['airoha/en7581_npu_rv32.bin', 'airoha/en7581_npu_data.bin']
+        if npu:
+            expected = ['airoha/en7581_MT7916_npu_rv32.bin', 'airoha/en7581_MT7916_npu_data.bin']
+        assert get(tree, '/soc/npu@1e900000', 'firmware-name').split() == expected
+    else:
+        assert link is None
+    if npu:
+        node = '/soc/npu@1e900000'
+        assert get(tree, node, 'airoha,wlan-firmware-abi') == 'hg5585f-2024'
+        assert get(tree, node, 'reg-names').split() == ['npu', 'rx-copy', 'rx-sram']
+        assert get(tree, node, 'reg', 'x').split() == [
+            '0', '1e900000', '0', '313000', '0', '1fb30000', '0', '2b0', '0', '1e800000', '0', '78000']
+        assert get(tree, node, 'memory-region-names').split() == ['binary', 'pkt', 'ba']
+        regions = get(tree, node, 'memory-region', 'x').split()
+        assert len(regions) == 3
+        for region, symbol in zip(regions, ['npu_binary', 'npu_rx_pkt', 'npu_rx_ba']):
+            assert region == get(tree, get(tree, '/__symbols__', symbol), 'phandle', 'x')
+        assert get(tree, node, 'reset-names').split() == ['npu', 'rx-copy']
+        for name, expected in [('npu_rx_pkt', ['0', '98000000', '0', '600000']),
+                               ('npu_rx_ba', ['0', '98600000', '0', '80000'])]:
+            reserved = get(tree, '/__symbols__', name)
+            assert get(tree, reserved, 'reg', 'x').split() == expected
+        assert get(tree, primary, 'airoha,hg5585f-rx-offload', 'x', optional=True) is not None
+        assert get(tree, primary, 'airoha,npu-rx-ppe', 'x', optional=True) is not None
+        assert get(tree, '/soc/ethernet@1fb50000', 'airoha,hg5585f-ppe', 'x', optional=True) is not None
+    else:
+        assert get(tree, primary, 'airoha,hg5585f-rx-offload', 'x', optional=True) is None
+    mode = 'NPU RX / PPE / WED TX' if npu else ('WED TX / native RX' if wed else 'native Wi-Fi')
+    print(f'PASS: {tree.name}: {mode}')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument('--wed', action='store_true', help='require the WED TX profile')
+    mode.add_argument('--npu', action='store_true', help='require the NPU RX/PPE/WED profile')
+    parser.add_argument('images', type=Path, nargs='+')
+    args = parser.parse_args()
+    for image in args.images:
+        if image.suffix == '.dtb':
+            check(image, args.wed, args.npu)
+            continue
+        config = get(image, '/configurations', 'default')
+        fdt = get(image, '/configurations/' + config, 'fdt')
+        names = subprocess.check_output(['fdtget', '-l', str(image), '/images'], text=True).split()
+        index = names.index(fdt)
+        with tempfile.TemporaryDirectory(prefix='hg5585f-fit-') as temporary:
+            tree = Path(temporary) / (image.name + '.dtb')
+            subprocess.run(['dumpimage', '-T', 'flat_dt', '-p', str(index),
+                            '-o', str(tree), str(image)], stdout=subprocess.DEVNULL, check=True)
+            check(tree, args.wed, args.npu)
+
+
+if __name__ == '__main__':
+    main()
