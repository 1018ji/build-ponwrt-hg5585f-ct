diff --git a/package/kernel/mt76/patches/120-mt7915-airoha-wed-tx-native-rx.patch b/package/kernel/mt76/patches/120-mt7915-airoha-wed-tx-native-rx.patch
new file mode 100644
index 0000000..35837cd
--- /dev/null
+++ b/package/kernel/mt76/patches/120-mt7915-airoha-wed-tx-native-rx.patch
@@ -0,0 +1,652 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] wifi: mt76: Airoha WED TX with native MT7916 RX
+
+Keep native RX interrupts, station state and software reordering.
+Keep both PCIe HIFs and request the native and WED IRQs independently.
+
+diff --git a/dma.c b/dma.c
+index a67880a..c4fd72a 100644
+--- a/dma.c
++++ b/dma.c
+@@ -1194,12 +1194,17 @@ EXPORT_SYMBOL_GPL(mt76_dma_attach);
+ 
+ void mt76_dma_cleanup(struct mt76_dev *dev)
+ {
++	bool quarantine = mtk_wed_device_active(&dev->mmio.wed) &&
++		mtk_wed_device_quiesce(&dev->mmio.wed);
+ 	int i;
+ 
+ 	mt76_worker_disable(&dev->tx_worker);
+ 	napi_disable(&dev->tx_napi);
+ 	netif_napi_del(&dev->tx_napi);
+ 
++	if (quarantine)
++		goto detach;
++
+ 	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
+ 		struct mt76_phy *phy = dev->phys[i];
+ 		int j;
+@@ -1223,14 +1228,22 @@ void mt76_dma_cleanup(struct mt76_dev *dev)
+ 		page_pool_destroy(q->page_pool);
+ 	}
+ 
++detach:
+ 	if (mtk_wed_device_active(&dev->mmio.wed))
+ 		mtk_wed_device_detach(&dev->mmio.wed);
+ 
+ 	if (mtk_wed_device_active(&dev->mmio.wed_hif2))
+ 		mtk_wed_device_detach(&dev->mmio.wed_hif2);
+ 
++	if (quarantine) {
++		mt76_for_each_q_rx(dev, i)
++			netif_napi_del(&dev->napi[i]);
++		goto free_napi;
++	}
++
+ 	mt76_free_pending_txwi(dev);
+ 	mt76_free_pending_rxwi(dev);
++free_napi:
+ 	free_netdev(dev->napi_dev);
+ 	free_netdev(dev->tx_napi_dev);
+ }
+diff --git a/mac80211.c b/mac80211.c
+index ee3b4f7..22283e1 100644
