+#define WRITE_ONCE(v,x) ((v)=(x))
+#define xchg(p,v) __atomic_exchange_n((p),(v),__ATOMIC_SEQ_CST)
+#define unlikely(v) (v)
+#define PTR_ERR(p) ((int)(intptr_t)(p))
