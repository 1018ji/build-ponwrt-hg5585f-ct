+    airoha_wlan_dbg(NULL,"test","event=sample error=%d",++evaluated);
+    assert(evaluated==1 && !strcmp(record,"hg5585f-wifi: component=test event=sample error=1\n"));
+    struct airoha_npu npu={.wlan_abi=AIROHA_NPU_WLAN_ABI_HG5585F_2024};
+    struct mt76_driver_ops ops={.rx_poll_complete=mt7915_npu_legacy_poll_complete};
+    /* Its callback returns bool internally; wrap it with the driver's void API. */
+    (void)ops;
+    struct mt7915_dev dev={.recovery.hw_init_done=true};
+    dev.mt76.mmio.npu=&npu;dev.mt76.mmio.npu_legacy_rx=true;
+    assert(!mt7915_npu_legacy_poll_complete(&dev.mt76,MT_RXQ_MAIN));
+    assert(mt7915_npu_legacy_poll_complete(&dev.mt76,MT_RXQ_NPU0) && enabled_irqs==1);
+    dev.mt76.q_rx[MT_RXQ_NPU0].stopped=true;
+    assert(mt7915_npu_legacy_poll_complete(&dev.mt76,MT_RXQ_NPU0));
+    assert(dev.npu_legacy_failed && disabled_irqs==2 && work_calls==1);
+    assert(mt7915_npu_legacy_poll_complete(&dev.mt76,MT_RXQ_NPU1));
