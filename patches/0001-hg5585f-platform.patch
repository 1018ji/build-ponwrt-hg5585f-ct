diff --git a/files/usr/sbin/hg5585f-wifi-diag b/files/usr/sbin/hg5585f-wifi-diag
new file mode 100755
index 0000000..901230f
--- /dev/null
+++ b/files/usr/sbin/hg5585f-wifi-diag
@@ -0,0 +1,139 @@
+#!/bin/sh
+# HG5585F diagnostics: switch lifecycle logging and collect bounded snapshots.
+set -eu
+umask 077
+
+parameter=/sys/module/airoha_npu/parameters/wlan_debug
+
+configured() {
+	value=$(uci -q get hg5585f_wifi.main.enabled 2>/dev/null || true)
+	case "$value" in
+		1|on|true|yes) echo 1 ;;
+		0|off|false|no|'') echo 0 ;;
+		*) echo 'Invalid hg5585f_wifi.main.enabled value' >&2; return 2 ;;
+	esac
+}
+
+runtime() {
+	value=$(cat "$parameter" 2>/dev/null || true)
+	case "$value" in
+		Y|y|1) echo 1 ;;
+		N|n|0) echo 0 ;;
+		*) echo unavailable ;;
+	esac
+}
+
+apply_runtime() {
+	[ -w "$parameter" ] || {
+		printf 'hg5585f-wifi: component=diag event=debug_failed reason=parameter_unavailable\n' >&2
+		return 1
+	}
+	printf '%s\n' "$1" > "$parameter"
+	logger -t hg5585f-wifi "component=diag event=debug enabled=$1" || true
+}
+
+capture() {
+	label=$1
+	shift
+	printf '\nsection=%s\n' "$label"
+	"$@" 2>&1 || printf 'result=unavailable\n'
+}
+
+snapshot() {
+	printf 'format=hg5585f-wifi-diag-v1\n'
+	printf 'configured=%s runtime=%s\n' "$(configured)" "$(runtime)"
+	capture kernel uname -a
+	capture uptime cat /proc/uptime
+	capture interrupts cat /proc/interrupts
+	capture softirqs cat /proc/softirqs
+	capture deferred_devices cat /sys/kernel/debug/devices_deferred
+	capture pci lspci -nnk
+	capture radios iw dev
+	capture regulatory iw reg get
+	for property in model compatible soc/npu@1e900000/firmware-name soc/npu@1e900000/airoha,wlan-firmware-abi; do
+		path=/proc/device-tree/$property
+		[ -r "$path" ] || continue
+		printf '\nsection=device_tree property=%s\n' "$property"
+		tr '\000' '\n' < "$path"
+	done
+	printf '\nsection=radio_config\n'
+	# Read only radio settings; never export wifi-iface encryption keys.
+	for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-device$/\1/p'); do
+		case "$radio" in ''|*[!a-zA-Z0-9_]*) continue ;; esac
+		for field in band channel htmode country disabled; do
+			value=$(uci -q get "wireless.$radio.$field" 2>/dev/null || true)
+			printf 'radio=%s field=%s value=%s\n' "$radio" "$field" "${value:-unset}"
+		done
+	done
+	for path in /sys/kernel/debug/ieee80211/phy*/mt76/offload_status; do
+		[ -r "$path" ] || continue
+		capture "$path" cat "$path"
+		# Both PHYs share the same counters and device instance.
+		break
+	done
+	for path in /sys/kernel/debug/airoha-wed /sys/kernel/debug/ppe/config /sys/kernel/debug/ppe/accounting; do
+		[ ! -r "$path" ] || capture "$path" cat "$path"
+	done
+	for interface in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
+		case "$interface" in ''|-*|*[!a-zA-Z0-9_.-]*) continue ;; esac
+		capture "stations:$interface" iw dev "$interface" station dump
+	done
+	capture firmware sha256sum /lib/firmware/airoha/en7581*_npu_*.bin
+}
+
+logs() {
+	logread 2>/dev/null | tail -n 2000 |
+		awk '/hg5585f-wifi|hostapd|wpa_supplicant|netifd|mt7915|mt76|airoha.*(npu|wed)/' || true
+}
+
+usage() {
+	echo "Usage: $0 {on|off|status|snapshot|collect [seconds:1-60]}" >&2
+	exit 2
+}
+
+command=${1:-status}
+case "$command" in
+	on|off)
+		[ "$#" -eq 1 ] || usage
+		enabled=0
+		[ "$command" != on ] || enabled=1
+		uci set "hg5585f_wifi.main.enabled=$enabled"
+		uci commit hg5585f_wifi
+		/etc/init.d/hg5585f-wifi-diag enable
+		apply_runtime "$enabled"
+		printf 'hg5585f-wifi: component=diag event=debug enabled=%s persistent=1\n' "$enabled"
+		;;
+	apply)
+		[ "$#" -eq 1 ] || usage
+		apply_runtime "$(configured)"
+		;;
+	runtime-off)
+		[ "$#" -eq 1 ] || usage
+		apply_runtime 0
+		;;
+	status)
+		[ "$#" -le 1 ] || usage
+		printf 'hg5585f-wifi: component=diag event=status configured=%s runtime=%s\n' "$(configured)" "$(runtime)"
+		;;
+	snapshot)
+		[ "$#" -eq 1 ] || usage
+		snapshot
+		;;
+	collect)
+		[ "$#" -le 2 ] || usage
+		period=${2:-15}
+		case "$period" in ''|*[!0-9]*|0*) usage ;; esac
+		[ "$period" -le 60 ] || usage
+		report=$(mktemp -d /tmp/hg5585f-wifi-diag.XXXXXX)
+		snapshot > "$report/before.txt"
+		logs > "$report/log-before.txt"
+		printf 'hg5585f-wifi: component=diag event=collect seconds=%s report=%s\n' "$period" "$report"
+		sleep "$period"
+		snapshot > "$report/after.txt"
+		logs > "$report/log-after.txt"
+		dmesg 2>/dev/null | tail -n 1000 > "$report/kernel.txt" || true
+		tar -C "$report" -czf "$report.tar.gz" .
+		printf 'hg5585f-wifi: component=diag event=collected archive=%s.tar.gz\n' "$report"
+		;;
+	*) usage ;;
+esac
diff --git a/files/usr/sbin/hg5585f-wifi-offload-check b/files/usr/sbin/hg5585f-wifi-offload-check
new file mode 100755
index 0000000..56d0848
--- /dev/null
+++ b/files/usr/sbin/hg5585f-wifi-offload-check
@@ -0,0 +1,119 @@
+#!/bin/sh
+# Read-only sample of WED, the NPU return queues and PPE entries.
+set -eu
+
+period=${1:-15}
+case "$period" in
+	''|*[!0-9]*) echo "Usage: $0 [seconds: 1-60]" >&2; exit 2 ;;
+esac
+[ "$period" -ge 1 ] && [ "$period" -le 60 ] || exit 2
+
+status=/sys/kernel/debug/airoha-wed
+accounting=/sys/kernel/debug/ppe/accounting
+npu_status=
+for candidate in /sys/kernel/debug/ieee80211/phy*/mt76/offload_status; do
+	[ -r "$candidate" ] || continue
+	npu_status=$candidate
+	break
+done
+[ -r "$status" ] || [ -n "$npu_status" ] || [ -r "$accounting" ] || {
+	echo "Offload status unavailable. Check debugfs and the HG5585F image profile."
+	exit 1
+}
+report=$(mktemp -d /tmp/hg5585f-wifi-offload.XXXXXX)
+[ ! -r "$accounting" ] || cat "$accounting" > "$report/accounting-before"
+[ ! -r "$status" ] || cat "$status" > "$report/before"
+if [ -n "$npu_status" ]; then
+	printf '%s\n' "$npu_status" > "$report/npu-source"
+	cat "$npu_status" > "$report/npu-before"
+fi
+iw dev > "$report/interfaces" 2>&1 || true
+for interface in /sys/class/net/phy*-ap*; do
+	[ -d "$interface" ] || continue
+	interface=${interface##*/}
+	iw dev "$interface" station dump > "$report/$interface.stations" 2>&1 || true
+done
+echo "During this $period second sample, send traffic in both directions between wired and Wi-Fi clients."
+sleep "$period"
+[ ! -r "$accounting" ] || cat "$accounting" > "$report/accounting-after"
+[ ! -r "$status" ] || cat "$status" > "$report/after"
+if [ -n "$npu_status" ]; then
+	cat "$npu_status" > "$report/npu-after"
+	cat "$report/npu-after"
+	awk '
+		FNR == NR { previous[$1] = $2; next }
+		$1 == "rx_mode:" || $1 == "rx_configured:" ||
+		$1 == "rx_ppe_configured:" || $1 == "ppe_attached:" ||
+		$1 == "quarantined:" {
+			if ($2 != previous[$1]) changed = 1
+		}
+		$1 == "host_rx_packets:" || $1 == "host_rx_errors:" {
+			delta = $2 - previous[$1]
+			if (delta < 0) changed = 1
+			printf "NPU CPU-return delta %s %.0f\n", $1, delta
+		}
+		END {
+			if (changed) print "NPU sample inconclusive: state changed or counters reset."
+		}
+	' "$report/npu-before" "$report/npu-after"
+	echo "Both PHYs share these counters; only one PHY is sampled."
+	echo "CPU-return counters exclude NPU hardware forwarding; a zero delta does not prove failure."
+fi
+awk '$2 == "BND" { print }' /sys/kernel/debug/ppe/entries > "$report/ppe-bound" 2>/dev/null || true
+if [ -f "$report/before" ] && [ -f "$report/after" ]; then
+cat "$report/after"
+awk '
+	FNR == NR { previous[$1] = $2; next }
+	$1 == "attached:" || $1 == "running:" {
+		if ($2 != 1 || previous[$1] != 1) invalid = 1
+	}
+	$1 ~ /^tx[01]_mib:$/ {
+		delta = $2 - previous[$1]
+		if (delta < 0) invalid = 1
+		total += delta
+	}
+	END {
+		if (invalid) {
+			print "Result: inconclusive; transport state changed or counters reset."
+			exit
+		}
+		printf "WED TX MIB progress: %.0f\n", total
+		if (!total) print "Result: inconclusive; no TX counter progress in this sample."
+		else print "Result: WED TX hardware progress observed."
+	}
+' "$report/before" "$report/after"
+fi
+if [ -f "$report/accounting-before" ] && [ -f "$report/accounting-after" ]; then
+	awk '
+		FNR == NR {
+			if ($1 == "group") { packets[$2] = $3; bytes[$2] = $4 }
+			else previous[$1] = $2
+			next
+		}
+		$1 == "running:" { if ($2 != 1 || previous[$1] != 1) invalid = 1 }
+		$1 == "generation:" { if ($2 != previous[$1]) invalid = 1 }
+		$1 == "samples:" { if ($2 <= previous[$1]) invalid = 1 }
+		$1 == "group" {
+			packet_delta[$2] = $3 - packets[$2]
+			byte_delta[$2] = $4 - bytes[$2]
+			if (packet_delta[$2] < 0 || byte_delta[$2] < 0) invalid = 1
+		}
+		END {
+			if (invalid) {
+				print "PPE accounting inconclusive: stopped, restarted or no new sample."
+				exit
+			}
+			for (group in packet_delta) {
+				if (!packet_delta[group] && !byte_delta[group]) continue
+				printf "PPE account group %s delta: packets=%.0f bytes=%.0f\n", \
+					group, packet_delta[group], byte_delta[group]
+				progress = 1
+			}
+			if (!progress) print "PPE accounting: no hardware counter progress in this sample."
+		}
+	' "$report/accounting-before" "$report/accounting-after"
+	echo "PPE groups are shared by both engines and may contain multiple flows."
+	echo "Use account_group in PPE entries to identify the corresponding group."
+fi
+echo "Correlate PPE BND entries and hardware counters with the test endpoints; configuration alone does not prove forwarding."
+echo "Report: $report"
diff --git a/files/usr/sbin/pin-wifi-cpus.sh b/files/usr/sbin/pin-wifi-cpus.sh
new file mode 100755
index 0000000..a995eb8
--- /dev/null
+++ b/files/usr/sbin/pin-wifi-cpus.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# 精确匹配内核线程 comm，将 mt76-tx 与 6 个 napi/phy0-0 线程打散到 4 个核心
+idx=0
+for pid in $(ls /proc | grep '^[0-9]*$' | sort -n); do
+    [ -r "/proc/$pid/comm" ] || continue
+    read -r cname < "/proc/$pid/comm" 2>/dev/null || continue
+    case "$cname" in
+        mt76-tx*)
+            taskset -p 8 "$pid" >/dev/null 2>&1
+            ;;
+        napi/phy0-0)
+            case $((idx % 6)) in
+                0|1|2) mask=1 ;;
+                3)     mask=2 ;;
+                4|5)   mask=4 ;;
+            esac
+            taskset -p "$mask" "$pid" >/dev/null 2>&1
+            idx=$((idx + 1))
+            ;;
+    esac
+done
