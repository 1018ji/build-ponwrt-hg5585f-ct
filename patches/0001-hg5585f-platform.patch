+static struct airoha_ppe_dev *ppe_result;
+static int modules,npu_puts,ppe_puts,memory_error,release_error;
+static struct airoha_npu *airoha_npu_get(void *dev) { (void)dev;return get_result; }
+static void request_module(const char *name) { (void)name;modules++; }
+static void airoha_npu_put(struct airoha_npu *npu) { assert(npu);npu_puts++; }
+static struct airoha_ppe_dev *airoha_ppe_get_dev(void *dev) { (void)dev;return ppe_result; }
+static void airoha_ppe_put_dev(struct airoha_ppe_dev *ppe) { assert(ppe);ppe_puts++; }
+static int airoha_npu_wlan_legacy_acquire(struct airoha_npu *npu,void *dev)
