+#define IS_ERR(p) ((uintptr_t)(p) >= (uintptr_t)-4095)
+#define IS_ERR_OR_NULL(p) (!(p) || IS_ERR(p))
+#define upper_32_bits(v) ((u64)(v) >> 32)
+#define rcu_read_lock() do {} while (0)
+#define rcu_read_unlock() do {} while (0)
+#define rcu_dereference(v) (v)
+#define rcu_assign_pointer(v,x) ((v)=(x))
+#define container_of(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
+enum mt76_rxq_id { MT_RXQ_MAIN, MT_RXQ_BAND1, MT_RXQ_NPU0, MT_RXQ_NPU1 };
+struct sk_buff { int unused; };
+struct napi_struct { void *dev; };
+struct mt76_queue { bool stopped; unsigned int queued,ndesc,tail,cpu_idx; };
+struct airoha_wlan_legacy_rx_meta { u32 total,info,data; };
+struct airoha_npu { unsigned int wlan_abi; void *dev; };
+struct airoha_ppe_dev { struct { int (*prepare_legacy)(struct airoha_ppe_dev *); } ops; };
+struct mt76_dev;
+struct mt76_driver_ops {
+    void (*rx_skb)(struct mt76_dev *,enum mt76_rxq_id,struct sk_buff *,u32 *);
