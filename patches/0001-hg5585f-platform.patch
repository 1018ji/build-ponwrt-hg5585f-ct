+{ assert(npu && q>=0 && q<2);enabled_irqs++; }
+static void airoha_npu_wlan_disable_irq(struct airoha_npu *npu,int q)
+{ assert(npu && q>=0 && q<2);disabled_irqs++; }
+static void dev_err_ratelimited(void *dev,const char *format,...)
+{ (void)dev;(void)format; }
+static bool debug_enabled;
