++/* Called from the mt7915 hard IRQ handler with mask 0 on every interrupt. */
++static void airoha_wed_irq_storm_check(struct airoha_wed *aw)
++{
++	unsigned long now = jiffies, window = READ_ONCE(aw->irq_window);
++	u32 raw, ext;
++
++	if (atomic_read(&aw->irq_storm))
