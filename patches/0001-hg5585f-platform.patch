+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: support HG5585F NPU RX and host PPE
+
+Use the explicit HG5585F 2024 firmware ABI. Keep native board profiles.
+Validate receive SRAM and descriptor ownership before enabling Wi-Fi DMA.
+
+diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
+index 890d288..e769466 100644
+--- a/drivers/net/ethernet/airoha/Kconfig
++++ b/drivers/net/ethernet/airoha/Kconfig
+@@ -15,6 +15,18 @@ config NET_AIROHA_NPU
+ 	  This driver supports Airoha Network Processor (NPU) available
+ 	  on the Airoha Soc family.
+ 
++config NET_AIROHA_NPU_HG5585F
++	bool "HG5585F 2024 NPU WLAN protocol (experimental)"
++	depends on NET_AIROHA_NPU && EXPERT
++	default n
++	help
++	  Support the fixed-size WLAN mailbox protocol used by the 2024
++	  HG5585F MT7916 firmware. Selection also requires an explicit
++	  airoha,wlan-firmware-abi device-tree property and firmware-name.
++	  The MT7916 RX frontend requires a separate explicit Wi-Fi overlay.
++	  It provides CPU-return queues and optional host-managed PPE forwarding.
++	  Upstream PPE operations are rejected for this firmware ABI.
++
+ config NET_AIROHA
+ 	tristate "Airoha SoC Gigabit Ethernet support"
+ 	depends on NET_DSA || !NET_DSA
+@@ -35,8 +47,19 @@ config NET_AIROHA_WED
+ 	help
+ 	  Enable the HG5585F WED1/WDMA1 transmit provider for MT7916D.
+ 	  Requires an explicit WED device-tree overlay and mt7915e.wed_enable=1.
+-	  Retains the upstream NPU firmware for PPE and software Wi-Fi RX.
+-	  This provider does not support NPU receive offloading.
++	  Uses the upstream NPU firmware or explicit host-managed legacy PPE.
++	  A separate combined overlay allows legacy NPU receive/reorder with
++	  CPU return queues and optional PPE forwarding alongside WED transmit.
++
++config NET_AIROHA_PPE_HG5585F
++	bool "HG5585F host-managed PPE (experimental)"
++	depends on NET_AIROHA && NET_AIROHA_NPU_HG5585F && EXPERT
++	default n
++	help
++	  Initialize the EN7581 PPE directly from Linux when using the
++	  HG5585F 2024 NPU firmware. Requires airoha,hg5585f-ppe on the
++	  Ethernet controller. Firmware PPE commands and byte counters are
++	  unavailable in this mode. Wi-Fi RX forwarding is selected separately.
+ 
+ config NET_AIROHA_FLOW_STATS
+ 	default y
