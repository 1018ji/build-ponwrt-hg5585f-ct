+    for(int scenario=0;scenario<14;scenario++){
+        struct pci_dev pci={.vendor=PCI_VENDOR_ID_MEDIATEK,.device=0x7906};u32 wdma=0;
+        struct airoha_wed aw={.dev=&supplier,.irq=42,.wdma=&wdma};
