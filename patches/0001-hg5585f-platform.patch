+#!/usr/bin/env python3
+"""Check compiled-source RX parsing against descriptors emitted by the ROM."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def definition(text, name, struct=False):
+    position = text.index(('struct ' if struct else '') + name)
+    start = position if struct else text.rfind('static ', 0, position)
+    brace = text.index('{', position)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    if struct:
+        end = text.index(';', end) + 1
+    return text[start:end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--header', type=Path, required=True)
+    parser.add_argument('--backend', type=Path, required=True)
+    parser.add_argument('--cc', default='cc')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    fixtures = json.loads((root/'scripts/tests/hg5585f-rom-rx.json').read_text())
+    firmware = root/'files/lib/firmware/airoha/en7581_MT7916_npu_rv32.bin'
+    assert hashlib.sha256(firmware.read_bytes()).hexdigest() == fixtures['firmware_sha256']
+    header = args.header.read_text()
+    backend = args.backend.read_text()
+    defines = '\n'.join(line for line in header.splitlines()
+                        if line.startswith('#define AIROHA_WLAN_LEGACY_RX_'))
+    prefix = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef uint32_t __le32;
+typedef uint64_t __le64;
+#define __packed __attribute__((packed))
+#define BIT(n) (UINT32_C(1) << (n))
+#define GENMASK(h,l) ((UINT32_MAX >> (31-(h))) & (UINT32_MAX << (l)))
+#define FIELD_GET(m,v) (((v) & (m)) >> __builtin_ctz(m))
+#define READ_ONCE(v) (v)
+#define le32_to_cpu(v) (v)
+#define upper_32_bits(v) ((u64)(v) >> 32)
+#define Q_READ(q,field) ((q)->field)
+#define dma_rmb() do {} while (0)
+struct mt76_queue_entry { void *buf; u64 dma_addr[2]; u32 dma_len[2]; };
+struct mt76_queue {
+    void *desc; struct mt76_queue_entry *entry;
+    uint16_t tail, ndesc;
+    int queued;
+    uint32_t cpu_idx;
+};
+'''
+    pieces = [prefix, defines, definition(header, 'airoha_wlan_legacy_rx_desc', True),
+              definition(header, 'airoha_wlan_legacy_rx_meta', True),
+              definition(header, 'airoha_wlan_legacy_rx_decode'),
+              definition(header, 'airoha_wlan_legacy_rx_chain'),
+              definition(backend, 'mt76_npu_legacy_rx_available'),
+              definition(backend, 'mt76_npu_legacy_rx_peek')]
+    for i, fixture in enumerate(fixtures['fixtures']):
+        values = ','.join(f'0x{x:02x}' for x in bytes.fromhex(fixture['descriptor_hex']))
+        pieces.append(f'static const unsigned char fixture{i}[24] = {{{values}}};')
+    pieces.append(r'''
+int main(void) {
+    struct airoha_wlan_legacy_rx_desc descriptors[256] = {0};
+    struct mt76_queue_entry entries[256] = {0};
+    struct airoha_wlan_legacy_rx_meta meta[7];
+    struct mt76_queue q = {.desc=descriptors,.entry=entries,.ndesc=256,.queued=256};
+    assert(sizeof(descriptors[0]) == 24);
+    assert(offsetof(struct airoha_wlan_legacy_rx_desc, dma_addr) == 12);
+    for (int i=0;i<256;i++) {
+        entries[i].buf=(void *)(uintptr_t)1;
+        entries[i].dma_addr[0]=0x98000000;
+        entries[i].dma_len[0]=1725;
+    }
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == -EAGAIN);
+    memcpy(&descriptors[0],fixture0,24); q.cpu_idx=1;
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == 1);
+    assert(meta[0].length==200 && meta[0].total==200 && meta[0].last);
+    assert(meta[0].info==0x000f1234 && meta[0].data==0x00010002);
+    memcpy(&descriptors[0],fixture1,24);
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == -EAGAIN);
+    memcpy(&descriptors[1],fixture2,24); q.cpu_idx=2;
+    /* The stock receiver reads the count from first descriptor byte 7. */
+    ((unsigned char *)&descriptors[0])[7] |= 0x40;
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == 2);
+    assert(meta[0].fragment==1 && meta[1].fragment==2 && meta[1].last);
+    assert(meta[0].length+meta[1].length==2000);
+    descriptors[1].dma_addr=0x98001000;
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == -EIO);
+    descriptors[1].dma_addr=0x98000000;
+    memset(descriptors,0,sizeof(descriptors));
+    memcpy(&descriptors[255],fixture0,24);q.tail=255;q.cpu_idx=0;
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == 1);
+    q.cpu_idx=256;
+    assert(mt76_npu_legacy_rx_peek(&q,meta) == -EIO);
+    puts("PASS: ROM descriptors, partial publication, continuation counts, wrap and DMA bounds");
+    return 0;
+}
+''')
+    with tempfile.TemporaryDirectory(prefix='hg5585f-rom-abi-') as temporary:
+        source = Path(temporary)/'test.c'
+        binary = Path(temporary)/'test'
+        source.write_text('\n\n'.join(pieces))
+        subprocess.run([args.cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                        '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+                        str(source), '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+        pci = (args.backend.parent/'mt7915/pci.c').read_text()
+        start = pci.index('void mt7915_pci_irq_cleanup(')
+        body = pci[start:]
+        end = body.index('\n}\n') + 3
+        cleanup = body[:end]
+        irq_source = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+struct device { int unused; };
+struct tasklet { int killed; };
+struct mt7915_hif { int irq; };
+struct mt7915_dev {
+    struct { struct device *dev; struct tasklet irq_tasklet; } mt76;
+    struct { unsigned long state; } mphy;
+    struct mt7915_hif *hif2;
+    bool pci_irq_requested,wed_irq_requested,hif2_irq_requested;
+    int pci_irq_num,wed_irq_num;
+};
+#define MT76_STATE_INITIALIZED 0
+#define clear_bit(n,p) (*(p) &= ~(1UL << (n)))
+static unsigned int freed[128];
+static void mt7915_irq_disable(struct mt7915_dev *dev, unsigned int mask)
+{ (void)dev; assert(mask == ~0U); }
+static void devm_free_irq(struct device *device,int irq,void *cookie)
+{ assert(device && cookie && irq>=0 && irq<128); assert(!freed[irq]); freed[irq]++; }
+static void tasklet_kill(struct tasklet *tasklet) { tasklet->killed++; }
+'''+cleanup+r'''
+int main(void) {
+    struct device device={0}; struct mt7915_hif hif={.irq=39};
+    struct mt7915_dev dev={.mt76.dev=&device,.mphy.state=1,.hif2=&hif,
+        .pci_irq_requested=true,.wed_irq_requested=true,.hif2_irq_requested=true,
+        .pci_irq_num=40,.wed_irq_num=68};
+    mt7915_pci_irq_cleanup(&dev);
+    assert(!dev.mphy.state && !dev.pci_irq_requested && !dev.wed_irq_requested && !dev.hif2_irq_requested);
+    assert(freed[39]==1 && freed[40]==1 && freed[68]==1 && dev.mt76.irq_tasklet.killed==1);
+    mt7915_pci_irq_cleanup(&dev);
+    assert(freed[39]==1 && freed[40]==1 && freed[68]==1);
+    dev.hif2=NULL;
+    mt7915_pci_irq_cleanup(&dev);
+    puts("PASS: primary, WED and HIF2 IRQ teardown is idempotent before device release");
+}
+'''
+        source.write_text(irq_source)
+        subprocess.run([args.cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                        '-fsanitize=address,undefined', str(source), '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+
+if __name__ == '__main__':
+    main()
