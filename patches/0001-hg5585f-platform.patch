+    return 0;
+}
+''')
+    # The callback type in mt76 is void; preserve that adapter as in mmio.c.
+    pieces.insert(-1, 'static void complete(struct mt76_dev *dev,enum mt76_rxq_id q)\n{ assert(mt7915_npu_legacy_poll_complete(dev,q)); }')
+    pieces[-1] = pieces[-1].replace('.rx_poll_complete=mt7915_npu_legacy_poll_complete', '.rx_poll_complete=complete')
