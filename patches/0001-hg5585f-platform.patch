+static struct mt76_dev *mt76_priv(void *dev) { (void)dev;return current_dev; }
+static int napi_complete(struct napi_struct *napi) { (void)napi;return 1; }
+static int peek_result;
+static int mt76_npu_legacy_rx_peek(struct mt76_queue *q,struct airoha_wlan_legacy_rx_meta *meta)
+{ (void)q;(void)meta;return peek_result; }
+#define Q_READ(q,field) ((q)->field)
+static void mt76_npu_legacy_rx_retire(struct mt76_dev *dev,struct mt76_queue *q,
+    unsigned int n,struct sk_buff *skb,const struct airoha_wlan_legacy_rx_meta *meta)
