+--- /dev/null
++++ b/mt7915/npu_legacy.c
+@@ -0,0 +1,335 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* HG5585F MT7916 receive-side state synchronization. */
++#include <linux/soc/airoha/airoha_wlan_legacy.h>
++#include <linux/of.h>
++
++#include "mt7915.h"
++#include "../dma.h"
++
++static_assert(MT7915_NPU_RX_RING_SIZE == AIROHA_WLAN_LEGACY_INPUT_COUNT);
++
++static bool mt7915_npu_is_legacy(struct airoha_npu *npu)
++{
++	return npu && npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024;
++}
++
++bool mt7915_npu_legacy_active(struct mt7915_dev *dev)
++{
++	struct airoha_npu *npu;
++	bool legacy;
++
++	rcu_read_lock();
++	npu = rcu_dereference(dev->mt76.mmio.npu);
++	legacy = mt7915_npu_is_legacy(npu);
++	rcu_read_unlock();
++
++	return legacy;
++}
++
++static void mt7915_npu_legacy_fail(struct mt7915_dev *dev,
++				    struct airoha_npu *npu, int error)
++{
++	int q;
++
++	WRITE_ONCE(dev->npu_legacy_failed, true);
++	for (q = MT_RXQ_NPU0; q <= MT_RXQ_NPU1; q++) {
++		WRITE_ONCE(dev->mt76.q_rx[q].stopped, true);
++		airoha_npu_wlan_disable_irq(npu, q - MT_RXQ_NPU0);
++	}
++	/* Descriptor/page ownership stays with the queues until DMA is quiesced. */
++	dev_err_ratelimited(dev->mt76.dev, "legacy NPU state synchronization failed: %d\n",
++			    error);
++	if (READ_ONCE(dev->recovery.hw_init_done))
++		queue_work(dev->mt76.wq, &dev->reset_work);
++}
++
++static int mt7915_npu_legacy_send(struct mt7915_dev *dev, unsigned int band,
++				 enum airoha_npu_wlan_set_cmd command, u32 value)
++{
++	struct airoha_npu *npu;
++	__le32 payload = cpu_to_le32(value);
++	int err = 0;
++
++	rcu_read_lock();
++	npu = rcu_dereference(dev->mt76.mmio.npu);
++	if (!mt7915_npu_is_legacy(npu))
++		goto out;
++	if (READ_ONCE(dev->npu_legacy_failed)) {
++		err = -EIO;
++		goto out;
++	}
++	if (band > 1) {
++		err = -EINVAL;
++		goto out;
++	}
++	/* BAR updates also run from NAPI; never sleep inside the RCU section. */
++	err = airoha_npu_wlan_send_msg(npu, band, command, &payload,
++					 sizeof(payload), GFP_ATOMIC);
++	if (err)
++		mt7915_npu_legacy_fail(dev, npu, err);
++out:
++	rcu_read_unlock();
++
++	return err;
++}
++
++int mt7915_npu_legacy_sta_reset(struct mt7915_dev *dev, unsigned int band,
++				 unsigned int wcid)
++{
++	u32 value;
++	int err;
++
++	if (!mt7915_npu_legacy_active(dev))
++		return 0;
++	err = airoha_wlan_legacy_sta_encode(wcid, &value);
++	if (err)
++		return err;
++
++	return mt7915_npu_legacy_send(dev, band, WLAN_FUNC_SET_WAIT_DEL_STA, value);
++}
++
++int mt7915_npu_legacy_ba(struct mt7915_dev *dev, struct mt76_wcid *wcid,
++			  unsigned int tid, unsigned int window, unsigned int ssn)
++{
++	u32 value;
++	int err;
++
++	if (!mt7915_npu_legacy_active(dev))
++		return 0;
++	err = airoha_wlan_legacy_ba_encode(wcid->idx, tid, window, ssn, &value);
++	if (err)
++		return err;
++
++	return mt7915_npu_legacy_send(dev,
++		mt76_dev_phy(&dev->mt76, wcid->phy_idx)->band_idx,
++				     WLAN_FUNC_SET_WAIT_BA_WIN_SIZE, value);
++}
++
++int mt7915_npu_legacy_bar(struct mt7915_dev *dev, struct mt76_wcid *wcid,
++			   const struct sk_buff *skb)
++{
++	const struct ieee80211_bar *bar = (const void *)skb->data;
++	u32 value;
++	u16 control;
++	int err;
++
++	if (!mt7915_npu_legacy_active(dev) || !wcid)
++		return 0;
++	if (skb_headlen(skb) < sizeof(*bar))
++		return -EINVAL;
++	control = le16_to_cpu(bar->control);
++	/* The stock command represents a single TID only. */
++	if (control & IEEE80211_BAR_CTRL_MULTI_TID)
++		return -EOPNOTSUPP;
++	err = airoha_wlan_legacy_bar_encode(wcid->idx, control >> 12,
++					  le16_to_cpu(bar->start_seq_num) >> 4, &value);
++	if (err)
++		return err;
++
++	return mt7915_npu_legacy_send(dev,
++		mt76_dev_phy(&dev->mt76, wcid->phy_idx)->band_idx,
++				     WLAN_FUNC_SET_WAIT_BAR_INFO, value);
++}
++
++bool mt7915_npu_legacy_poll_complete(struct mt76_dev *mdev, enum mt76_rxq_id q)
++{
++	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
++	struct airoha_npu *npu;
++
++	if (q != MT_RXQ_NPU0 && q != MT_RXQ_NPU1)
++		return false;
++	rcu_read_lock();
++	npu = rcu_dereference(mdev->mmio.npu);
++	if (mt7915_npu_is_legacy(npu) && !READ_ONCE(dev->npu_legacy_failed) &&
++	    !READ_ONCE(mdev->q_rx[q].stopped))
++		airoha_npu_wlan_enable_irq(npu, q - MT_RXQ_NPU0);
++	rcu_read_unlock();
++
++	/* NPU queue IDs must never index the chip's native interrupt map. */
++	return true;
++}
++
++int mt7915_npu_legacy_init(struct mt7915_dev *dev)
++{
++	struct pci_dev *pdev;
++
++	if (!of_property_present(dev->mt76.dev->of_node, "airoha,hg5585f-rx-offload"))
++		return 0;
++	if (!is_mt7916(&dev->mt76) || !dev_is_pci(dev->mt76.dev))
++		return -EOPNOTSUPP;
++	dev->npu_ppe_forwarding = of_property_read_bool(dev->mt76.dev->of_node,
++						      "airoha,npu-rx-ppe");
++	pdev = to_pci_dev(dev->mt76.dev);
++	return mt76_npu_legacy_init(&dev->mt76, pci_resource_start(pdev, 0));
++}
++
++int mt7915_npu_legacy_quiesce(struct mt7915_dev *dev)
++{
++	struct mt76_dev *mdev = &dev->mt76;
++	struct airoha_npu *npu;
++	u32 offset = dev->hif2 ? MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0) : 0;
++	u32 busy = BIT(1) | BIT(3);
++	int q, err = 0, stop_err;
++
++	if (!mdev->mmio.npu_legacy_rx)
++		return 0;
++	if (mdev->mmio.npu_quarantined)
++		return -EIO;
++	mt7915_irq_disable(dev, ~0);
++	for (q = MT_RXQ_NPU0; q <= MT_RXQ_NPU1; q++)
++		WRITE_ONCE(mdev->q_rx[q].stopped, true);
++	mt76_npu_disable_irqs(mdev);
++	mt76_clear(dev, MT_WFDMA0_GLO_CFG,
++		   MT_WFDMA0_GLO_CFG_TX_DMA_EN | MT_WFDMA0_GLO_CFG_RX_DMA_EN);
++	if (dev->hif2)
++		mt76_clear(dev, MT_WFDMA0_GLO_CFG + offset,
++			   MT_WFDMA0_GLO_CFG_TX_DMA_EN | MT_WFDMA0_GLO_CFG_RX_DMA_EN);
++	if (!mt76_poll_msec(dev, MT_WFDMA0_GLO_CFG, busy, 0, 100))
++		err = -ETIMEDOUT;
++	if (dev->hif2 &&
++	    !mt76_poll_msec(dev, MT_WFDMA0_GLO_CFG + offset, busy, 0, 100))
++		err = -ETIMEDOUT;
++	pci_clear_master(to_pci_dev(mdev->dev));
++	if (dev->hif2)
++		pci_clear_master(to_pci_dev(dev->hif2->dev));
++	npu = rcu_dereference_protected(mdev->mmio.npu, 1);
++	stop_err = npu ? airoha_npu_wlan_legacy_quiesce(npu, mdev->dev) : -ENODEV;
++	if (!err)
++		err = stop_err;
++	if (err) {
++		if (npu)
++			airoha_npu_wlan_legacy_poison(npu, mdev->dev);
++		WRITE_ONCE(dev->npu_legacy_failed, true);
++		mdev->mmio.npu_quarantined = true;
++		dev_err(mdev->dev, "legacy NPU DMA stop failed: %d; memory retained\n", err);
++	}
++	dev->npu_legacy_configured = false;
++	return err;
++}
++
++static int mt7915_npu_legacy_port_type(struct mt7915_dev *dev)
++{
++	int primary = pci_domain_nr(to_pci_dev(dev->mt76.dev)->bus);
++
++	if (primary > 1)
++		return -EOPNOTSUPP;
++	if (dev->hif2) {
++		int secondary = pci_domain_nr(to_pci_dev(dev->hif2->dev)->bus);
++
++		if (secondary > 1 || secondary == primary)
++			return -EOPNOTSUPP;
++		/* Stock 2 maps band0/band1 to PCIe0/1; 3 reverses that mapping. */
++		return primary ? 3 : 2;
++	}
++	return primary;
++}
