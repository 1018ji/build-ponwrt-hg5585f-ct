+diff --git a/drivers/net/ethernet/airoha/airoha_ppe_account.c b/drivers/net/ethernet/airoha/airoha_ppe_account.c
+new file mode 100644
+index 0000000..93fe448
+--- /dev/null
++++ b/drivers/net/ethernet/airoha/airoha_ppe_account.c
+@@ -0,0 +1,146 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* HG5585F FE account bank 0, shared by both PPEs.
++ *
++ * The stock fe_api_get_ac_group_byte_cnt()/pkt_cnt() accumulate the
++ * read-and-clear registers at FE + 0x2000 + group * 16. Keep a single
++ * collector: debugfs readers must never consume hardware deltas themselves.
++ * These are group totals, not per-FOE or netfilter connection counters.
++ */
++#include <linux/ktime.h>
++
++#include "airoha_regs.h"
++#include "airoha_eth.h"
++#include "airoha_ppe_account.h"
++
++struct airoha_ppe_account {
++	spinlock_t lock;
++	struct delayed_work work;
++	struct airoha_ppe *ppe;
++	struct airoha_ppe_account_snapshot state;
++};
++
++static void
++airoha_ppe_account_read(struct airoha_ppe *ppe, unsigned int group,
++			struct airoha_ppe_account_total *total)
++{
++	u32 low, high, packets;
++
++	/* Match the stock FE accumulator's low/high read order. Reading the
++	 * low word twice (a conventional high/low retry) would consume traffic.
++	 */
++	low = airoha_fe_rr(ppe->eth, AIROHA_PPE_ACCOUNT_BYTES_LO(group));
++	high = airoha_fe_rr(ppe->eth, AIROHA_PPE_ACCOUNT_BYTES_HI(group));
++	packets = airoha_fe_rr(ppe->eth, AIROHA_PPE_ACCOUNT_PACKETS(group));
++	total->bytes += ((u64)high << 32) | low;
++	total->packets += packets;
++}
++
++static void airoha_ppe_account_sample(struct airoha_ppe_account *account)
++{
++	unsigned int group;
++
++	lockdep_assert_held(&account->lock);
++	for (group = 0; group < AIROHA_PPE_ACCOUNT_GROUPS; group++)
++		airoha_ppe_account_read(account->ppe, group,
++					&account->state.group[group]);
++	account->state.samples++;
++	account->state.updated_ns = ktime_get_ns();
++}
++
++static void airoha_ppe_account_work(struct work_struct *work)
++{
++	struct airoha_ppe_account *account;
++
++	account = container_of(to_delayed_work(work), struct airoha_ppe_account, work);
++	spin_lock_bh(&account->lock);
++	if (account->state.running) {
++		airoha_ppe_account_sample(account);
++		queue_delayed_work(system_wq, &account->work, HZ);
++	}
++	spin_unlock_bh(&account->lock);
++}
++
++void airoha_ppe_account_start(struct airoha_ppe *ppe)
++{
++	struct airoha_ppe_account *account = ppe->account;
++	u64 generation;
++	unsigned int group;
++
++	if (!account)
++		return;
++	spin_lock_bh(&account->lock);
++	if (WARN_ON_ONCE(account->state.running))
++		goto unlock;
++
++	/* Called with both PPEs disabled, before publishing the new generation.
++	 * Drain stale deltas once so a previous run cannot inflate this run.
++	 */
++	for (group = 0; group < AIROHA_PPE_ACCOUNT_GROUPS; group++) {
++		struct airoha_ppe_account_total discard = {};
++
++		airoha_ppe_account_read(ppe, group, &discard);
++	}
++	generation = account->state.generation + 1;
++	memset(&account->state, 0, sizeof(account->state));
++	account->state.generation = generation;
++	account->state.started_ns = ktime_get_ns();
++	account->state.updated_ns = account->state.started_ns;
++	account->state.running = true;
++	queue_delayed_work(system_wq, &account->work, HZ);
++unlock:
++	spin_unlock_bh(&account->lock);
++}
++
++void airoha_ppe_account_stop(struct airoha_ppe *ppe)
++{
++	struct airoha_ppe_account *account = ppe->account;
++	bool running;
++
++	if (!account)
++		return;
++	spin_lock_bh(&account->lock);
++	running = account->state.running;
++	account->state.running = false;
++	spin_unlock_bh(&account->lock);
++	cancel_delayed_work_sync(&account->work);
++	if (running) {
++		spin_lock_bh(&account->lock);
++		airoha_ppe_account_sample(account);
++		spin_unlock_bh(&account->lock);
++	}
++}
++
++static void airoha_ppe_account_release(void *data)
++{
++	airoha_ppe_account_stop(data);
++}
++
++int airoha_ppe_account_init(struct airoha_ppe *ppe)
++{
++	struct airoha_ppe_account *account;
++
++	if (!ppe->host_managed)
++		return 0;
++	account = devm_kzalloc(ppe->eth->dev, sizeof(*account), GFP_KERNEL);
++	if (!account)
++		return -ENOMEM;
++	account->ppe = ppe;
++	spin_lock_init(&account->lock);
++	INIT_DELAYED_WORK(&account->work, airoha_ppe_account_work);
++	ppe->account = account;
++	return devm_add_action_or_reset(ppe->eth->dev,
++					airoha_ppe_account_release, ppe);
++}
++
++int airoha_ppe_account_snapshot(struct airoha_ppe *ppe,
++			      struct airoha_ppe_account_snapshot *snapshot)
++{
++	struct airoha_ppe_account *account = ppe->account;
++
++	if (!account)
++		return -EOPNOTSUPP;
++	spin_lock_bh(&account->lock);
++	memcpy(snapshot, &account->state, sizeof(*snapshot));
++	spin_unlock_bh(&account->lock);
++	return 0;
++}
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe_account.h b/drivers/net/ethernet/airoha/airoha_ppe_account.h
+new file mode 100644
+index 0000000..1848caf
+--- /dev/null
++++ b/drivers/net/ethernet/airoha/airoha_ppe_account.h
+@@ -0,0 +1,37 @@
++/* SPDX-License-Identifier: GPL-2.0-only */
++#ifndef AIROHA_PPE_ACCOUNT_H
++#define AIROHA_PPE_ACCOUNT_H
++
++#include <linux/bits.h>
++#include <linux/types.h>
++
++/* HG5585F account bank 0: 63 is the disabled selector, not a counter. */
++#define AIROHA_PPE_ACCOUNT_GROUPS		63
++#define AIROHA_PPE_ACCOUNT_GROUP_MASK	GENMASK(18, 13)
++#define AIROHA_PPE_ACCOUNT_BYTES_LO(_g)	(0x2000 + ((_g) << 4))
++#define AIROHA_PPE_ACCOUNT_BYTES_HI(_g)	(0x2004 + ((_g) << 4))
++#define AIROHA_PPE_ACCOUNT_PACKETS(_g)	(0x2008 + ((_g) << 4))
++
++struct airoha_ppe;
++
++struct airoha_ppe_account_total {
++	u64 packets;
++	u64 bytes;
++};
++
++struct airoha_ppe_account_snapshot {
++	bool running;
++	u64 generation;
++	u64 samples;
++	u64 started_ns;
++	u64 updated_ns;
++	struct airoha_ppe_account_total group[AIROHA_PPE_ACCOUNT_GROUPS];
++};
++
++int airoha_ppe_account_init(struct airoha_ppe *ppe);
++void airoha_ppe_account_start(struct airoha_ppe *ppe);
++void airoha_ppe_account_stop(struct airoha_ppe *ppe);
++int airoha_ppe_account_snapshot(struct airoha_ppe *ppe,
++			      struct airoha_ppe_account_snapshot *snapshot);
++
++#endif
