++
++int mt76_npu_legacy_rx_fill(struct mt76_dev *dev, struct mt76_queue *q)
++{
++	struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
++	int filled = 0;
++
++	if (q->stopped)
++		return 0;
++
++	/* Stock uses all 256 slots. Keep this initial allocation unpublished until full. */
++	while (q->queued < q->ndesc) {
++		struct mt76_queue_entry *e = &q->entry[q->head];
++		dma_addr_t address;
++		struct page *page;
++		void *buffer;
++		u32 offset;
++
++		if (e->buf) {
++			q->stopped = true;
++			dev_err_ratelimited(dev->dev, "legacy NPU RX refill owns a live slot\n");
++			break;
++		}
++		buffer = mt76_get_page_pool_buf(q, &offset, q->buf_size);
++		if (!buffer)
++			break;
++		page = virt_to_head_page(buffer);
++		address = page_pool_get_dma_addr(page) + offset;
++		if (upper_32_bits(address) ||
++		    upper_32_bits(address + AIROHA_WLAN_LEGACY_RX_BUF_BYTES - 1)) {
++			mt76_put_page_pool_buf(buffer, false);
++			q->stopped = true;
++			dev_err_ratelimited(dev->dev, "legacy NPU RX requires 32-bit DMA\n");
++			break;
++		}
++
++		e->buf = buffer;
++		e->dma_addr[0] = address;
++		e->dma_len[0] = AIROHA_WLAN_LEGACY_RX_BUF_BYTES;
++		memset(&desc[q->head], 0, sizeof(*desc));
++		desc[q->head].dma_addr = cpu_to_le32(address);
++		/* Software owns e->buf. Never trust a firmware-supplied host cookie. */
++		q->head = (q->head + 1) % q->ndesc;
++		q->queued++;
++		filled++;
++	}
++
++	return filled;
++}
++EXPORT_SYMBOL_GPL(mt76_npu_legacy_rx_fill);
++
++int mt76_npu_legacy_rx_publish(struct mt76_queue *q)
++{
++	size_t size = q->ndesc * AIROHA_WLAN_LEGACY_RX_DESC_BYTES;
++
++	if (!q->desc || !q->entry || !q->page_pool || q->stopped ||
++	    q->ndesc != AIROHA_WLAN_LEGACY_RX_DESC_COUNT ||
++	    q->queued != q->ndesc || q->head || q->tail)
++		return -EINVAL;
++	if (upper_32_bits(q->desc_dma) ||
++	    upper_32_bits(q->desc_dma + size - 1) || (q->desc_dma & 7))
++		return -ERANGE;
++	if (Q_READ(q, desc_base))
++		return -EBUSY;
++
++	/* NAPI and the IRQ handler must be ready before this commit point. */
++	Q_WRITE(q, ring_size, q->ndesc);
++	/* Hostadpt names offset +8 DMA (producer), +12 CPU (consumer). */
++	Q_WRITE(q, cpu_idx, 0);
++	Q_WRITE(q, dma_idx, 0);
++	dma_wmb();
++	Q_WRITE(q, desc_base, lower_32_bits(q->desc_dma));
++
++	return 0;
++}
++EXPORT_SYMBOL_GPL(mt76_npu_legacy_rx_publish);
