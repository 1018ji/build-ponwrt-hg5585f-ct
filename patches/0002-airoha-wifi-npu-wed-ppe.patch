diff --git a/target/linux/airoha/patches-6.18/931-net-airoha-fix-wan-ipv6-pppoe-flow-offload.patch b/target/linux/airoha/patches-6.18/931-net-airoha-fix-wan-ipv6-pppoe-flow-offload.patch
new file mode 100644
index 0000000000000000000000000000000000000000..5f288d36a0a6931def61f099f08b17e72d3d6eb8
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/931-net-airoha-fix-wan-ipv6-pppoe-flow-offload.patch
@@ -0,0 +1,112 @@
+From: Ziwei Wu <wuziwei518@gmail.com>
+Subject: [PATCH] net: airoha: fix AN7581 WAN IPv6 PPPoE hardware flow offloading
+
+Fix three critical bugs in Airoha AN7581 PPE hardware flowtable offload
+that caused severe packet drops, NPU stalls, and throughput degradation
+(throttled down to tens of KB/s) on IPv6 PPPoE connections:
+
+1. Prevent routed L3 IPv6 packets from falling through to L2 subflow:
+   When an incoming routed IPv6 packet is looked up in ppe->foe_flow
+   and no matching entry is found (or not committed), the execution
+   previously fell through unconditionally into l2_lookup. Since the
+   client MAC belongs to br-lan, it was erroneously committed as an
+   L2 subflow entry, which clobbered the PPPoE session ID in src_mac_hi
+   with 0xf and redirected PSE_PORT to 6 (NPU coprocessor), leading to
+   an immediate black hole. Only true PPE_PKT_TYPE_BRIDGE packets should
+   fall through to l2_lookup.
+
+2. Preserve PPPoE session ID when committing IPv6 subflows:
+   Masking src_mac_hi unconditionally with 0xf stripped the lower 16-bit
+   PPPoE session ID (AIROHA_FOE_MAC_PPPOE_ID). Preserve existing PPPoE ID
+   bits.
+
+3. Exempt IPv6 entries from unverified AN7581 NPU counter stats updates:
+   Like native L2B entries, AN7581 does not expose a compatible NPU
+   flow-stats counter layout for IPv6 route entries. Updating NPU stats
+   or reading unverified counters stalls the hardware NPU pipeline.
+
+4. Account for PPPoE and double VLAN overhead in MTU / xmit frame size:
+   Hardcoding 1500 + VLAN_ETH_HLEN (1518 bytes) truncated standard 1500-byte
+   IPv6 packets traversing PPPoE (which requires 8 bytes PPPOE_SES_HLEN)
+   and VLAN tags, causing silent hardware drops at the PPE egress. Add 16
+   bytes headroom to WAN MTU0/MTU1 and PPE frame limit.
+
+Signed-off-by: Ziwei Wu <wuziwei518@gmail.com>
+---
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -2165,10 +2165,14 @@ static void airoha_dev_set_xmit_frame_size(struct net_device *netdev)
+ 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+ 
+ 	airoha_ppe_set_xmit_frame_size(dev);
+-	if (!airoha_is_lan_gdm_dev(dev))
++	if (!airoha_is_lan_gdm_dev(dev)) {
+ 		airoha_fe_rmw(dev->eth, REG_WAN_MTU0, WAN_MTU0_MASK,
+ 			      FIELD_PREP(WAN_MTU0_MASK,
+-					 VLAN_ETH_HLEN + netdev->mtu));
++					 VLAN_ETH_HLEN + 16 + netdev->mtu));
++		airoha_fe_rmw(dev->eth, REG_WAN_MTU0, WAN_MTU1_MASK,
++			      FIELD_PREP(WAN_MTU1_MASK,
++					 VLAN_ETH_HLEN + 16 + netdev->mtu));
++	}
+ }
+ 
+ static int airoha_dev_open(struct net_device *netdev)
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -118,7 +118,7 @@ void airoha_ppe_set_xmit_frame_size(struct airoha_gdm_dev *dev)
+ 		if (netif_running(netdev))
+ 			len = max_t(u32, len, netdev->mtu);
+ 	}
+-	len += VLAN_ETH_HLEN;
++	len += VLAN_ETH_HLEN + 16;
+ 
+ 	ppe_id = !airoha_is_lan_gdm_dev(dev) && airoha_ppe_is_enabled(eth, 1);
+ 	index = port->id == AIROHA_GDM4_IDX ? 7 : port->id;
+@@ -640,8 +640,9 @@ static void airoha_ppe_foe_flow_stats_update(struct airoha_ppe *ppe,
+ 	int ppe_num_stats_entries;
+ 	u8 nbq;
+ 
+-	/* No verified NPU counter layout for native AN7581 L2B entries. */
+-	if (airoha_is_7581(ppe->eth) && type == PPE_PKT_TYPE_BRIDGE)
++	/* No verified NPU counter layout for native AN7581 L2B and IPv6 entries. */
++	if (airoha_is_7581(ppe->eth) &&
++	    (type == PPE_PKT_TYPE_BRIDGE || type >= PPE_PKT_TYPE_IPV6_ROUTE_3T))
+ 		return;
+ 
+ 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
+@@ -896,8 +897,9 @@ airoha_ppe_foe_commit_subflow_entry(struct airoha_ppe *ppe,
+ 		/* setting smac_id to 0xf instruct the hw to keep original
+ 		 * source mac address
+ 		 */
+-		hwe.ipv6.l2.src_mac_hi = FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID,
+-						    0xf);
++		hwe.ipv6.l2.src_mac_hi = FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID,
++						    0xf) |
++					 (hwe.ipv6.l2.src_mac_hi & AIROHA_FOE_MAC_PPPOE_ID);
+ 	} else {
+ 		memcpy(&hwe.bridge.l2, &e->data.bridge.l2,
+ 		       sizeof(hwe.bridge.l2));
+@@ -962,6 +964,9 @@ static void airoha_ppe_foe_insert_entry(struct airoha_ppe *ppe,
+ 	if (commit_done)
+ 		goto unlock;
+ 
++	if (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1) != PPE_PKT_TYPE_BRIDGE)
++		goto unlock;
++
+ l2_lookup:
+ 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
+ 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
+@@ -1335,8 +1340,10 @@ void airoha_ppe_foe_entry_get_stats(struct airoha_ppe *ppe, u32 hash,
+ 
+ 	hwe = ppe->foe + hash * sizeof(*hwe);
+ 	if (airoha_is_7581(eth) &&
+-	    FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, READ_ONCE(hwe->ib1)) ==
+-	    PPE_PKT_TYPE_BRIDGE)
++	    (FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, READ_ONCE(hwe->ib1)) ==
++	     PPE_PKT_TYPE_BRIDGE ||
++	     FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, READ_ONCE(hwe->ib1)) >=
++	     PPE_PKT_TYPE_IPV6_ROUTE_3T))
+ 		return;
+ 
+ 	ppe_num_stats_entries = airoha_ppe_get_total_num_stats_entries(ppe);
diff --git a/target/linux/airoha/patches-6.18/932-net-airoha-ppe-support-bridge-fdb-port-offload.patch b/target/linux/airoha/patches-6.18/932-net-airoha-ppe-support-bridge-fdb-port-offload.patch
new file mode 100644
index 0000000000000000000000000000000000000000..8f378488a74629ec633ea4a19e0c706972612c99
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/932-net-airoha-ppe-support-bridge-fdb-port-offload.patch
@@ -0,0 +1,69 @@
+From: Ziwei Wu <wuziwei518@gmail.com>
+Subject: [PATCH] net: airoha: support hardware flowtable offload for bridge slave ports
+
+In OpenWrt and common router environments, LAN interfaces (such as lan1-lan4
+and wireless AP interfaces) are aggregated under a virtual bridge device
+(e.g., br-lan).
+
+When the Netfilter flowtable attempts to offload routed traffic destined for
+a LAN host, the egress net_device presented to the hardware driver is the
+bridge master device (br-lan). Previously, airoha_ppe_foe_entry_prepare()
+validated the egress net_device via airoha_is_valid_gdm_dev(). Because the
+virtual bridge device is not a physical GDM device, the driver unconditionally
+rejected the hardware flow entry with -EINVAL.
+
+As a consequence, routed downlink traffic from WAN to LAN could never be
+hardware-offloaded into the PPE flow table, causing up to 88% of incoming
+traffic to fall back onto the CPU DMA path (CDM2 and heavy softirq load),
+leading to sustained high CPU load under multi-connection workloads like BitTorrent.
+
+Fix this by resolving the bridge slave port via br_fdb_find_port() using the
+destination MAC address when netdev is a bridge master (netif_is_bridge_master).
+If a corresponding bridge slave port (such as lan1 or phy0-ap0) is found in
+the FDB, substitute netdev with the real slave net_device prior to DSA port
+and GDM device validation. If the destination MAC is not yet in the FDB,
+the flow safely falls back to CPU software routing until the bridge learns it.
+
+Signed-off-by: Ziwei Wu <wuziwei518@gmail.com>
+---
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -4,6 +4,9 @@
+  * Author: Lorenzo Bianconi <lorenzo@kernel.org>
+  */
+ 
++#if IS_ENABLED(CONFIG_BRIDGE)
++#include <linux/if_bridge.h>
++#endif
+ #include <linux/airoha-eth.h>
+ #include <linux/ip.h>
+ #include <linux/ipv6.h>
+@@ -462,11 +465,26 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
+ 					struct airoha_gdm_dev **egress_dev)
+ {
+ 	u32 qdata = FIELD_PREP(AIROHA_FOE_SHAPER_ID, 0x7f), ports_pad, val;
+-	u32 pon_tag = 0;
+-	int wlan_etype = -EINVAL, dsa_port = airoha_get_dsa_port(&netdev);
+ 	struct airoha_foe_mac_info_common *l2;
++	int wlan_etype = -EINVAL, dsa_port;
++	u32 pon_tag = 0;
+ 	u8 smac_id = 0xf;
+ 
++#if IS_ENABLED(CONFIG_BRIDGE)
++	if (netdev && netif_is_bridge_master(netdev)) {
++		struct net_device *slave_dev;
++		u16 vid = data->vlan.num ? data->vlan.hdr[data->vlan.num - 1].id : 0;
++
++		slave_dev = br_fdb_find_port(netdev, data->eth.h_dest, vid);
++		if (!slave_dev && vid)
++			slave_dev = br_fdb_find_port(netdev, data->eth.h_dest, 0);
++
++		if (slave_dev)
++			netdev = slave_dev;
++	}
++#endif
++
++	dsa_port = airoha_get_dsa_port(&netdev);
+ 	memset(hwe, 0, sizeof(*hwe));
+ 	*egress_dev = NULL;
+ 
diff --git a/target/linux/airoha/patches-6.18/933-net-airoha-add-mt7916-wed-tx.patch b/target/linux/airoha/patches-6.18/933-net-airoha-add-mt7916-wed-tx.patch
new file mode 100644
index 0000000000000000000000000000000000000000..6bf478a7357e75a47f27f85cda43b68cc3fc0872
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/933-net-airoha-add-mt7916-wed-tx.patch
@@ -0,0 +1,1316 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: add MT7916 WED TX alongside native receive
+
+Retain upstream NPU/PPE firmware and native wireless receive.
+WED1/WDMA1 handles wireless transmit DMA and PPE egress.
+Reject incompatible firmware ABIs before changing DMA ownership.
+
+diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
+index 5c54a07..890d288 100644
+--- a/drivers/net/ethernet/airoha/Kconfig
++++ b/drivers/net/ethernet/airoha/Kconfig
+@@ -26,6 +26,18 @@ config NET_AIROHA
+ 	  This driver supports the gigabit ethernet MACs in the
+ 	  Airoha SoC family.
+ 
++config NET_AIROHA_WED
++	bool "EN7581 MT7916 WED transmit offload (experimental)"
++	depends on ARCH_AIROHA && NET_AIROHA=y && OF && PCI && EXPERT
++	select NET_VENDOR_MEDIATEK
++	select NET_MEDIATEK_SOC_WED
++	default n
++	help
++	  Enable the HG5585F WED1/WDMA1 transmit provider for MT7916D.
++	  Requires an explicit WED device-tree overlay and mt7915e.wed_enable=1.
++	  Retains the upstream NPU firmware for PPE and software Wi-Fi RX.
++	  This provider does not support NPU receive offloading.
++
+ config NET_AIROHA_FLOW_STATS
+ 	default y
+ 	bool "Airoha flow stats"
+diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
+index 9446805..7b668e5 100644
+--- a/drivers/net/ethernet/airoha/Makefile
++++ b/drivers/net/ethernet/airoha/Makefile
+@@ -7,3 +7,4 @@ obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
+ airoha-eth-y := airoha_eth.o airoha_ppe.o
+ airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
+ obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
++obj-$(CONFIG_NET_AIROHA_WED) += airoha_wed.o
+diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
+index fddbe36..4333c24 100644
+--- a/drivers/net/ethernet/airoha/airoha_eth.h
++++ b/drivers/net/ethernet/airoha/airoha_eth.h
+@@ -25,6 +25,7 @@
+ #define AIROHA_MAX_NUM_RSTS		3
+ #define AIROHA_MAX_MTU			9220
+ #define AIROHA_MAX_RX_SIZE		16128
++#define AIROHA_WED_MTU			1518
+ #define AIROHA_MAX_PACKET_SIZE		2048
+ #define AIROHA_NUM_QOS_CHANNELS		4
+ #define AIROHA_NUM_QOS_QUEUES		8
+@@ -514,6 +515,8 @@ struct airoha_foe_stats64 {
+ };
+ 
+ struct airoha_flow_data {
++	bool wed;
++	u16 wed_sta_id;
+ 	struct ethhdr eth;
+ 
+ 	union {
+@@ -567,6 +570,9 @@ struct airoha_flow_table_entry {
+ 
+ 	struct rhash_head node;
+ 	unsigned long cookie;
++	bool disabled;
++	bool wed;
++	u16 wed_sta_id;
+ 	/* Track the final egress GDM netdev for each flow. PON bearer mappings
+ 	 * can change after O5 recovery or OMCI reconfiguration, so invalidate
+ 	 * only FOEs attached to the affected PON egress device.
+@@ -579,6 +585,8 @@ struct airoha_flow_table_entry {
+ };
+ 
+ struct airoha_wdma_info {
++	bool wed;
++	u16 sta_id;
+ 	u8 idx;
+ 	u8 queue;
+ 	u16 wcid;
+@@ -719,6 +727,7 @@ struct airoha_gdm_port {
+ #define AIROHA_RXD4_FOE_ENTRY		GENMASK(15, 0)
+ 
+ struct airoha_ppe {
++	bool wed_enabled;
+ 	struct airoha_ppe_dev dev;
+ 	struct airoha_eth *eth;
+ 
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
+index 73ee712..0bc1e0b 100644
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -139,6 +139,18 @@ void airoha_ppe_set_xmit_frame_size(struct airoha_gdm_dev *dev)
+ 		      __field_prep(FP_EGRESS_MTU_MASK(index), len));
+ }
+ 
++static void airoha_ppe_wed_mtu(struct airoha_ppe *ppe)
++{
++	struct airoha_eth *eth = ppe->eth;
++	int i;
++
++	for (i = 0; i < eth->soc->num_ppe; i++)
++		airoha_fe_rmw(eth, REG_PPE_MTU(i, FE_PSE_PORT_GDM3),
++			      FP_EGRESS_MTU_MASK(FE_PSE_PORT_GDM3),
++			      FIELD_PREP(FP_EGRESS_MTU_MASK(FE_PSE_PORT_GDM3),
++					 ppe->wed_enabled ? AIROHA_WED_MTU : AIROHA_MAX_MTU));
++}
++
