From: PonWrt developers <noreply@localhost>
Subject: [PATCH] hg5585f: combine PPE flowtable and WED runtime integration

Combine PPE flowtable integration, WED runtime, diagnostics and the selected NPU profile.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/files/usr/sbin/hg5585f-wifi-offload-check b/files/usr/sbin/hg5585f-wifi-offload-check
index 56d0848..776fe55 100755
--- a/files/usr/sbin/hg5585f-wifi-offload-check
+++ b/files/usr/sbin/hg5585f-wifi-offload-check
@@ -21,6 +21,21 @@ done
 	exit 1
 }
 report=$(mktemp -d /tmp/hg5585f-wifi-offload.XXXXXX)
+snapshot() {
+	label=$1
+	cat /proc/uptime > "$report/$label.uptime"
+	cat /proc/stat > "$report/$label.cpu"
+	cat /proc/softirqs > "$report/$label.softirqs"
+	cat /proc/net/dev > "$report/$label.netdev"
+	if [ -r /sys/kernel/debug/ppe/flow_setup ]; then
+		cat /sys/kernel/debug/ppe/flow_setup > "$report/$label.flow_setup"
+	fi
+	# Save BND entries during traffic too; entries can age after iperf exits.
+	awk '$2 == "BND" { print }' /sys/kernel/debug/ppe/entries > "$report/$label.ppe-bound" 2>/dev/null || true
+}
+snapshot start
+nft list table bridge fw4 > "$report/bridge-flowtable" 2>&1 || true
+nft list flowtable inet fw4 ft > "$report/inet-flowtable" 2>&1 || true
 [ ! -r "$accounting" ] || cat "$accounting" > "$report/accounting-before"
 [ ! -r "$status" ] || cat "$status" > "$report/before"
 if [ -n "$npu_status" ]; then
@@ -34,7 +49,16 @@ for interface in /sys/class/net/phy*-ap*; do
 	iw dev "$interface" station dump > "$report/$interface.stations" 2>&1 || true
 done
 echo "During this $period second sample, send traffic in both directions between wired and Wi-Fi clients."
-sleep "$period"
+remaining=$period
+sample=0
+while [ "$remaining" -gt 0 ]; do
+	interval=5
+	[ "$remaining" -ge "$interval" ] || interval=$remaining
+	sleep "$interval"
+	sample=$((sample + 1))
+	snapshot "sample-$sample"
+	remaining=$((remaining - interval))
+done
 [ ! -r "$accounting" ] || cat "$accounting" > "$report/accounting-after"
 [ ! -r "$status" ] || cat "$status" > "$report/after"
 if [ -n "$npu_status" ]; then
@@ -116,4 +140,7 @@ if [ -f "$report/accounting-before" ] && [ -f "$report/accounting-after" ]; then
 	echo "Use account_group in PPE entries to identify the corresponding group."
 fi
 echo "Correlate PPE BND entries and hardware counters with the test endpoints; configuration alone does not prove forwarding."
+if [ -r "$report/sample-$sample.flow_setup" ]; then
+	cat "$report/sample-$sample.flow_setup"
+fi
 echo "Report: $report"
diff --git a/package/kernel/mt76/patches/127-mt7915-airoha-wed-txp-wcid-sentinel.patch b/package/kernel/mt76/patches/127-mt7915-airoha-wed-txp-wcid-sentinel.patch
new file mode 100644
index 0000000..94ed82b
--- /dev/null
+++ b/package/kernel/mt76/patches/127-mt7915-airoha-wed-txp-wcid-sentinel.patch
@@ -0,0 +1,47 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt7915: match stock Airoha WED header geometry
+
+The stock Airoha path reserves a 128-byte header window and keeps the
+payload in a separate DMA segment. The generic initializer publishes a
+76-byte packed window, which leaves short WED TX-free payloads with a
+different geometry. The Airoha callback now preserves the full AP WCID
+sentinel, clears the expanded header area and publishes payload at offset
+128. It is selected only by the existing Airoha DT property.
+This experiment changes only the Airoha callback.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/mt7915/mmio.c b/mt7915/mmio.c
+--- a/mt7915/mmio.c
++++ b/mt7915/mmio.c
+@@ -629,6 +629,19 @@
+ 
+ 	return ret;
+ }
++static u32 mt7915_airoha_wed_init_buf(void *ptr, dma_addr_t phys, int token_id)
++{
++	struct mt76_connac_fw_txp *txp = ptr + MT_TXD_SIZE;
++	u32 header = mt7915_wed_init_buf(ptr, phys, token_id);
++
++	memset(ptr + header, 0, 128 - header);
++	txp->buf[0] = cpu_to_le32(phys + 128);
++	/* Keep the stock 128-byte header window and the full AP sentinel. */
++	txp->rept_wds_wcid = cpu_to_le16(0x3ff);
++
++	return header + 52;
++}
++
+ #endif
+ 
+ int mt7915_mmio_wed_init(struct mt7915_dev *dev, void *pdev_ptr,
+@@ -711,7 +724,9 @@
+ 		wed->wlan.rx_tbit[1] = 19;
+ 	}
+ 
+-	wed->wlan.init_buf = mt7915_wed_init_buf;
++	wed->wlan.init_buf =
++		of_property_present(dev->mt76.dev->of_node, "airoha,wed") ?
++		mt7915_airoha_wed_init_buf : mt7915_wed_init_buf;
+ 	wed->wlan.offload_enable = mt76_wed_offload_enable;
+ 	wed->wlan.offload_disable = mt76_wed_offload_disable;
+ 	wed->wlan.init_rx_buf = mt76_wed_init_rx_buf;
