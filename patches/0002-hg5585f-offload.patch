+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: capture WED diagnostics with valid hunk ranges
+
+Refresh the generated WED diagnostic patch after expanding the bounded
+TX-free record and attaching follow-up token candidates. Keep the inner
+patch syntactically valid so build-time patch checks can apply it.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -7,6 +7,9 @@
+ #include <linux/interrupt.h>
+ #include <linux/iopoll.h>
+ #include <linux/jiffies.h>
++#include <linux/ktime.h>
++#include <linux/unaligned.h>
++#include <linux/soc/airoha/airoha_wed_diag.h>
+ #include <linux/module.h>
+ #include <linux/mutex.h>
+ #include <linux/of_address.h>
+@@ -22,6 +25,7 @@
+ 
+ /* The EN7581 block shares this register map, with the differences below. */
+ #include "../mediatek/mtk_wed_regs.h"
++#include "airoha_wed_diag.h"
+ 
+ #define EN7581_WED_REV			0x000
+ #define EN7581_WED_CTRL2			0x01c
+@@ -56,6 +60,8 @@
+ struct airoha_wed {
+ 	struct device *dev;
+ 	struct dentry *debugfs;
++	struct dentry *error_debugfs;
++	struct airoha_wed_diag *diag;
+ 	struct device_node *pcie;
+ 	void __iomem *base;
+ 	void __iomem *wdma;
+@@ -240,6 +246,343 @@
+ 	return 0;
+ }
+ 
++/* The snapshots are bounded and read only; hardware can move during capture. */
++static const u32 airoha_wed_diag_registers[AIROHA_WED_DIAG_REGS] = {
++	MTK_WED_CTRL, EN7581_WED_CTRL2, MTK_WED_TX_BM_CTRL,
++	MTK_WED_TX_BM_BASE, MTK_WED_TX_BM_INIT_PTR, MTK_WED_TX_BM_BUF_LEN,
++	MTK_WED_TX_BM_INTF, MTK_WED_GLO_CFG, MTK_WED_WPDMA_GLO_CFG,
++	EN7581_WED_WPDMA_CTRL, EN7581_WED_WPDMA_OFFSET0,
++	EN7581_WED_WPDMA_OFFSET1,
++};
++
++static void airoha_wed_diag_ring(struct airoha_wed *aw,
++				 struct airoha_wed_ring_record *record,
++				 struct mtk_wed_ring *ring, u32 reg)
++{
++	unsigned int i, j, index;
++
++	for (i = 0; i < 4; i++)
++		record->before[i] = readl(aw->base + reg + i * 4);
++	if (!ring->desc || ring->size <= 0 || ring->desc_size != 16 ||
++	    upper_32_bits(ring->desc_phys) ||
++	    record->before[0] != lower_32_bits(ring->desc_phys) ||
++	    record->before[1] != (u32)ring->size || record->before[3] >= (u32)ring->size)
++		goto after;
++	dma_rmb();
++	for (i = 0; i < AIROHA_WED_DIAG_DESCS; i++) {
++		const __le32 *words;
++
++		index = (record->before[3] + ring->size - 2 + i) % ring->size;
++		record->index[i] = index;
++		words = (const void *)((const u8 *)ring->desc + index * 16);
++		for (j = 0; j < 4; j++)
++			record->descriptor[i][j] = le32_to_cpu(READ_ONCE(words[j]));
++	}
++	record->valid = true;
++after:
++	for (i = 0; i < 4; i++)
++		record->after[i] = readl(aw->base + reg + i * 4);
++}
++
++static void airoha_wed_diag_buffer(struct mtk_wed_device *wed,
++				   struct airoha_wed_buffer_record *record,
++				   unsigned int index)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	struct airoha_wed_buffer *buffer;
++	unsigned int offset, i;
++	const u8 *bytes;
++	u32 expected;
++
++	if (index >= wed->wlan.nbuf || index / EN7581_WED_BUFS_PER_PAGE >= aw->num_pages)
++		return;
++	buffer = &aw->buffers[index / EN7581_WED_BUFS_PER_PAGE];
++	if (!buffer->data)
++		return;
++	offset = (index % EN7581_WED_BUFS_PER_PAGE) * EN7581_WED_BUFFER_SIZE;
++	bytes = buffer->data + offset;
++	record->pool_index = index;
++	record->dma = lower_32_bits(buffer->dma + offset);
++	for (i = 0; i < ARRAY_SIZE(record->txd); i++)
++		record->txd[i] = get_unaligned_le32(bytes + i * 4);
++	/* Exact MT7916 firmware TXP layout; never follow a DMA-provided pointer. */
++	record->token = get_unaligned_le16(bytes + 34);
++	record->token_matches = record->token == wed->wlan.token_start + index;
++	record->bss = bytes[36];
++	record->rept = get_unaligned_le16(bytes + 37);
++	record->nbuf = bytes[39];
++	record->payload_ptr = get_unaligned_le32(bytes + 40);
++	record->length = get_unaligned_le16(bytes + 64);
++	expected = record->dma + 128;
++	if (record->payload_ptr == expected && record->length <= EN7581_WED_PAYLOAD_SIZE) {
++		for (i = 0; i < min_t(unsigned int, record->length, sizeof(record->payload)); i++)
++			record->payload[i] = READ_ONCE(bytes[128 + i]);
++		record->payload_valid = true;
++	}
++	record->valid = true;
++}
++
++static void airoha_wed_diag_snapshot(struct mtk_wed_device *wed,
++				     struct airoha_wed_error_record *record,
++				     u32 status, u32 errors, u64 ns)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	struct airoha_wed_diag *diag = aw->diag;
++	unsigned int i, j, saved = 0;
++
++	record->ns = ns;
++	record->services = diag->state.services;
++	record->status = status;
++	record->errors = errors;
++	record->token_start = wed->wlan.token_start;
++	record->token_count = wed->wlan.nbuf;
++	record->host_before = diag->state.latest;
++	for (i = 0; i < 4; i++)
++		record->wpdma_before[i] = readl(aw->base + EN7581_WED_WPDMA_RX_RING + i * 4);
++	for (i = 0; i < AIROHA_WED_DIAG_REGS; i++)
++		record->registers[i] = readl(aw->base + airoha_wed_diag_registers[i]);
++	if (wed->txfree_ring.wpdma)
++		for (i = 0; i < 4; i++)
++			record->native_before[i] = readl(wed->txfree_ring.wpdma + i * 4);
++	airoha_wed_diag_ring(aw, &record->rings[0], &wed->txfree_ring, MTK_WED_RING_RX(1));
++	for (i = 0; i < MTK_WED_TX_QUEUES; i++) {
++		airoha_wed_diag_ring(aw, &record->rings[1 + i], &wed->rx_wdma[i], 0x900 + i * 16);
++		airoha_wed_diag_ring(aw, &record->rings[3 + i], &wed->tx_ring[i], 0x600 + i * 16);
++	}
++	/* Candidate tokens from the preceding host view, not a claimed fault ID. */
++	for (i = 0; i < diag->state.latest.saved_tokens && saved < AIROHA_WED_DIAG_BUFS; i++) {
++		u32 token = diag->state.latest.token[i];
++
++		if (token < wed->wlan.token_start ||
++		    token - wed->wlan.token_start >= wed->wlan.nbuf) {
++			continue;
++		}
++		unsigned int pool_index;
++
++			pool_index = token - wed->wlan.token_start;
++			airoha_wed_diag_buffer(wed, &record->buffers[saved], pool_index);
++			record->buffers[saved++].source = 1 + i;
++	}
++	/* Also save the last sampled WDMA header, matched to an allocated page. */
++	for (i = 0; i < MTK_WED_TX_QUEUES && saved < AIROHA_WED_DIAG_BUFS; i++) {
++		struct airoha_wed_ring_record *ring = &record->rings[1 + i];
++		u32 header;
++
++		if (!ring->valid)
++			continue;
++		header = ring->descriptor[1][2];
++		for (j = 0; j < aw->num_pages; j++) {
++			dma_addr_t base = aw->buffers[j].dma;
++
++			if (header >= base && header - base < PAGE_SIZE &&
++			    !((header - base) % EN7581_WED_BUFFER_SIZE)) {
++				unsigned int index = j * EN7581_WED_BUFS_PER_PAGE +
++					(header - base) / EN7581_WED_BUFFER_SIZE;
++
++					airoha_wed_diag_buffer(wed, &record->buffers[saved], index);
++					record->buffers[saved++].source = 0x80 + i;
++			}
++		}
++	}
++	if (wed->txfree_ring.wpdma)
++		for (i = 0; i < 4; i++)
++			record->native_after[i] = readl(wed->txfree_ring.wpdma + i * 4);
++	for (i = 0; i < 4; i++)
++		record->wpdma_after[i] = readl(aw->base + EN7581_WED_WPDMA_RX_RING + i * 4);
++	record->valid = true;
++}
++
++/* Called before acknowledging the extended error status. */
++static void airoha_wed_diag_irq(struct mtk_wed_device *wed, u32 status, u32 errors)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	struct airoha_wed_diag *diag = aw->diag;
++	unsigned long flags;
++	unsigned int bit, i;
++	u32 processed[MTK_WED_TX_QUEUES];
++	u64 ns;
++
++	if (!diag)
++		return;
++	spin_lock_irqsave(&diag->lock, flags);
++	diag->state.services++;
++	if (!errors)
++		goto out;
++	ns = ktime_get_mono_fast_ns();
++	for (i = 0; i < MTK_WED_TX_QUEUES; i++)
++		processed[i] = readl(aw->base + MTK_WED_WDMA_RX_PROCESSED_MIB(i));
++	for (bit = 0; bit < 32; bit++) {
++		if (!(errors & BIT(bit)))
++			continue;
++		if (!diag->state.count[bit]++) {
++			diag->state.first_ns[bit] = ns;
++			memcpy(diag->state.first_wdma[bit], processed, sizeof(processed));
++		}
++		diag->state.last_ns[bit] = ns;
++		memcpy(diag->state.last_wdma[bit], processed, sizeof(processed));
++	}
++	if ((errors & BIT(1)) && !diag->state.first[0].valid)
++		airoha_wed_diag_snapshot(wed, &diag->state.first[0], status, errors, ns);
++	if ((errors & BIT(18)) && !diag->state.first[1].valid)
++		airoha_wed_diag_snapshot(wed, &diag->state.first[1], status, errors, ns);
++out:
++	spin_unlock_irqrestore(&diag->lock, flags);
++}
++
++void airoha_wed_diag_txfree(struct mtk_wed_device *wed, const void *data,
++			    unsigned int len, bool v0,
++			    unsigned int cpu_start, unsigned int cpu_count)
++{
++	struct airoha_wed_free_record record;
++	struct airoha_wed_diag *diag;
++	unsigned long flags;
++	unsigned int i;
++
++	if (!wed->airoha || !wed->priv)
++		return;
++	diag = airoha_wed_priv(wed)->diag;
++	if (!diag)
++		return;
++	airoha_wed_diag_decode(&record, data, len, v0, cpu_start, cpu_count,
++			       wed->wlan.token_start, wed->wlan.nbuf);
++	record.ns = ktime_get_mono_fast_ns();
++	spin_lock_irqsave(&diag->lock, flags);
++	record.sequence = ++diag->state.notifications;
++	diag->state.latest = record;
++	for (i = 0; i < ARRAY_SIZE(diag->state.first); i++) {
++		unsigned int candidate, saved = 0;
++
++		if (!diag->state.first[i].valid || record.ns < diag->state.first[i].ns ||
++		    diag->state.first[i].host_after.sequence)
++			continue;
++		diag->state.first[i].host_after = record;
++		for (candidate = 0; candidate < record.saved_tokens &&
++		     saved < AIROHA_WED_DIAG_BUFS; candidate++) {
++			u32 token = record.token[candidate];
++
++			if (token < wed->wlan.token_start ||
++			    token - wed->wlan.token_start >= wed->wlan.nbuf)
++				continue;
++			airoha_wed_diag_buffer(wed, &diag->state.first[i].buffers[saved],
++				token - wed->wlan.token_start);
++			diag->state.first[i].buffers[saved++].source = 0x40 + candidate;
++		}
++	}
++	spin_unlock_irqrestore(&diag->lock, flags);
++}
++EXPORT_SYMBOL_GPL(airoha_wed_diag_txfree);
++
++static void airoha_wed_diag_show_free(struct seq_file *s, const char *name,
++				      const struct airoha_wed_free_record *r)
