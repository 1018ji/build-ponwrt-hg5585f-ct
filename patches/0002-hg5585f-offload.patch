++	u8 version;
++	u16 raw_words;
++	u16 saved_tokens;
++	bool truncated;
++	bool malformed;
++	bool unsupported;
++};
++
++struct airoha_wed_ring_record {
++	u32 before[4];
++	u32 after[4];
++	u32 descriptor[AIROHA_WED_DIAG_DESCS][4];
++	u32 index[AIROHA_WED_DIAG_DESCS];
++	bool valid;
++};
++
++struct airoha_wed_buffer_record {
++	u32 pool_index;
++	u32 dma;
++	u32 txd[8];
++	u32 payload_ptr;
++	u16 token;
++	u16 length;
++	u16 rept;
++	u8 bss;
++	u8 nbuf;
++	u8 source;
++	u8 payload[64];
++	bool payload_valid;
++	bool token_matches;
++	bool valid;
++};
++
++struct airoha_wed_error_record {
++	u64 ns;
++	u64 services;
++	u32 status;
++	u32 errors;
++	u32 token_start;
++	u32 token_count;
++	u32 registers[AIROHA_WED_DIAG_REGS];
++	u32 native_before[4];
++	u32 native_after[4];
++	u32 wpdma_before[4];
++	u32 wpdma_after[4];
++	struct airoha_wed_ring_record rings[AIROHA_WED_DIAG_RINGS];
++	struct airoha_wed_buffer_record buffers[AIROHA_WED_DIAG_BUFS];
++	struct airoha_wed_free_record host_before;
++	struct airoha_wed_free_record host_after;
++	bool valid;
++};
++
++struct airoha_wed_diag_state {
++	u64 services;
++	u64 count[32];
++	u64 first_ns[32];
++	u64 last_ns[32];
++	u32 first_wdma[32][MTK_WED_TX_QUEUES];
++	u32 last_wdma[32][MTK_WED_TX_QUEUES];
++	u64 notifications;
++	struct airoha_wed_free_record latest;
++	struct airoha_wed_error_record first[2];
++};
++
++struct airoha_wed_diag {
++	/* Protect records shared by the IRQ tasklet, host NAPI and debugfs. */
++	spinlock_t lock;
++	struct airoha_wed_diag_state state;
++};
++
++/* Only parse the bounded host-owned notification copy. */
++static void
++airoha_wed_diag_decode(struct airoha_wed_free_record *record, const void *data,
++		       unsigned int len, bool v0, unsigned int cpu_start,
++		       unsigned int cpu_count, unsigned int wed_start,
++		       unsigned int wed_count)
++{
++	const u8 *bytes = data;
++	unsigned int available, offset, i;
++
++	memset(record, 0, sizeof(*record));
++	record->length = len;
++	if (len < 8) {
++		record->malformed = true;
++		return;
++	}
++	record->advertised = get_unaligned_le16(bytes + 2) & (v0 ? 0x7f : 0x3ff);
++	record->version = v0 ? 0 : (get_unaligned_le32(bytes + 4) >> 16) & 7;
++	record->raw_words = min_t(unsigned int, len / 4, AIROHA_WED_DIAG_WORDS);
++	for (i = 0; i < record->raw_words; i++)
++		record->raw[i] = get_unaligned_le32(bytes + i * 4);
++	if (!v0 && record->version > 4) {
++		record->unsupported = true;
++		return;
++	}
++	available = min_t(unsigned int, len, AIROHA_WED_DIAG_WORDS * 4);
++	for (offset = 8; record->decoded < record->advertised;) {
++		u32 info;
++		unsigned int width = v0 ? 2 : 4;
++		unsigned int tokens = !v0 && record->version == 4 ? 2 : 1;
++
++		if (offset + width > available) {
++			record->truncated = available < len;
++			record->malformed = !record->truncated;
++			break;
++		}
++		info = v0 ? get_unaligned_le16(bytes + offset) :
++			    get_unaligned_le32(bytes + offset);
++		offset += width;
++		if (!v0 && (info & BIT(31))) {
++			record->station_words++;
++			continue;
++		}
++		if (!v0 && record->version == 4 && (info & BIT(30))) {
++			record->mpdu_words++;
++			continue;
++		}
++		for (i = 0; i < tokens; i++) {
++			u32 token = v0 ? info : record->version == 4 ?
++				    (info >> (15 * i)) & 0x7fff : (info >> 16) & 0x7fff;
++
++			if (!v0 && record->version == 4 && token == 0x7fff)
++				continue;
++			record->decoded++;
++			if (record->saved_tokens < AIROHA_WED_DIAG_TOKENS)
++				record->token[record->saved_tokens++] = token;
++			if (token >= cpu_start && token - cpu_start < cpu_count)
++				record->cpu_tokens++;
++			else if (token >= wed_start && token - wed_start < wed_count)
++				record->wed_tokens++;
++			else
++				record->unexpected++;
++		}
++	}
++	if (record->decoded != record->advertised && !record->truncated)
++		record->malformed = true;
++}
++
