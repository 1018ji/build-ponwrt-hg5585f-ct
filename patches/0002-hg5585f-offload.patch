diff --git a/target/linux/airoha/patches-6.18/947-net-airoha-wed-allow-multiple-flow-blocks.patch b/target/linux/airoha/patches-6.18/947-net-airoha-wed-allow-multiple-flow-blocks.patch
new file mode 100644
index 0000000..f8f1caf
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/947-net-airoha-wed-allow-multiple-flow-blocks.patch
@@ -0,0 +1,65 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: let WED AP ports bind multiple flowtables
+
+flow_block_cb_setup_simple() rejects a second block for the same AP
+netdev with EBUSY. This prevents inet and bridge flowtables sharing a
+Wi-Fi port, and prevents atomic replacement during firewall reload.
+Use the same per-block lookup and reference handling as airoha Ethernet.
+Keep the netdev as callback identity and the WED device as private data.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -578,12 +578,47 @@
+ 			       enum tc_setup_type type, void *data)
+ {
+ 	static LIST_HEAD(blocks);
++	struct flow_block_offload *f = data;
++	struct flow_block_cb *block_cb;
+ 
+ 	if (type != TC_SETUP_BLOCK && type != TC_SETUP_FT)
+ 		return -EOPNOTSUPP;
+-
+-	return flow_block_cb_setup_simple(data, &blocks, airoha_wed_setup_cb,
+-					 dev, wed, true);
++	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
++		return -EOPNOTSUPP;
++
++	/* Like the Ethernet provider, allow a netdev in both inet and bridge
++	 * flowtables. A global per-device busy check also rejects reloads
++	 * while the previous block is still waiting to be unbound.
++	 */
++	f->driver_block_list = &blocks;
++	switch (f->command) {
++	case FLOW_BLOCK_BIND:
++		block_cb = flow_block_cb_lookup(f->block, airoha_wed_setup_cb, dev);
++		if (block_cb) {
++			flow_block_cb_incref(block_cb);
++			return 0;
++		}
++		block_cb = flow_block_cb_alloc(airoha_wed_setup_cb, dev, wed, NULL);
++		if (IS_ERR(block_cb))
++			return PTR_ERR(block_cb);
++
++		flow_block_cb_incref(block_cb);
++		flow_block_cb_add(block_cb, f);
++		list_add_tail(&block_cb->driver_list, &blocks);
++		return 0;
++	case FLOW_BLOCK_UNBIND:
++		block_cb = flow_block_cb_lookup(f->block, airoha_wed_setup_cb, dev);
++		if (!block_cb)
++			return -ENOENT;
++
++		if (!flow_block_cb_decref(block_cb)) {
++			flow_block_cb_remove(block_cb, f);
++			list_del(&block_cb->driver_list);
++		}
++		return 0;
++	default:
++		return -EOPNOTSUPP;
++	}
+ }
+ 
+ static void airoha_wed_ppe_check(struct mtk_wed_device *wed, struct sk_buff *skb,
diff --git a/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch b/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch
