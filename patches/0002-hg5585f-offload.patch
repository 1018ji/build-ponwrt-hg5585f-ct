index 0000000..182cb66
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch
@@ -0,0 +1,29 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] netfilter: flowtable: use the IEEE80211 endpoint for bridge paths
+
+Route path discovery opts into DEV_PATH_IEEE80211, allowing mac80211 to
+return a regular netdev endpoint to Netfilter. Bridge discovery left the
+context flag clear and obtained the driver-specific Airoha WDMA path.
+The generic path parser rejects that path before any flow replace reaches
+PPE. Request the same IEEE80211 endpoint for bridge discovery. The PPE
+continues to discover WDMA details separately when preparing its egress.
+
+On HG5585F with an associated MT7916 client, dev_fill_bridge_path() returns
+DEV_PATH_AIROHA_WDMA without this flag and DEV_PATH_IEEE80211 with it.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/net/netfilter/nf_flow_table_path.c b/net/netfilter/nf_flow_table_path.c
+--- a/net/netfilter/nf_flow_table_path.c
++++ b/net/netfilter/nf_flow_table_path.c
+@@ -340,7 +340,9 @@
+ 				    unsigned char *dst_ha)
+ {
+ 	struct flow_offload_tuple_rhash *th = flow->tuplehash;
+-	struct net_device_path_ctx ctx = {};
++	struct net_device_path_ctx ctx = {
++		.ieee80211 = true,
++	};
+ 	struct net_device_path_stack stack;
+ 	struct nft_forward_info info = {};
+ 	int i, j = 0;
diff --git a/target/linux/airoha/patches-6.18/949-net-airoha-classify-wed-irqs-and-drain-faults.patch b/target/linux/airoha/patches-6.18/949-net-airoha-classify-wed-irqs-and-drain-faults.patch
new file mode 100644
index 0000000..9a5daaa
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/949-net-airoha-classify-wed-irqs-and-drain-faults.patch
@@ -0,0 +1,304 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: classify WED IRQs and drain stalled forwarding
+
+Counting irq_set_mask(0) counted both the mt7915 hard IRQ and tasklet,
+and could disable the WED line while DMA still made progress. Count
+serviced WED causes once, ignore native-only service, and sample DMA
+progress before classifying high-rate normal events as stalled.
+Track high-rate hardware errors separately so moving traffic cannot
+hide a persistent error flood.
+
+Quarantine a confirmed fault through work that closes the PPE egress
+gate, invalidates flows and drains DMA. Serialize that drain with
+consumer teardown and retain uncertain DMA ownership. Stop paths must
+still drain after quarantine, and diagnostics must expose the IRQ state.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -8,12 +8,14 @@
+ #include <linux/iopoll.h>
+ #include <linux/jiffies.h>
+ #include <linux/module.h>
++#include <linux/mutex.h>
+ #include <linux/of_address.h>
+ #include <linux/of_platform.h>
+ #include <linux/pci.h>
+ #include <linux/platform_device.h>
+ #include <linux/seq_file.h>
+ #include <linux/string.h>
++#include <linux/workqueue.h>
+ #include <linux/soc/airoha/airoha_offload.h>
+ #include <linux/soc/mediatek/mtk_wed.h>
+ #include <net/pkt_cls.h>
+@@ -72,8 +74,15 @@
+ 	int last_attach_error;
+ 	u32 last_wdma_cfg;
+ 	atomic_t irq_count;
++	atomic_t irq_error_count;
+ 	unsigned long irq_window;
+ 	atomic_t irq_storm;
++	u32 irq_progress[MTK_WED_TX_QUEUES * 2];
++	u32 irq_last_status;
++	u32 irq_last_errors;
++	struct work_struct irq_fault_work;
++	/* Serialize consumer teardown with deferred fault draining. */
++	struct mutex quiesce_lock;
+ };
+ 
+ static struct airoha_wed *airoha_wed1;
+@@ -233,41 +242,72 @@
+ 
+ #define AIROHA_WED_IRQ_STORM_LIMIT	20000
+ 
+-/* Called from the mt7915 hard IRQ handler with mask 0 on every interrupt. */
+-static void airoha_wed_irq_storm_check(struct airoha_wed *aw)
+-{
++static bool airoha_wed_irq_progress(struct airoha_wed *aw)
++{
++	bool progress = false;
++	unsigned int i;
++
++	for (i = 0; i < MTK_WED_TX_QUEUES; i++) {
++		u32 tx = readl(aw->base + MTK_WED_TX_MIB(i));
++		u32 rx = readl(aw->base + MTK_WED_WDMA_RX_PROCESSED_MIB(i));
++
++		progress |= tx != aw->irq_progress[i * 2] ||
++			    rx != aw->irq_progress[i * 2 + 1];
++		aw->irq_progress[i * 2] = tx;
++		aw->irq_progress[i * 2 + 1] = rx;
++	}
++
++	return progress;
++}
++
++/* The mt7915 tasklet serializes service passes. Masking is not an IRQ. */
++static void airoha_wed_irq_storm_check(struct mtk_wed_device *wed,
++				       u32 status, u32 errors)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	unsigned long now = jiffies, window = READ_ONCE(aw->irq_window);
+-	u32 raw, ext;
+-
+-	if (atomic_read(&aw->irq_storm))
++	bool error_flood;
++
++	if ((!status && !errors) || atomic_read(&aw->irq_storm))
+ 		return;
+-	if (time_after(now, window + HZ) &&
+-	    cmpxchg(&aw->irq_window, window, now) == window)
++	WRITE_ONCE(aw->irq_last_status, status);
++	WRITE_ONCE(aw->irq_last_errors, errors);
++	if (time_after(now, window + HZ)) {
++		WRITE_ONCE(aw->irq_window, now);
+ 		atomic_set(&aw->irq_count, 0);
+-	if (atomic_inc_return(&aw->irq_count) <= AIROHA_WED_IRQ_STORM_LIMIT ||
+-	    atomic_cmpxchg(&aw->irq_storm, 0, 1))
++		atomic_set(&aw->irq_error_count, 0);
++		airoha_wed_irq_progress(aw);
++	}
++	if (errors)
++		atomic_inc(&aw->irq_error_count);
++	error_flood = atomic_read(&aw->irq_error_count) > AIROHA_WED_IRQ_STORM_LIMIT;
++	if (atomic_inc_return(&aw->irq_count) <= AIROHA_WED_IRQ_STORM_LIMIT &&
++	    !error_flood)
+ 		return;
+-	/* Hard IRQ context: only the _nosync variant is safe here. */
+-	raw = readl(aw->base + MTK_WED_INT_STATUS);
+-	ext = readl(aw->base + MTK_WED_EXT_INT_STATUS);
++	/* Sample only at the threshold/window boundary, not on every packet. */
++	if (airoha_wed_irq_progress(aw) && !error_flood) {
++		atomic_set(&aw->irq_count, 0);
++		return;
++	}
++	if (atomic_cmpxchg(&aw->irq_storm, 0, 1))
++		return;
++	/* Block new rules and retain DMA ownership until the fault is drained. */
++	WRITE_ONCE(wed->dma_quarantined, true);
+ 	writel(0, aw->base + MTK_WED_INT_MASK);
+ 	writel(0, aw->base + MTK_WED_EXT_INT_MASK);
+-	/* irq_storm was won above, so this runs once. quarantine/detach test
+-	 * irq_disabled under airoha_wed_lock and must not disable it again.
+-	 */
+-	WRITE_ONCE(aw->irq_disabled, true);
+-	disable_irq_nosync(aw->irq);
++	if (!xchg(&aw->irq_disabled, true))
++		disable_irq_nosync(aw->irq);
++	schedule_work(&aw->irq_fault_work);
+ 	dev_err(aw->dev,
+-		"hg5585f-wifi: component=wed event=irq_storm count=%d raw=%08x ext=%08x; WED irq %d disabled\n",
+-		atomic_read(&aw->irq_count), raw, ext, aw->irq);
++		"hg5585f-wifi: component=wed event=irq_fault cause=%s count=%d errors=%d status=%08x ext=%08x; quarantining WED irq %d\n",
++		error_flood ? "errors" : "no_progress", atomic_read(&aw->irq_count),
++		atomic_read(&aw->irq_error_count), status, errors, aw->irq);
+ }
+ 
+ static void airoha_wed_irq_mask(struct mtk_wed_device *wed, u32 mask)
+ {
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 
+-	if (!mask)
+-		airoha_wed_irq_storm_check(aw);
+ 	if (aw->poisoned || atomic_read(&aw->irq_storm))
+ 		mask = 0;
+ 	/* An extended error asserts the same IRQ even if INT_MASK is zero.
+@@ -298,7 +338,8 @@
+ 		dev_warn_ratelimited(wed->dev, "hg5585f-wifi: component=wed event=exception status=0x%08x\n", errors);
+ 	}
+ 
+-	return status;
++	airoha_wed_irq_storm_check(wed, status, errors);
++	return atomic_read(&aw->irq_storm) ? 0 : status;
+ }
+ 
+ static int airoha_wdma_rx_idle(struct airoha_wed *aw)
+@@ -353,26 +394,43 @@
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	int err, dma_err;
+ 
+-	if (aw->poisoned || wed->dma_quarantined) {
+-		err = -EIO;
+-		goto quarantine;
+-	}
++	mutex_lock(&aw->quiesce_lock);
+ 	err = aw->ppe->ops.flush_wed(aw->ppe, U16_MAX);
+ 	dma_err = airoha_wed_quiesce(wed);
+-	if (err || dma_err) {
+-		err = err ? err : dma_err;
+-		goto quarantine;
+-	}
+-
+-	return 0;
+-quarantine:
+-	wed->dma_quarantined = true;
+-	aw->poisoned = true;
+-	if (!READ_ONCE(aw->irq_disabled)) {
+-		WRITE_ONCE(aw->irq_disabled, true);
+-		disable_irq(aw->irq);
+-	}
++	if (!err)
++		err = dma_err;
++	if (!err && (aw->poisoned || wed->dma_quarantined))
++		err = -EIO;
++	if (err) {
++		wed->dma_quarantined = true;
++		aw->poisoned = true;
++		if (!xchg(&aw->irq_disabled, true))
++			disable_irq(aw->irq);
++	}
++	mutex_unlock(&aw->quiesce_lock);
+ 	return err;
++}
++
++static void airoha_wed_irq_fault_work(struct work_struct *work)
++{
++	struct airoha_wed *aw = container_of(work, struct airoha_wed,
++					   irq_fault_work);
++	struct mtk_wed_device *wed;
++	int err;
++
++	mutex_lock(&airoha_wed_lock);
++	wed = aw->wlan;
++	if (!wed)
++		goto out;
++	/* Close the PPE egress gate before invalidating its existing rules. */
++	if (!aw->ppe->ops.set_wed(aw->ppe, false))
++		aw->ppe_configured = false;
++	err = airoha_wed_stop_sync(wed);
++	dev_err(aw->dev,
++		"hg5585f-wifi: component=wed event=irq_quarantined error=%d dma_memory=retained\n",
++		err);
++out:
++	mutex_unlock(&airoha_wed_lock);
+ }
+ 
+ static void airoha_wed_stop(struct mtk_wed_device *wed)
+@@ -500,7 +558,8 @@
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	u32 cfg;
+ 
+-	if (aw->poisoned || !wed->txfree_ring.wpdma || !wed->tx_ring[0].desc)
++	if (aw->poisoned || wed->dma_quarantined ||
++	    !wed->txfree_ring.wpdma || !wed->tx_ring[0].desc)
+ 		return;
+ 	if (!wed->init_done && airoha_wed_hw_init(wed)) {
+ 		dev_err(aw->dev, "hg5585f-wifi: component=wed event=buffer_manager_reset_failed\n");
+@@ -518,6 +577,10 @@
+ 	writel(GENMASK(17, 16), aw->wdma + MTK_WDMA_INT_GRP2);
+ 	airoha_wed_write(wed, MTK_WED_WPDMA_INT_MASK, mask);
+ 	/* airoha_wed_irq_mask() enables both IRQ sources after DMA setup. */
++	atomic_set(&aw->irq_count, 0);
++	atomic_set(&aw->irq_error_count, 0);
++	WRITE_ONCE(aw->irq_window, jiffies);
++	airoha_wed_irq_progress(aw);
+ 	dma_wmb();
+ 	airoha_wed_rmw(wed, MTK_WED_WPDMA_GLO_CFG, 0, EN7581_WED_DMA_ENABLE);
+ 	airoha_wed_rmw(wed, MTK_WED_WDMA_GLO_CFG, 0, BIT(2));
+@@ -567,7 +630,7 @@
+ 
+ 	if (type != TC_SETUP_CLSFLOWER)
+ 		return -EOPNOTSUPP;
+-	if ((!wed->running || aw->poisoned) &&
++	if ((!wed->running || aw->poisoned || wed->dma_quarantined) &&
+ 	    ((struct flow_cls_offload *)data)->command == FLOW_CLS_REPLACE)
+ 		return -EOPNOTSUPP;
+ 
+@@ -799,6 +862,8 @@
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	unsigned int i;
+ 
++	/* The consumer has removed its IRQs and killed the mt7915 tasklet. */
++	cancel_work_sync(&aw->irq_fault_work);
+ 	mutex_lock(&airoha_wed_lock);
+ 	if (!airoha_wed_stop_sync(wed) &&
+ 	    !airoha_wed_reset(wed, MTK_WED_RESET_WED)) {
+@@ -817,10 +882,8 @@
+ 		}
+ 	} else {
+ 		aw->poisoned = true;
+-		if (!READ_ONCE(aw->irq_disabled)) {
+-			WRITE_ONCE(aw->irq_disabled, true);
++		if (!xchg(&aw->irq_disabled, true))
+ 			disable_irq(aw->irq);
+-		}
+ 	}
+ 	airoha_ppe_put_dev(aw->ppe);
+ 	aw->ppe = NULL;
+@@ -889,7 +952,13 @@
+ 	mutex_lock(&airoha_wed_lock);
+ 	wed = aw->wlan;
+ 	seq_printf(s, "attached: %u\nrunning: %u\nquarantined: %u\n",
+-		   !!wed, wed && wed->running, aw->poisoned);
++		   !!wed, wed && wed->running,
++		   aw->poisoned || (wed && wed->dma_quarantined));
++	seq_printf(s, "irq_disabled: %u\nirq_faulted: %u\nirq_service_count: %u\nirq_error_count: %u\n",
++		   READ_ONCE(aw->irq_disabled), atomic_read(&aw->irq_storm),
++		   atomic_read(&aw->irq_count), atomic_read(&aw->irq_error_count));
++	seq_printf(s, "irq_last_status: %08x\nirq_last_errors: %08x\n",
++		   READ_ONCE(aw->irq_last_status), READ_ONCE(aw->irq_last_errors));
+ 	seq_printf(s, "tx_path: ppe-wdma1-wed1-mt7916\nrx_path: %s\n",
+ 		   aw->legacy ? "npu" : "native");
+ 	seq_printf(s, "ppe_configured: %u\ntokens_reserved: %u\n",
+@@ -937,6 +1006,8 @@
+ 	if (!aw)
+ 		return -ENOMEM;
+ 	aw->dev = dev;
++	INIT_WORK(&aw->irq_fault_work, airoha_wed_irq_fault_work);
++	mutex_init(&aw->quiesce_lock);
+ 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "wed");
