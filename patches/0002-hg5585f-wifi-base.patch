+def function(text, name):
+    position = text.index(name + '(')
+    start = text.rfind('\n\n', 0, position) + 2
+    brace = text.index('{', position)
+    end, depth = brace + 1, 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return '\n'.join(line for line in text[start:end].splitlines()
+                     if not line.startswith('#'))
