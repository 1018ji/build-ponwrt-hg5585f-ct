+++ b/scripts/check-hg5585f-ppe-accounting.py
@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+"""Exercise the actual PPE account collector with read-and-clear MMIO."""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def check_readers(root):
+    rpc = (root/'package/luci-app-airoha-npu/root/usr/libexec/rpcd/luci.airoha_npu').read_text()
+    sampler = (root/'files/usr/sbin/hg5585f-wifi-offload-check').read_text()
+
+    def shell_function(name):
+        start = rpc.index(name + '() {')
+        end = rpc.index('\n}\n', start) + 3
+        return rpc[start:end]
+
+    def fixture(samples=1, generation=1, running=1, delta=0):
+        text = (f'backend: hg5585f-fe-account\nrunning: {running}\n'
+                f'generation: {generation}\nsamples: {samples}\n')
+        return text + ''.join(f'group {i} {10 + delta if i == 31 else 0} '
+                              f'{1500 + delta * 100 if i == 31 else 0}\n'
+                              for i in range(63))
+
+    with tempfile.TemporaryDirectory(prefix='hg5585f-account-readers-') as temporary:
+        directory = Path(temporary)
+        accounting = directory/'accounting'
+        entries = directory/'entries'
+        before, after = directory/'before', directory/'after'
+
+        def call(name):
+            body = shell_function(name).replace('/sys/kernel/debug/ppe/accounting', str(accounting))
+            body = body.replace('/sys/kernel/debug/ppe/entries', str(entries))
+            return json.loads(subprocess.check_output(['sh', '-c', body + '\n' + name], text=True))
+
+        assert not call('get_ppe_accounting')['available']
+        text = fixture().replace('group 31 10 1500', 'group 31 9007199254740993 18446744073709551615')
+        accounting.write_text(text)
+        data = call('get_ppe_accounting')
+        assert data['available'] and data['running'] and len(data['groups']) == 63
+        assert data['groups'][31]['packets'] == '9007199254740993'
+        assert data['groups'][31]['bytes'] == '18446744073709551615'
+        accounting.write_text(fixture(samples=0, generation=0, running=0))
+        data = call('get_ppe_accounting')
+        assert data['available'] and not data['running'] and data['generation'] == '0'
+        accounting.write_text(fixture().replace('group 62 ', 'group 63 '))
+        assert not call('get_ppe_accounting')['available']
+        entries.write_text('00001 BND IPv4 5T orig=1.2.3.4:1->5.6.7.8:2 stats=shared_group account_group=0\n'
+                           '00002 BND L2B stats=shared_group account_group=62\n'
+                           '00003 BND IPv6 5T stats=disabled\n')
+        assert [e['account_group'] for e in call('get_ppe_entries')['entries']] == [0, 62, None]
+
+        block = sampler[sampler.index('if [ -f "$report/accounting-before" ]'):]
+        program = re.search(r"\tawk '([\s\S]*?)\n\t' ", block).group(1)
+        before.write_text(fixture())
+
+        def sample(**kwargs):
+            after.write_text(fixture(**kwargs))
+            return subprocess.check_output(['awk', program, str(before), str(after)], text=True)
+
+        output = sample(samples=2, delta=3)
+        assert 'group 31 delta: packets=3 bytes=300' in output
+        assert output.count('group ') == 1
+        assert 'no hardware counter progress' in sample(samples=2)
+        assert 'inconclusive' in sample(samples=2, generation=2)
+        assert 'inconclusive' in sample(samples=2, running=0)
+        assert 'inconclusive' in sample(samples=1)
+    print('PASS: RPC preserves 64-bit counts and group 0; sampler rejects reset/stopped/stale samples')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, required=True)
+    parser.add_argument('--cc', default='cc')
+    args = parser.parse_args()
+    fixture = json.loads((Path(__file__).resolve().parent /
+                         'tests/hg5585f-rom-accounting.json').read_text())
+    header = args.source.with_suffix('.h').read_text()
+    source = args.source.read_text()
+    # Compile the shipped collector, replacing only kernel services and MMIO.
+    code = '\n'.join(line for line in (header + '\n' + source).splitlines()
+                     if not line.startswith('#include'))
+    prefix = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef unsigned int spinlock_t;
+#define GENMASK(h,l) ((UINT32_MAX >> (31-(h))) & (UINT32_MAX << (l)))
+#define FIELD_GET(m,v) (((v) & (m)) >> __builtin_ctz(m))
+#define GFP_KERNEL 0
+#define HZ 100
+#define WARN_ON_ONCE(v) (v)
+#define container_of(p,t,m) ((t *)((char *)(p)-offsetof(t,m)))
+struct work_struct { int unused; };
+struct delayed_work {
+    struct work_struct work;
+    void (*function)(struct work_struct *);
+    bool pending;
+};
+#define to_delayed_work(p) container_of(p,struct delayed_work,work)
+#define INIT_DELAYED_WORK(w,fn) do { (w)->function=(fn); } while (0)
+static void *system_wq;
+static void spin_lock_init(spinlock_t *lock) { *lock=0; }
+static void spin_lock_bh(spinlock_t *lock) { assert(!*lock); *lock=1; }
+static void spin_unlock_bh(spinlock_t *lock) { assert(*lock); *lock=0; }
+static void lockdep_assert_held(spinlock_t *lock) { assert(*lock); }
+static void queue_delayed_work(void *queue,struct delayed_work *work,int delay)
+{ (void)queue; assert(delay==HZ && !work->pending); work->pending=true; }
+static void cancel_delayed_work_sync(struct delayed_work *work) { work->pending=false; }
+static u64 tick;
+static u64 ktime_get_ns(void) { return ++tick; }
+struct airoha_eth { void *dev; };
+struct airoha_ppe {
+    struct airoha_eth *eth;
+    struct airoha_ppe_account *account;
+    bool host_managed;
+};
+static void (*release_action)(void *);
+static void *release_data;
+static void *devm_kzalloc(void *device,size_t size,int flags)
+{ (void)device; (void)flags; return calloc(1,size); }
+static int devm_add_action_or_reset(void *dev,void (*action)(void *),void *data)
+{ (void)dev; release_action=action; release_data=data; return 0; }
+static unsigned int reads,phase[63];
+static u32 registers[63][3];
+'''
+    prefix += f'''
+static u32 airoha_fe_rr(struct airoha_eth *eth,u32 address)
+{{
+    (void)eth;
+    assert(address >= {fixture['bank_offset']});
+    unsigned int offset=address-{fixture['bank_offset']};
+    unsigned int group=offset/{fixture['stride']};
+    unsigned int word=(offset%{fixture['stride']})/4;
+    assert(group < {fixture['groups']} && word < 3 && !(address & 3));
+    assert(word == phase[group]);
+    phase[group]=(phase[group]+1)%3;
+    u32 value=registers[group][word];
+    registers[group][word]=0;
+    reads++;
+    return value;
+}}
+'''
+    test = r'''
+static void poll(struct airoha_ppe *ppe)
+{
+    struct delayed_work *work=&ppe->account->work;
+    assert(work->pending);
+    work->pending=false;
+    work->function(&work->work);
+}
+int main(void)
+{
+    struct airoha_eth eth={0};
+    struct airoha_ppe ppe={.eth=&eth};
+    struct airoha_ppe_account_snapshot a,b;
+    assert(airoha_ppe_account_init(&ppe)==0 && !ppe.account);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==-EOPNOTSUPP);
+    airoha_ppe_account_start(&ppe); airoha_ppe_account_stop(&ppe);
+    assert(!reads);
+    ppe.host_managed=true;
+    assert(airoha_ppe_account_init(&ppe)==0 && ppe.account);
+    registers[0][0]=999; registers[62][2]=55;
+    airoha_ppe_account_start(&ppe);
+    assert(reads==63*3);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==0);
+    assert(a.running && a.generation==1 && !a.samples && !a.group[0].bytes);
+    assert(!a.group[62].packets);
+    registers[0][0]=0xfffffff0;registers[0][1]=1;registers[0][2]=UINT32_MAX;
+    registers[31][0]=1500;registers[31][2]=2;
+    registers[62][0]=9000;registers[62][2]=10;
+    poll(&ppe);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==0);
+    assert(a.samples==1 && a.group[0].bytes==UINT64_C(0x1fffffff0));
+    assert(a.group[31].bytes==1500 && a.group[62].packets==10);
+    unsigned int previous_reads=reads;
+    assert(airoha_ppe_account_snapshot(&ppe,&b)==0 && !memcmp(&a,&b,sizeof(a)));
+    assert(reads==previous_reads); /* Additional readers cannot steal deltas. */
+    registers[0][0]=0x30;registers[0][2]=2;
+    poll(&ppe);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==0);
+    assert(a.group[0].bytes==UINT64_C(0x200000020));
+    assert(a.group[0].packets==UINT64_C(0x100000001));
+    assert(a.group[31].bytes==1500); /* No traffic: no double counting. */
+    registers[31][0]=3000; registers[31][2]=3;
+    airoha_ppe_account_stop(&ppe);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==0);
+    assert(!a.running && a.samples==3 && a.group[31].bytes==4500);
+    assert(!ppe.account->work.pending);
+    previous_reads=reads;
+    ppe.account->work.function(&ppe.account->work.work);
+    airoha_ppe_account_stop(&ppe);
+    assert(reads==previous_reads && !ppe.account->work.pending);
+    registers[31][0]=7000;registers[31][2]=99;
+    airoha_ppe_account_start(&ppe);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==0);
+    assert(a.running && a.generation==2 && !a.samples);
+    assert(!a.group[31].bytes && !a.group[31].packets);
+    registers[31][0]=100;registers[31][2]=1;
+    poll(&ppe);
+    assert(airoha_ppe_account_snapshot(&ppe,&a)==0);
+    assert(a.group[31].bytes==100 && a.group[31].packets==1);
+    for (unsigned int group=0;group<64;group++)
+        assert(FIELD_GET(AIROHA_PPE_ACCOUNT_GROUP_MASK,
+                        0xff000000 | (31 << 19) | (group << 13) | 0x1fff)==group);
+    release_action(release_data);
+    assert(!ppe.account->work.pending);
+    free(ppe.account);
+    puts("PASS: ROM account bank bounds/read order, 64-bit carry, shared readers, stop and restart");
+}
+'''
+    with tempfile.TemporaryDirectory(prefix='hg5585f-ppe-account-') as temporary:
+        cfile = Path(temporary)/'test.c'
+        binary = Path(temporary)/'test'
+        cfile.write_text(prefix + '\n' + code + '\n' + test)
+        subprocess.run([args.cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                        '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+                        str(cfile), '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+    if (Path(__file__).resolve().parents[1]/'package/luci-app-airoha-npu').exists(): check_readers(Path(__file__).resolve().parents[1])
+
+
+if __name__ == '__main__':
+    main()
