+#!/usr/bin/env python3
+"""Check the HG5585F wireless offload patches and matching firmware pair."""
+import hashlib
+from pathlib import Path
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+patches = [root / 'target/linux/airoha/patches-6.18' / name for name in (
+    '931-net-airoha-fix-wan-ipv6-pppoe-flow-offload.patch',
+    '933-net-airoha-add-mt7916-wed-tx.patch',
+    '934-dt-bindings-net-airoha-mt7916-wed.patch',
+    '935-net-airoha-hg5585f-npu-rx-ppe.patch',
+    '936-dt-bindings-airoha-hg5585f-npu-rx.patch',
+    '937-net-airoha-hg5585f-hardware-accounting.patch',
+)]
+patches += sorted((root / 'package/kernel/mt76/patches').glob('*.patch'))
+for patch in patches:
+    stats = subprocess.check_output(['git', 'apply', '--numstat', str(patch)], text=True)
+    for line in stats.splitlines():
+        assert not line.split('\t')[-1].endswith(('.orig', '.rej')), patch
+print(f'PASS: {len(patches)} HG5585F kernel/mt76 patches parse completely')
+for name, expected in {
+    'en7581_MT7916_npu_rv32.bin': 'a8757aabc872c31d20683aeb4c05dbb9f7f590bdd6a1102c8a6902385bb5e9a6',
+    'en7581_MT7916_npu_data.bin': '6f8cd8d7cd1cdaadfa03bef63bf71c1ad21aa2a4ad950b501761d2387d52a696',
+}.items():
+    path = root/'files/lib/firmware/airoha'/name
+    assert hashlib.sha256(path.read_bytes()).hexdigest() == expected, path
+print('PASS: matching HG5585F code/data firmware pair')
diff --git a/scripts/check-hg5585f-ppe-accounting.py b/scripts/check-hg5585f-ppe-accounting.py
