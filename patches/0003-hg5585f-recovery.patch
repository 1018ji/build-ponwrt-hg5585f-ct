diff --git a/target/linux/airoha/patches-6.18/952-net-airoha-wed-stop-recovery.patch b/target/linux/airoha/patches-6.18/952-net-airoha-wed-stop-recovery.patch
new file mode 100644
index 0000000..06def86
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/952-net-airoha-wed-stop-recovery.patch
@@ -0,0 +1,160 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: stop producers before polling WED DMA idle
+
+Disable WDMA RX and both WED DMA drivers before polling idle. Retry all
+four idle checks after the existing bounded WED reset; never reset RX
+indices while an external DMA engine may still be active. Keep terminal
+quarantine on failed reset, busy status, PPE flush failure or prior fault.
+Expose stop stages, error codes and reset attempt/result counters.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -89,6 +89,12 @@
+ 	struct work_struct irq_fault_work;
+ 	/* Serialize consumer teardown with deferred fault draining. */
+ 	struct mutex quiesce_lock;
++	const char *last_stop_stage;
++	int last_stop_error;
++	int last_dma_stop_error;
++	int last_flush_error;
++	u32 stop_reset_attempts;
++	u32 stop_reset_successes;
+ };
+ 
+ static struct airoha_wed *airoha_wed1;
+@@ -695,11 +701,11 @@
+ 				 10, 100000);
+ }
+ 
+-static int airoha_wed_quiesce(struct mtk_wed_device *wed)
++/* Disable every producer before polling a consumer that it can keep busy. */
++static void airoha_wed_disable_dma(struct mtk_wed_device *wed)
+ {
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	u32 val;
+-	int err;
+ 
+ 	airoha_wed_irq_mask(wed, 0);
+ 	airoha_wed_write(wed, MTK_WED_EXT_INT_MASK, 0);
+@@ -707,27 +713,76 @@
+ 	writel(0, aw->wdma + MTK_WDMA_INT_GRP2);
+ 	val = readl(aw->wdma + MTK_WDMA_GLO_CFG);
+ 	writel(val & ~MTK_WDMA_GLO_CFG_RX_DMA_EN, aw->wdma + MTK_WDMA_GLO_CFG);
+-	err = airoha_wdma_rx_idle(aw);
+ 	airoha_wed_rmw(wed, MTK_WED_GLO_CFG, EN7581_WED_DMA_ENABLE, 0);
+ 	airoha_wed_rmw(wed, MTK_WED_WPDMA_GLO_CFG, EN7581_WED_DMA_ENABLE, 0);
+ 	airoha_wed_rmw(wed, MTK_WED_WDMA_GLO_CFG, BIT(2), 0);
+-	if (airoha_wed_poll(aw, MTK_WED_GLO_CFG, EN7581_WED_DMA_BUSY) ||
+-	    airoha_wed_poll(aw, MTK_WED_WPDMA_GLO_CFG, EN7581_WED_DMA_BUSY) ||
+-	    airoha_wed_poll(aw, MTK_WED_WDMA_GLO_CFG, BIT(3)))
+-		err = -ETIMEDOUT;
++	/* Complete posted disable writes before reading any busy status. */
++	airoha_wed_read(wed, MTK_WED_WDMA_GLO_CFG);
++}
++
++static int airoha_wed_dma_idle(struct mtk_wed_device *wed)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	int err;
++
++	aw->last_stop_stage = "wdma_rx";
++	err = airoha_wdma_rx_idle(aw);
++	if (err)
++		return err;
++	aw->last_stop_stage = "wed_dma";
++	err = airoha_wed_poll(aw, MTK_WED_GLO_CFG, EN7581_WED_DMA_BUSY);
++	if (err)
++		return err;
++	aw->last_stop_stage = "wpdma_drv";
++	err = airoha_wed_poll(aw, MTK_WED_WPDMA_GLO_CFG, EN7581_WED_DMA_BUSY);
++	if (err)
++		return err;
++	aw->last_stop_stage = "wdma_drv";
++	err = airoha_wed_poll(aw, MTK_WED_WDMA_GLO_CFG, BIT(3));
++	if (!err)
++		aw->last_stop_stage = "idle";
++	return err;
++}
++
++static int airoha_wed_quiesce(struct mtk_wed_device *wed)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	int err;
++
++	airoha_wed_disable_dma(wed);
++	err = airoha_wed_dma_idle(wed);
+ 	if (err) {
+-		/* Hardware reset is the fallback; never treat a busy timeout as idle. */
++		dev_warn(aw->dev,
++			 "hg5585f-wifi: component=wed event=stop_retry stage=%s error=%d wdma=%08x wed=%08x wpdma=%08x drv=%08x\n",
++			 aw->last_stop_stage, err,
++			 readl(aw->wdma + MTK_WDMA_GLO_CFG),
++			 airoha_wed_read(wed, MTK_WED_GLO_CFG),
++			 airoha_wed_read(wed, MTK_WED_WPDMA_GLO_CFG),
++			 airoha_wed_read(wed, MTK_WED_WDMA_GLO_CFG));
++		aw->stop_reset_attempts++;
++		aw->last_stop_stage = "wed_reset";
+ 		err = airoha_wed_reset(wed, MTK_WED_RESET_WED);
+ 		wed->init_done = false;
+-		if (!err)
+-			err = airoha_wdma_rx_idle(aw);
++		if (!err) {
++			airoha_wed_disable_dma(wed);
++			/* A WED reset does not prove that the external WDMA stopped. */
++			err = airoha_wed_dma_idle(wed);
++			if (!err) {
++				aw->stop_reset_successes++;
++				dev_info(aw->dev,
++					 "hg5585f-wifi: component=wed event=stop_recovered\n");
++			}
++		}
+ 	}
+ 	airoha_wed_write(wed, MTK_WED_WPDMA_INT_TRIGGER, 0);
+ 	airoha_wed_write(wed, MTK_WED_WDMA_INT_TRIGGER, 0);
+ 	wed->running = false;
++	aw->last_dma_stop_error = err;
+ 	if (err) {
+ 		aw->poisoned = true;
+-		dev_err(aw->dev, "hg5585f-wifi: component=wed event=reset_failed dma_memory=retained\n");
++		dev_err(aw->dev,
++			"hg5585f-wifi: component=wed event=reset_failed stage=%s error=%d dma_memory=retained\n",
++			aw->last_stop_stage, err);
+ 	}
+ 
+ 	return err;
+@@ -739,13 +794,20 @@
+ 	int err, dma_err;
+ 
+ 	mutex_lock(&aw->quiesce_lock);
++	/* Reject new flow replacements while the existing rules are drained. */
++	WRITE_ONCE(wed->running, false);
+ 	err = aw->ppe->ops.flush_wed(aw->ppe, U16_MAX);
++	aw->last_flush_error = err;
+ 	dma_err = airoha_wed_quiesce(wed);
+ 	if (!err)
+ 		err = dma_err;
+ 	if (!err && (aw->poisoned || wed->dma_quarantined))
+ 		err = -EIO;
++	aw->last_stop_error = err;
+ 	if (err) {
++		dev_err(aw->dev,
++			"hg5585f-wifi: component=wed event=stop_failed ppe_error=%d dma_error=%d error=%d stage=%s\n",
++			aw->last_flush_error, dma_err, err, aw->last_stop_stage);
+ 		wed->dma_quarantined = true;
+ 		aw->poisoned = true;
+ 		if (!xchg(&aw->irq_disabled, true))
+@@ -1303,6 +1365,11 @@
+ 		   atomic_read(&aw->irq_count), atomic_read(&aw->irq_error_count));
+ 	seq_printf(s, "irq_last_status: %08x\nirq_last_errors: %08x\n",
+ 		   READ_ONCE(aw->irq_last_status), READ_ONCE(aw->irq_last_errors));
++	seq_printf(s, "last_stop_stage: %s\nlast_stop_error: %d\nlast_dma_stop_error: %d\nlast_flush_error: %d\n",
++		   READ_ONCE(aw->last_stop_stage) ?: "none", READ_ONCE(aw->last_stop_error),
++		   READ_ONCE(aw->last_dma_stop_error), READ_ONCE(aw->last_flush_error));
++	seq_printf(s, "stop_reset_attempts: %u\nstop_reset_successes: %u\n",
++		   READ_ONCE(aw->stop_reset_attempts), READ_ONCE(aw->stop_reset_successes));
+ 	seq_printf(s, "tx_path: ppe-wdma1-wed1-mt7916\nrx_path: %s\n",
+ 		   aw->legacy ? "npu" : "native");
+ 	seq_printf(s, "ppe_configured: %u\ntokens_reserved: %u\n",
