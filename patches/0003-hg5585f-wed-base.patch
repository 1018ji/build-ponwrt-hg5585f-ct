+int main(void)
+{
+    mask_and_ack_tests();
+    struct device dev; struct airoha_wed aw = {.dev = &dev, .irq = 7};
+    aw.base = (char *)aw.regs;
+    struct mtk_wed_device wed = {.priv = &aw};
+    aw.regs[MTK_WED_INT_STATUS / 4] = 0xa5; aw.regs[MTK_WED_EXT_INT_STATUS / 4] = 0x5a;
