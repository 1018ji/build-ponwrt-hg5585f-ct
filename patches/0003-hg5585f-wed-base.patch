+    match = re.search(r'^static int ' + re.escape(name) + r'\(', text, re.M)
+    assert match, name
+    brace = text.index('{', match.start())
+    end, depth = brace + 1, 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[match.start():end]
