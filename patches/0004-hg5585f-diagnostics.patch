@@ -165,6 +168,11 @@ static void capture_tests(void)
     assert(bad.valid && !bad.payload_valid);
     memset(&bad,0,sizeof(bad));airoha_wed_diag_buffer(&wed,&bad,2);
     assert(!bad.valid && !writes);
+    debug_enabled=false;
