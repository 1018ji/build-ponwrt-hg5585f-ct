-    assert match, 'Missing numeric definition: ' + name
-    return int(match[1])
-
-
-def firmware_bound(code, offset):
-    word = struct.unpack_from('<I', code, offset)[0]
-    # RV32 ADDI a0,zero,imm; band0/band1 use the same literal upper index.
-    assert word & 0xfffff == 0x00513, hex(word)
-    immediate = word >> 20
-    return immediate - 4096 if immediate & 2048 else immediate
-
-
-def firmware_next(code, current, bound):
-    """Execute 0x8400322a..0x84003234: ADDI, SLTU, ADDI, AND."""
-    registers = [0] * 32
-    registers[9] = current  # s1, firmware consumer
-    registers[10] = bound  # a0
-    offset = 0x322a
-    while offset < 0x3234:
-        half = struct.unpack_from('<H', code, offset)[0]
-        if half & 3 != 3:
-            rd = (half >> 7) & 31
-            if half & 0xe003 == 0x0001:  # C.ADDI
-                immediate = ((half >> 2) & 31) | ((half >> 12) & 1) << 5
-                if immediate & 32:
-                    immediate -= 64
-                registers[rd] = (registers[rd] + immediate) & 0xffffffff
-            elif half & 0xfc63 == 0x8c61:  # C.AND
-                rd, rs2 = 8 + ((half >> 7) & 7), 8 + ((half >> 2) & 7)
-                registers[rd] &= registers[rs2]
-            else:
-                raise AssertionError('Unexpected compressed instruction: ' + hex(half))
-            offset += 2
-        else:
-            word = struct.unpack_from('<I', code, offset)[0]
-            assert word & 0xfe00707f == 0x3033, hex(word)  # SLTU
-            rd, rs1, rs2 = (word >> 7) & 31, (word >> 15) & 31, (word >> 20) & 31
-            registers[rd] = int(registers[rs1] < registers[rs2])
-            offset += 4
-        registers[0] = 0
-    assert offset == 0x3234
-    return registers[9]
-
-
-def first_bad_index(code, capacity, bound):
-    cursor = 0
-    for _ in range(3 * (bound + 1)):
-        if cursor >= capacity:
-            return cursor
-        cursor = firmware_next(code, cursor, bound)
-    return None
-
-
