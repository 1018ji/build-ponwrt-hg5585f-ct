diff --git a/target/linux/airoha/patches-6.18/942-clk-en7523-fix-reset-control-state.patch b/target/linux/airoha/patches-6.18/942-clk-en7523-fix-reset-control-state.patch
new file mode 100644
index 0000000..6a957c8
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/942-clk-en7523-fix-reset-control-state.patch
@@ -0,0 +1,47 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] clk: en7523: initialize reset values and propagate regmap errors
+
+Reset update used an uninitialized value when setting or clearing a bit.
+Assign the asserted/deasserted value explicitly for normal and inverted
+reset banks, and propagate update/read failures to reset consumers.
+
+diff --git a/drivers/clk/clk-en7523.c b/drivers/clk/clk-en7523.c
+--- a/drivers/clk/clk-en7523.c
++++ b/drivers/clk/clk-en7523.c
+@@ -1033,14 +1033,12 @@
+ 
+ 	/* For PCIC reset logic is inverted, 0:assert 1:deassert*/
+ 	if (addr == REG_NP_SCU_PCIC)
+-		val |= assert ? 0 : BIT(id % RST_NR_PER_BANK);
++		val = assert ? 0 : BIT(id % RST_NR_PER_BANK);
+ 	else
+-		val |= assert ? BIT(id % RST_NR_PER_BANK) : 0;
+-
+-	regmap_update_bits(rst_data->map, addr, BIT(id % RST_NR_PER_BANK),
+-			   val);
+-
+-	return 0;
++		val = assert ? BIT(id % RST_NR_PER_BANK) : 0;
++
++	return regmap_update_bits(rst_data->map, addr,
++				  BIT(id % RST_NR_PER_BANK), val);
+ }
+ 
+ static int en7523_reset_assert(struct reset_controller_dev *rcdev,
+@@ -1062,12 +1060,15 @@
+ 	u32 addr = rst_data->bank_ofs[id / RST_NR_PER_BANK];
+ 	bool inverted = false;
+ 	u32 val;
++	int err;
+ 
+ 	/* For PCIC reset logic is inverted, 0:assert 1:deassert*/
+ 	if (addr == REG_NP_SCU_PCIC)
+ 		inverted = true;
+ 
+-	regmap_read(rst_data->map, addr, &val);
++	err = regmap_read(rst_data->map, addr, &val);
++	if (err)
++		return err;
+ 	val &= BIT(id % RST_NR_PER_BANK);
+ 	return inverted ? !val : !!val;
+ }
diff --git a/target/linux/airoha/patches-6.18/943-net-airoha-fix-npu-probe-reset-lifecycle.patch b/target/linux/airoha/patches-6.18/943-net-airoha-fix-npu-probe-reset-lifecycle.patch
new file mode 100644
index 0000000..dade5c3
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/943-net-airoha-fix-npu-probe-reset-lifecycle.patch
@@ -0,0 +1,148 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: avoid reset-held MMIO during legacy NPU probe retry
+
+A probe retry can inherit NPU and GDMA blocks already held in reset.
+Do not poll the GDMA register window in that state. Verify deassertion
+before accessing either block, and reject missing/invalid firmware before
+changing reset ownership or allocating DMA. Keep lifecycle stages behind
+the existing wireless debug switch.
+
+diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
+--- a/drivers/net/ethernet/airoha/airoha_npu.c
++++ b/drivers/net/ethernet/airoha/airoha_npu.c
+@@ -299,11 +299,23 @@
+ 	return state < 0 ? state : err;
+ }
+ 
++static int airoha_npu_deassert_reset(struct reset_control *reset)
++{
++	int state, err;
++
++	err = reset_control_deassert(reset);
++	if (err)
++		return err;
++	err = read_poll_timeout(reset_control_status, state, state <= 0,
++				100, 10000, false, reset);
++	return state < 0 ? state : err;
++}
++
+ static int airoha_npu_legacy_stop(struct airoha_npu *npu)
+ {
+ 	struct airoha_npu_legacy *legacy = npu->legacy;
+ 	struct airoha_npu_core *core = &npu->cores[0];
+-	int err, dma_err, drain_err = 0, i;
++	int err, dma_err, npu_state, dma_state, drain_err = 0, i;
+ 	u32 value;
+ 
+ 	lockdep_assert_held(&legacy->lock);
+@@ -319,7 +331,10 @@
+ 	spin_lock_bh(&core->lock);
+ 	WRITE_ONCE(legacy->blocked, true);
+ 	spin_unlock_bh(&core->lock);
+-	if (reset_control_status(legacy->npu_reset) == 0) {
++	npu_state = reset_control_status(legacy->npu_reset);
++	airoha_wlan_dbg(npu->dev, "npu", "event=stop_stage stage=mask_irqs npu_reset=%d",
++			npu_state);
++	if (!npu_state) {
+ 		regmap_write(npu->regmap, REG_CR_MBOX_INT_STATUS,
+ 			     MBOX_INT_STATUS_MASK);
+ 		for (i = 0; i < 2; i++)
+@@ -343,11 +358,25 @@
+ 	/* Stop request producers, drain the independent copy engine, then hold
+ 	 * both blocks in reset. A timeout never grants permission to free DMA.
+ 	 */
++	airoha_wlan_dbg(npu->dev, "npu", "event=stop_stage stage=npu_reset");
+ 	err = airoha_npu_assert_reset(legacy->npu_reset);
+-	if (!err)
+-		drain_err = readl_poll_timeout(legacy->gdma +
+-			LEGACY_GDMA_CTRL0(LEGACY_RX_COPY_CHANNEL), value,
+-			!(value & LEGACY_GDMA_BUSY), 10, 100000);
++	if (!err && npu_state < 0)
++		err = npu_state;
++	if (!err) {
++		dma_state = reset_control_status(legacy->gdma_reset);
++		airoha_wlan_dbg(npu->dev, "npu", "event=stop_stage stage=gdma_drain gdma_reset=%d",
++				dma_state);
++		/* A deferred probe can arrive with GDMA already held in reset.
++		 * Its MMIO window must not be read until reset is deasserted.
++		 */
++		if (dma_state < 0)
++			drain_err = dma_state;
++		else if (!dma_state)
++			drain_err = readl_poll_timeout(legacy->gdma +
++				LEGACY_GDMA_CTRL0(LEGACY_RX_COPY_CHANNEL), value,
++				!(value & LEGACY_GDMA_BUSY), 10, 100000);
++	}
++	airoha_wlan_dbg(npu->dev, "npu", "event=stop_stage stage=gdma_reset");
+ 	dma_err = airoha_npu_assert_reset(legacy->gdma_reset);
+ 	if (!err)
+ 		err = drain_err ? drain_err : dma_err;
+@@ -1295,6 +1324,35 @@
+ 	return 0;
+ }
+ 
++static int airoha_npu_legacy_firmware_ready(struct airoha_npu *npu)
++{
++	const unsigned int limits[] = { NPU_EN7581_FIRMWARE_RV32_MAX_SIZE,
++					NPU_EN7581_FIRMWARE_DATA_MAX_SIZE };
++	const struct firmware *fw;
++	const char *names[2];
++	int i, err;
++
++	if (npu->wlan_abi != AIROHA_NPU_WLAN_ABI_HG5585F_2024)
++		return 0;
++	err = of_property_read_string_array(npu->dev->of_node, "firmware-name",
++					    names, ARRAY_SIZE(names));
++	if (err != ARRAY_SIZE(names))
++		return err < 0 ? err : -EINVAL;
++	for (i = 0; i < ARRAY_SIZE(names); i++) {
++		err = request_firmware_direct(&fw, names[i], npu->dev);
++		if (err)
++			return dev_err_probe(npu->dev,
++					     err == -ENOENT ? -EPROBE_DEFER : err,
++					     "waiting for NPU firmware %s\n", names[i]);
++		err = !fw->size ? -EINVAL : (fw->size > limits[i] ? -E2BIG : 0);
++		release_firmware(fw);
++		if (err)
++			return dev_err_probe(npu->dev, err,
++					     "invalid NPU firmware size: %s\n", names[i]);
++	}
++	return 0;
++}
++
+ static int airoha_npu_boot(struct airoha_npu *npu, void __iomem *base,
+ 			   struct resource *region)
+ {
+@@ -1304,14 +1362,16 @@
+ 	if (legacy) {
+ 		lockdep_assert_held(&legacy->lock);
+ 		legacy->state = LEGACY_RUNNING;
+-		err = reset_control_deassert(legacy->gdma_reset);
++		airoha_wlan_dbg(npu->dev, "npu", "event=boot_stage stage=gdma_deassert");
++		err = airoha_npu_deassert_reset(legacy->gdma_reset);
+ 		if (err)
+ 			return err;
+ 		/* Discard the verified RX copy channel's state before NPU boot. */
+ 		for (i = 0; i < 4; i++)
+ 			writel(0, legacy->gdma + (LEGACY_RX_COPY_CHANNEL << 4) + i * 4);
+ 		readl(legacy->gdma + LEGACY_GDMA_CTRL0(LEGACY_RX_COPY_CHANNEL));
+-		err = reset_control_deassert(legacy->npu_reset);
++		airoha_wlan_dbg(npu->dev, "npu", "event=boot_stage stage=npu_deassert");
++		err = airoha_npu_deassert_reset(legacy->npu_reset);
+ 		if (err)
+ 			return err;
+ 		for (i = 0; i < 2; i++) {
+@@ -1374,6 +1434,13 @@
+ 	err = airoha_npu_wlan_select_abi(npu);
+ 	if (err)
+ 		return err;
++	/* Probe may run before the root filesystem exposes the firmware.
++	 * Defer without resetting hardware or allocating DMA in that case.
++	 */
++	airoha_wlan_dbg(dev, "npu", "event=probe_stage stage=firmware_check");
++	err = airoha_npu_legacy_firmware_ready(npu);
++	if (err)
++		return err;
+ 	npu->ops.ppe_init = airoha_npu_ppe_init;
+ 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
+ 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
diff --git a/target/linux/airoha/patches-6.18/944-net-airoha-ppe-clear-stale-enable.patch b/target/linux/airoha/patches-6.18/944-net-airoha-ppe-clear-stale-enable.patch
new file mode 100644
index 0000000..28ddd55
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/944-net-airoha-ppe-clear-stale-enable.patch
@@ -0,0 +1,48 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: clear stale host-managed PPE enable
+
+The HG5585F boots with PPE enable bits set while its flow table is empty.
+Host-managed PPE takeover must clear that stale state before programming
+its tables; otherwise host_start returns -EBUSY and the MT7916 probe fails
+at npu_init. Preserve a genuinely busy PPE as an ownership conflict.
+
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -324,15 +324,32 @@
+ static int airoha_ppe_host_start(struct airoha_ppe *ppe)
+ {
+ 	struct airoha_eth *eth = ppe->eth;
+-	int i;
++	int i, err;
++	u32 val;
+ 
+ 	if (ppe->host_fault)
+ 		return -EIO;
+ 
+-	for (i = 0; i < eth->soc->num_ppe; i++)
+-		if (airoha_fe_rr(eth, REG_PPE_GLO_CFG(i)) &
+-		    (PPE_GLO_CFG_BUSY_MASK | PPE_GLO_CFG_EN_MASK))
++	/* HG5585F boots with PPE enable bits set while the tables are empty.
++	 * The host-managed ABI owns PPE, so clear stale enable state before
++	 * publishing the new table. A busy bit still means another owner is
++	 * using the engine and must fail without touching its state.
++	 */
++	for (i = 0; i < eth->soc->num_ppe; i++) {
++		val = airoha_fe_rr(eth, REG_PPE_GLO_CFG(i));
++		if (val & PPE_GLO_CFG_BUSY_MASK)
+ 			return -EBUSY;
++		if (!(val & PPE_GLO_CFG_EN_MASK))
++			continue;
++		airoha_fe_clear(eth, REG_PPE_GLO_CFG(i), PPE_GLO_CFG_EN_MASK);
++		err = read_poll_timeout(airoha_fe_rr, val,
++					!(val & (PPE_GLO_CFG_BUSY_MASK |
++						PPE_GLO_CFG_EN_MASK)),
++					USEC_PER_MSEC, 100 * USEC_PER_MSEC,
++					false, eth, REG_PPE_GLO_CFG(i));
++		if (err)
++			return err;
++	}
+ 
+ 	ppe->host_started = true;
+ 	airoha_ppe_host_config(ppe);
diff --git a/target/linux/airoha/patches-6.18/945-net-airoha-match-hg5585f-npu-input-ring.patch b/target/linux/airoha/patches-6.18/945-net-airoha-match-hg5585f-npu-input-ring.patch
new file mode 100644
index 0000000..55f6142
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/945-net-airoha-match-hg5585f-npu-input-ring.patch
@@ -0,0 +1,20 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: match the HG5585F NPU firmware input ring length
+
+The stock RV32 firmware advances input consumers through index 767 before
+wrapping. Initializing only 512 entries leaves its consumer outside the
+initialized ring, fills the Wi-Fi RX ring and blocks further association.
+Use 768 input descriptors; the 256-entry CPU return rings are unchanged.
+
+diff --git a/include/linux/soc/airoha/airoha_wlan_legacy.h b/include/linux/soc/airoha/airoha_wlan_legacy.h
+--- a/include/linux/soc/airoha/airoha_wlan_legacy.h
++++ b/include/linux/soc/airoha/airoha_wlan_legacy.h
+@@ -17,7 +17,7 @@
+ #define AIROHA_WLAN_LEGACY_RX_DESC_COUNT	256
+ #define AIROHA_WLAN_LEGACY_RX_BUF_BYTES	1725
+ #define AIROHA_WLAN_LEGACY_RX_MAX_FRAGS	7
+-#define AIROHA_WLAN_LEGACY_INPUT_COUNT	512
++#define AIROHA_WLAN_LEGACY_INPUT_COUNT	768
+ #define AIROHA_WLAN_LEGACY_PKT_COUNT	3000
+ #define AIROHA_WLAN_LEGACY_PKT_BYTES	2048
+ #define AIROHA_WLAN_LEGACY_BA_BYTES	0x80000
