+++ b/target/linux/airoha/an7581/base-files/etc/hotplug.d/net/50-fw4-bridge-reload
@@ -2,18 +2,35 @@
 
 [ "$ACTION" = "add" ] || exit 0
 
-case "${DEVICENAME}" in
+case "$DEVICENAME" in
 	phy*-ap*|ap-mld*) ;;
 	*) exit 0 ;;
 esac
 
-nft list flowtable bridge fw4 fb 2>/dev/null | grep -qw "\"${DEVICENAME}\"" && exit 0
-
+# A netdev add event precedes netifd attaching the AP to its bridge.
+# Each AP gets a worker so a later radio is not lost behind another lock.
 (
-	exec 9>/var/lock/fw4-bridge-reload.lock
+	exec 9>"/var/lock/fw4-bridge-reload.$DEVICENAME.lock"
 	flock -n 9 || exit 0
-	sleep 2
-	/etc/init.d/firewall reload >/dev/null 2>&1
-) &
+
+	for attempt in $(seq 1 30); do
+		sleep 2
+		[ -d "/sys/class/net/$DEVICENAME" ] || exit 0
+		[ -d "/sys/class/net/$DEVICENAME/brport" ] || continue
+		[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = 1 ] || exit 0
+
+		inet_table=$(nft list flowtable inet fw4 ft 2>/dev/null)
+		bridge_table=$(nft list flowtable bridge fw4 fb 2>/dev/null)
+		if printf '%s\n' "$inet_table" | grep -Fq "\"$DEVICENAME\"" &&
+		   printf '%s\n' "$bridge_table" | grep -Fq "\"$DEVICENAME\""; then
+			exit 0
+		fi
+
+		# fw4 serializes reloads; recheck on the next iteration, including
+		# failures while another interface or the firewall is starting.
+		/etc/init.d/firewall reload >/dev/null 2>&1
+	done
+	logger -t fw4 "AP $DEVICENAME missing from flowtables after bridge setup"
+) </dev/null >/dev/null 2>&1 &
 
 exit 0
diff --git a/target/linux/airoha/patches-6.18/946-net-airoha-ppe-flow-diagnostics.patch b/target/linux/airoha/patches-6.18/946-net-airoha-ppe-flow-diagnostics.patch
new file mode 100644
index 0000000..06325d7
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/946-net-airoha-ppe-flow-diagnostics.patch
@@ -0,0 +1,298 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: expose flow setup stages and hardware commit errors
+
+Expose read-only diagnostics for flowtable replace results, WDMA forward
+path resolution, and actual FOE commits. Software rule acceptance alone
+does not demonstrate hardware binding. Keep the existing forwarding and
+error handling behavior, with no additional hardware accesses.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
+--- a/drivers/net/ethernet/airoha/airoha_eth.h
++++ b/drivers/net/ethernet/airoha/airoha_eth.h
+@@ -726,6 +726,38 @@
+ #define AIROHA_RXD4_PPE_CPU_REASON	GENMASK(20, 16)
+ #define AIROHA_RXD4_FOE_ENTRY		GENMASK(15, 0)
+ 
++enum airoha_ppe_flow_stage {
++	AIROHA_FLOW_PARSE,
++	AIROHA_FLOW_ACTIONS,
++	AIROHA_FLOW_MAC,
++	AIROHA_FLOW_PREPARE,
++	AIROHA_FLOW_PORTS,
++	AIROHA_FLOW_MANGLE,
++	AIROHA_FLOW_TUPLE,
++	AIROHA_FLOW_ALLOCATE,
++	AIROHA_FLOW_COMMIT,
++	AIROHA_FLOW_INSERT,
++	AIROHA_FLOW_COMPLETE,
++	AIROHA_FLOW_STAGE_COUNT
++};
++
++/* Flow setup runs under flow_offload_mutex; hardware binds may run in NAPI. */
++struct airoha_ppe_flow_diag {
++	u64 replace_calls;
++	u64 replace_success;
++	u64 errors[AIROHA_FLOW_STAGE_COUNT];
++	int last_stage;
++	int last_error;
++	int last_action;
++	u16 last_addr_type;
++	char last_egress[IFNAMSIZ];
++	int wdma_error;
++	u16 wdma_idx, wdma_queue, wdma_bss, wdma_wcid, wdma_sta_id;
++	bool wdma_wed;
++	atomic64_t hw_commit_calls;
++	atomic64_t hw_commit_errors;
++};
++
+ struct airoha_ppe {
+ 	bool wed_enabled;
+ 	bool host_managed;
+@@ -747,6 +779,7 @@
+ 	dma_addr_t foe_stats_dma;
+ 
+ 	struct dentry *debugfs_dir;
++	struct airoha_ppe_flow_diag flow_diag;
+ };
+ 
+ struct airoha_eth_soc_data {
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -696,7 +696,18 @@
+ 	if (netdev) {
+ 		struct airoha_wdma_info info = {};
+ 
+-		if (!airoha_ppe_get_wdma_info(netdev, data->eth.h_dest, &info)) {
++		struct airoha_ppe_flow_diag *diag = &eth->ppe->flow_diag;
++		int wdma_err;
++
++		wdma_err = airoha_ppe_get_wdma_info(netdev, data->eth.h_dest, &info);
++		diag->wdma_error = wdma_err;
++		diag->wdma_wed = info.wed;
++		diag->wdma_idx = info.idx;
++		diag->wdma_queue = info.queue;
++		diag->wdma_bss = info.bss;
++		diag->wdma_wcid = info.wcid;
++		diag->wdma_sta_id = info.sta_id;
++		if (!wdma_err) {
+ 			if (info.wed) {
+ 				if (netdev->mtu != ETH_DATA_LEN)
+ 					return -EOPNOTSUPP;
+@@ -1160,6 +1171,7 @@
+ 	struct airoha_npu *npu;
+ 	int err = 0;
+ 
++	atomic64_inc(&ppe->flow_diag.hw_commit_calls);
+ 	memcpy(&hwe->d, &e->d, sizeof(*hwe) - sizeof(hwe->ib1));
+ 	wmb();
+ 
+@@ -1182,6 +1194,9 @@
+ 		err = airoha_ppe_foe_commit_sram_entry(ppe, hash);
+ unlock:
+ 	rcu_read_unlock();
++
++	if (err)
++		atomic64_inc(&ppe->flow_diag.hw_commit_errors);
+ 
+ 	return err;
+ }
+@@ -1592,9 +1607,10 @@
+ 	return airoha_ppe_get_entry_idle_time(ppe, e->data.ib1);
+ }
+ 
+-static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
+-					   struct flow_cls_offload *f)
+-{
++static int __airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
++					     struct flow_cls_offload *f)
++{
++	struct airoha_ppe_flow_diag *diag = &eth->ppe->flow_diag;
+ 	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+ 	struct airoha_flow_table_entry *e;
+ 	struct airoha_gdm_dev *egress_dev;
+@@ -1618,6 +1634,7 @@
+ 
+ 		flow_rule_match_control(rule, &match);
+ 		addr_type = match.key->addr_type;
++		diag->last_addr_type = addr_type;
+ 		if (flow_rule_has_control_flags(match.mask->flags,
+ 						f->common.extack))
+ 			return -EOPNOTSUPP;
+@@ -1664,7 +1681,9 @@
+ 		return -EOPNOTSUPP;
+ 	}
+ 
++	diag->last_stage = AIROHA_FLOW_ACTIONS;
+ 	flow_action_for_each(i, act, &rule->action) {
++		diag->last_action = act->id;
+ 		switch (act->id) {
+ 		case FLOW_ACTION_MANGLE:
+ 			if (offload_type == PPE_PKT_TYPE_BRIDGE)
+@@ -1702,10 +1721,14 @@
+ 		}
+ 	}
+ 
++	diag->last_stage = AIROHA_FLOW_MAC;
+ 	if (!is_valid_ether_addr(data.eth.h_source) ||
+ 	    !is_valid_ether_addr(data.eth.h_dest))
+ 		return -EINVAL;
+ 
++	diag->last_stage = AIROHA_FLOW_PREPARE;
++	if (odev)
++		strscpy(diag->last_egress, odev->name, sizeof(diag->last_egress));
+ 	err = airoha_ppe_foe_entry_prepare(eth, &hwe, odev, offload_type,
+ 					   &data, l4proto, dsfield,
+ 					   &egress_dev);
+@@ -1717,6 +1740,7 @@
+ 		return err;
+ 	}
+ 
++	diag->last_stage = AIROHA_FLOW_PORTS;
+ 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
+ 		struct flow_match_ports ports;
+ 
+@@ -1749,6 +1773,7 @@
+ 		airoha_ppe_foe_entry_set_ipv6_tuple(&hwe, &data);
+ 	}
+ 
++	diag->last_stage = AIROHA_FLOW_MANGLE;
+ 	flow_action_for_each(i, act, &rule->action) {
+ 		if (act->id != FLOW_ACTION_MANGLE)
+ 			continue;
+@@ -1756,6 +1781,7 @@
+ 		if (offload_type == PPE_PKT_TYPE_BRIDGE)
+ 			return -EOPNOTSUPP;
+ 
++		diag->last_action = act->mangle.htype;
+ 		switch (act->mangle.htype) {
+ 		case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+ 		case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+@@ -1775,12 +1801,14 @@
+ 			return err;
+ 	}
+ 
++	diag->last_stage = AIROHA_FLOW_TUPLE;
+ 	if (addr_type == FLOW_DISSECTOR_KEY_IPV4_ADDRS) {
+ 		err = airoha_ppe_foe_entry_set_ipv4_tuple(&hwe, &data, true);
+ 		if (err)
+ 			return err;
+ 	}
+ 
++	diag->last_stage = AIROHA_FLOW_ALLOCATE;
+ 	e = kzalloc(sizeof(*e), GFP_KERNEL);
+ 	if (!e)
+ 		return -ENOMEM;
+@@ -1792,10 +1820,12 @@
+ 	e->egress_dev = egress_dev;
+ 	memcpy(&e->data, &hwe, sizeof(e->data));
+ 
++	diag->last_stage = AIROHA_FLOW_COMMIT;
+ 	err = airoha_ppe_foe_flow_commit_entry(eth->ppe, e);
+ 	if (err)
+ 		goto free_entry;
+ 
++	diag->last_stage = AIROHA_FLOW_INSERT;
+ 	err = rhashtable_insert_fast(&eth->flow_table, &e->node,
+ 				     airoha_flow_table_params);
+ 	if (err < 0)
+@@ -1807,6 +1837,37 @@
+ 	airoha_ppe_foe_flow_remove_entry(eth->ppe, e);
+ free_entry:
+ 	kfree(e);
++
++	return err;
++}
++
++static int airoha_ppe_flow_offload_replace(struct airoha_eth *eth,
++					   struct flow_cls_offload *f)
++{
++	struct airoha_ppe_flow_diag *diag = &eth->ppe->flow_diag;
++	int err;
++
++	lockdep_assert_held(&flow_offload_mutex);
++	diag->replace_calls++;
++	diag->last_stage = AIROHA_FLOW_PARSE;
++	diag->last_action = -1;
++	diag->last_addr_type = 0;
++	diag->last_egress[0] = '\0';
++	diag->wdma_error = -ENODATA;
++	diag->wdma_wed = false;
++	diag->wdma_idx = 0;
++	diag->wdma_queue = 0;
++	diag->wdma_bss = 0;
++	diag->wdma_wcid = 0;
++	diag->wdma_sta_id = 0;
++	err = __airoha_ppe_flow_offload_replace(eth, f);
++	diag->last_error = err;
++	if (err) {
++		diag->errors[diag->last_stage]++;
++	} else {
++		diag->replace_success++;
++		diag->last_stage = AIROHA_FLOW_COMPLETE;
++	}
+ 
+ 	return err;
+ }
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+--- a/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe_debugfs.c
+@@ -222,6 +222,47 @@
+ }
+ DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_accounting);
+ 
++static int airoha_ppe_debugfs_flow_setup_show(struct seq_file *m, void *private)
++{
++	static const char * const stage_names[] = {
++		[AIROHA_FLOW_PARSE] = "parse",
++		[AIROHA_FLOW_ACTIONS] = "actions",
++		[AIROHA_FLOW_MAC] = "mac",
++		[AIROHA_FLOW_PREPARE] = "prepare",
++		[AIROHA_FLOW_PORTS] = "ports",
++		[AIROHA_FLOW_MANGLE] = "mangle",
++		[AIROHA_FLOW_TUPLE] = "tuple",
++		[AIROHA_FLOW_ALLOCATE] = "allocate",
++		[AIROHA_FLOW_COMMIT] = "commit",
++		[AIROHA_FLOW_INSERT] = "insert",
++		[AIROHA_FLOW_COMPLETE] = "complete",
++	};
++	struct airoha_ppe *ppe = m->private;
++	struct airoha_ppe_flow_diag *diag = &ppe->flow_diag;
++	unsigned int i;
++
++	mutex_lock(&flow_offload_mutex);
++	seq_printf(m, "replace_calls: %llu\nreplace_success: %llu\n",
++		   diag->replace_calls, diag->replace_success);
++	for (i = 0; i < AIROHA_FLOW_STAGE_COUNT; i++)
++		seq_printf(m, "reject_%s: %llu\n", stage_names[i], diag->errors[i]);
++	seq_printf(m, "last_stage: %s\nlast_error: %d\nlast_action: %d\n",
++		   stage_names[diag->last_stage], diag->last_error, diag->last_action);
++	seq_printf(m, "last_addr_type: %u\nlast_egress: %s\n",
++		   diag->last_addr_type, diag->last_egress);
++	seq_printf(m, "wdma_error: %d\nwdma_wed: %u\nwdma_idx: %u\n",
++		   diag->wdma_error, diag->wdma_wed, diag->wdma_idx);
++	seq_printf(m, "wdma_queue: %u\nwdma_bss: %u\nwdma_wcid: %u\nwdma_sta_id: %u\n",
++		   diag->wdma_queue, diag->wdma_bss, diag->wdma_wcid, diag->wdma_sta_id);
++	mutex_unlock(&flow_offload_mutex);
++	seq_printf(m, "hw_commit_calls: %lld\nhw_commit_errors: %lld\n",
++		   (long long)atomic64_read(&diag->hw_commit_calls),
++		   (long long)atomic64_read(&diag->hw_commit_errors));
++
++	return 0;
++}
++DEFINE_SHOW_ATTRIBUTE(airoha_ppe_debugfs_flow_setup);
++
+ static int airoha_ppe_debugfs_config_show(struct seq_file *m, void *private)
+ {
+ 	struct airoha_ppe *ppe = m->private;
+@@ -329,6 +370,8 @@
+ int airoha_ppe_debugfs_init(struct airoha_ppe *ppe)
+ {
+ 	ppe->debugfs_dir = debugfs_create_dir("ppe", NULL);
++	debugfs_create_file("flow_setup", 0400, ppe->debugfs_dir, ppe,
++			    &airoha_ppe_debugfs_flow_setup_fops);
+ 	if (ppe->host_managed)
+ 		debugfs_create_file("accounting", 0444, ppe->debugfs_dir, ppe,
+ 				    &airoha_ppe_debugfs_accounting_fops);
diff --git a/target/linux/airoha/patches-6.18/947-net-airoha-wed-allow-multiple-flow-blocks.patch b/target/linux/airoha/patches-6.18/947-net-airoha-wed-allow-multiple-flow-blocks.patch
new file mode 100644
index 0000000..f8f1caf
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/947-net-airoha-wed-allow-multiple-flow-blocks.patch
@@ -0,0 +1,65 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: let WED AP ports bind multiple flowtables
+
+flow_block_cb_setup_simple() rejects a second block for the same AP
+netdev with EBUSY. This prevents inet and bridge flowtables sharing a
+Wi-Fi port, and prevents atomic replacement during firewall reload.
+Use the same per-block lookup and reference handling as airoha Ethernet.
+Keep the netdev as callback identity and the WED device as private data.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -578,12 +578,47 @@
+ 			       enum tc_setup_type type, void *data)
+ {
+ 	static LIST_HEAD(blocks);
++	struct flow_block_offload *f = data;
++	struct flow_block_cb *block_cb;
+ 
+ 	if (type != TC_SETUP_BLOCK && type != TC_SETUP_FT)
+ 		return -EOPNOTSUPP;
+-
+-	return flow_block_cb_setup_simple(data, &blocks, airoha_wed_setup_cb,
+-					 dev, wed, true);
++	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
++		return -EOPNOTSUPP;
++
++	/* Like the Ethernet provider, allow a netdev in both inet and bridge
++	 * flowtables. A global per-device busy check also rejects reloads
++	 * while the previous block is still waiting to be unbound.
++	 */
++	f->driver_block_list = &blocks;
++	switch (f->command) {
++	case FLOW_BLOCK_BIND:
++		block_cb = flow_block_cb_lookup(f->block, airoha_wed_setup_cb, dev);
++		if (block_cb) {
++			flow_block_cb_incref(block_cb);
++			return 0;
++		}
++		block_cb = flow_block_cb_alloc(airoha_wed_setup_cb, dev, wed, NULL);
++		if (IS_ERR(block_cb))
++			return PTR_ERR(block_cb);
++
++		flow_block_cb_incref(block_cb);
++		flow_block_cb_add(block_cb, f);
++		list_add_tail(&block_cb->driver_list, &blocks);
++		return 0;
++	case FLOW_BLOCK_UNBIND:
++		block_cb = flow_block_cb_lookup(f->block, airoha_wed_setup_cb, dev);
++		if (!block_cb)
++			return -ENOENT;
++
++		if (!flow_block_cb_decref(block_cb)) {
++			flow_block_cb_remove(block_cb, f);
++			list_del(&block_cb->driver_list);
++		}
++		return 0;
++	default:
++		return -EOPNOTSUPP;
++	}
+ }
+ 
+ static void airoha_wed_ppe_check(struct mtk_wed_device *wed, struct sk_buff *skb,
diff --git a/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch b/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch
new file mode 100644
index 0000000..182cb66
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch
@@ -0,0 +1,29 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] netfilter: flowtable: use the IEEE80211 endpoint for bridge paths
+
+Route path discovery opts into DEV_PATH_IEEE80211, allowing mac80211 to
+return a regular netdev endpoint to Netfilter. Bridge discovery left the
+context flag clear and obtained the driver-specific Airoha WDMA path.
+The generic path parser rejects that path before any flow replace reaches
+PPE. Request the same IEEE80211 endpoint for bridge discovery. The PPE
+continues to discover WDMA details separately when preparing its egress.
+
+On HG5585F with an associated MT7916 client, dev_fill_bridge_path() returns
+DEV_PATH_AIROHA_WDMA without this flag and DEV_PATH_IEEE80211 with it.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/net/netfilter/nf_flow_table_path.c b/net/netfilter/nf_flow_table_path.c
+--- a/net/netfilter/nf_flow_table_path.c
++++ b/net/netfilter/nf_flow_table_path.c
+@@ -340,7 +340,9 @@
+ 				    unsigned char *dst_ha)
+ {
+ 	struct flow_offload_tuple_rhash *th = flow->tuplehash;
+-	struct net_device_path_ctx ctx = {};
++	struct net_device_path_ctx ctx = {
++		.ieee80211 = true,
++	};
+ 	struct net_device_path_stack stack;
+ 	struct nft_forward_info info = {};
+ 	int i, j = 0;
