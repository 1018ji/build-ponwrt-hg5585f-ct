From: PonWrt developers <noreply@localhost>
Subject: [PATCH] HG5585F: batch RX, initialize WED flow control and count queues

Add transient stats-on/stats-off commands without enabling firmware logs.
Snapshot CPU/thread counters and the shared offload statistics once for
both PHYs. Keep the existing recipe prefix for incremental builds.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/files/usr/sbin/hg5585f-wifi-diag b/files/usr/sbin/hg5585f-wifi-diag
--- a/files/usr/sbin/hg5585f-wifi-diag
+++ b/files/usr/sbin/hg5585f-wifi-diag
@@ -4,6 +4,25 @@
 umask 077
 
 parameter=/sys/module/airoha_npu/parameters/wlan_debug
+
+stats_runtime() {
+	for path in /sys/kernel/debug/ieee80211/phy*/mt76/offload_stats; do
+		[ -r "$path" ] || continue
+		awk '$1 == "enabled:" { print $2; found = 1; exit }
+		     END { if (!found) print "unavailable" }' "$path"
+		return
+	done
+	echo unavailable
+}
+
+apply_stats() {
+	for path in /sys/kernel/debug/ieee80211/phy*/mt76/offload_stats; do
+		[ -w "$path" ] || continue
+		printf '%s\n' "$1" > "$path" || return 1
+		# Both PHYs share the same counters and switch.
+		break
+	done
+}
 
 fw_log_paths() {
 	for path in /sys/kernel/debug/ieee80211/phy*/mt76/fw_debug_wa \
@@ -50,7 +69,23 @@
 	for path in $(fw_log_paths); do
 		printf '%s\n' "$1" > "$path" || return 1
 	done
+	apply_stats "$1"
 	logger -t hg5585f-wifi "component=diag event=debug enabled=$1" || true
+}
+
+thread_stats() {
+	for entry in /proc/[0-9]*/comm; do
+		read -r name < "$entry" 2>/dev/null || continue
+		case "$name" in
+			napi/*|mt76*|ksoftirqd/*)
+				pid=${entry#/proc/}
+				pid=${pid%/comm}
+				cat "/proc/$pid/stat" 2>/dev/null || continue
+				taskset -p "$pid" 2>/dev/null || true
+				sed -n '/se.nr_migrations /p; /nr_switches /p' "/proc/$pid/sched" 2>/dev/null || true
+				;;
+		esac
+	done
 }
 
 capture() {
@@ -66,8 +101,10 @@
 		"$(configured)" "$(runtime)" "$(fw_log_runtime wa)" "$(fw_log_runtime wm)"
 	capture kernel uname -a
 	capture uptime cat /proc/uptime
+	capture cpu cat /proc/stat
 	capture interrupts cat /proc/interrupts
 	capture softirqs cat /proc/softirqs
+	capture mt76_threads thread_stats
 	capture deferred_devices cat /sys/kernel/debug/devices_deferred
 	capture pci lspci -nnk
 	capture radios iw dev
@@ -93,6 +130,11 @@
 		# Both PHYs share the same counters and device instance.
 		break
 	done
+	for path in /sys/kernel/debug/ieee80211/phy*/mt76/offload_stats; do
+		[ -r "$path" ] || continue
+		capture "$path" cat "$path"
+		break
+	done
 	for path in /sys/kernel/debug/airoha-wed /sys/kernel/debug/ppe/config /sys/kernel/debug/ppe/accounting; do
 		[ ! -r "$path" ] || capture "$path" cat "$path"
 	done
@@ -109,7 +151,7 @@
 }
 
 usage() {
-	echo "Usage: $0 {on|off|status|snapshot|collect [seconds:1-60]}" >&2
+	echo "Usage: $0 {on|off|stats-on|stats-off|status|snapshot|collect [seconds:1-60]}" >&2
 	exit 2
 }
 
@@ -129,13 +171,24 @@
 		[ "$#" -eq 1 ] || usage
 		apply_runtime "$(configured)"
 		;;
+	stats-on|stats-off)
+		[ "$#" -eq 1 ] || usage
+		[ "$(stats_runtime)" != unavailable ] || {
+			echo 'Offload statistics are unavailable' >&2
+			exit 1
+		}
+		enabled=0
+		[ "$command" != stats-on ] || enabled=1
+		apply_stats "$enabled"
+		printf 'hg5585f-wifi: component=diag event=stats enabled=%s persistent=0\n' "$enabled"
+		;;
 	runtime-off)
 		[ "$#" -eq 1 ] || usage
 		apply_runtime 0
 		;;
 	status)
 		[ "$#" -le 1 ] || usage
-		printf 'hg5585f-wifi: component=diag event=status configured=%s runtime=%s\n' "$(configured)" "$(runtime)"
+		printf 'hg5585f-wifi: component=diag event=status configured=%s runtime=%s stats=%s\n' "$(configured)" "$(runtime)" "$(stats_runtime)"
 		;;
 	snapshot)
 		[ "$#" -eq 1 ] || usage
diff --git a/package/kernel/mt76/Makefile b/package/kernel/mt76/Makefile
--- a/package/kernel/mt76/Makefile
+++ b/package/kernel/mt76/Makefile
@@ -1,7 +1,7 @@
