+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt76: supply owned TX-free views to Airoha diagnostics
+
+Record a bounded notification summary before the host parser releases
+tokens. Publish borrowed TX-free descriptor geometry for first-error
+snapshots; consumer teardown stops IRQs/NAPI before descriptors retire.
+Do not transfer descriptor ownership to the provider.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/mt7915/mac.c b/mt7915/mac.c
+--- a/mt7915/mac.c
++++ b/mt7915/mac.c
+@@ -3,6 +3,7 @@
+ 
+ #include <linux/etherdevice.h>
+ #include <linux/timekeeping.h>
++#include <linux/soc/airoha/airoha_wed_diag.h>
+ #include "coredump.h"
+ #include "mt7915.h"
+ #include "../dma.h"
+@@ -894,6 +895,10 @@
+ 	u32 txd = le32_to_cpu(free->txd);
+ 	__le32 *cur_info;
+ 
++	if (mt76_wed_is_airoha(mdev))
++		airoha_wed_diag_txfree(&mdev->mmio.wed, data, len, false,
++				       mdev->token_start, mdev->token_size);
++
+ 	mt7915_mac_tx_free_prepare(dev);
+ 
+ 	total = le16_get_bits(free->ctrl, MT_TX_FREE_MSDU_CNT);
+@@ -977,6 +982,10 @@
+ 	LIST_HEAD(free_list);
+ 	bool wake = false;
+ 	u8 i, count;
++
++	if (mt76_wed_is_airoha(mdev))
++		airoha_wed_diag_txfree(&mdev->mmio.wed, data, len, true,
++				       mdev->token_start, mdev->token_size);
+ 
+ 	mt7915_mac_tx_free_prepare(dev);
+ 
+diff --git a/wed.c b/wed.c
+--- a/wed.c
++++ b/wed.c
+@@ -145,8 +145,16 @@
+ 		mt76_dma_rx_fill(dev, q, false);
+ 
+ 		ret = mtk_wed_device_txfree_ring_setup(q->wed, q->regs);
+-		if (!ret)
++		if (!ret) {
+ 			q->wed_regs = q->wed->txfree_ring.reg_base;
++			if (mt76_wed_is_airoha(dev)) {
++				/* Borrowed until consumer IRQ/NAPI teardown, never freed by WED. */
++				q->wed->txfree_ring.desc = (void *)q->desc;
++				q->wed->txfree_ring.desc_phys = q->desc_dma;
++				q->wed->txfree_ring.size = q->ndesc;
++				q->wed->txfree_ring.desc_size = sizeof(*q->desc);
++			}
++		}
+ 		break;
+ 	case MT76_WED_Q_RX:
+ 		ret = mtk_wed_device_rx_ring_setup(q->wed, ring, q->regs,
