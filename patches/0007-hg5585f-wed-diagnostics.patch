++		record->raw[i] = get_unaligned_le32(bytes + i * 4);
++	if (!v0 && record->version > 4) {
++		record->unsupported = true;
++		return;
++	}
++	available = min_t(unsigned int, len, AIROHA_WED_DIAG_WORDS * 4);
++	for (offset = 8; record->decoded < record->advertised;) {
++		u32 info;
++		unsigned int width = v0 ? 2 : 4;
++		unsigned int tokens = !v0 && record->version == 4 ? 2 : 1;
++
++		if (offset + width > available) {
++			record->truncated = available < len;
++			record->malformed = !record->truncated;
++			break;
++		}
++		info = v0 ? get_unaligned_le16(bytes + offset) :
++			    get_unaligned_le32(bytes + offset);
++		offset += width;
++		if (!v0 && (info & BIT(31))) {
++			record->station_words++;
++			continue;
++		}
++		if (!v0 && record->version == 4 && (info & BIT(30))) {
++			record->mpdu_words++;
++			continue;
++		}
++		for (i = 0; i < tokens; i++) {
++			u32 token = v0 ? info : record->version == 4 ?
++				    (info >> (15 * i)) & 0x7fff : (info >> 16) & 0x7fff;
++
++			if (!v0 && record->version == 4 && token == 0x7fff)
++				continue;
++			record->decoded++;
++			if (record->saved_tokens < AIROHA_WED_DIAG_TOKENS)
++				record->token[record->saved_tokens++] = token;
++			if (token >= cpu_start && token - cpu_start < cpu_count)
++				record->cpu_tokens++;
++			else if (token >= wed_start && token - wed_start < wed_count)
++				record->wed_tokens++;
++			else
++				record->unexpected++;
++		}
++	}
++	if (record->decoded != record->advertised && !record->truncated)
++		record->malformed = true;
++}
