+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: fix WED GDM port index and probe cleanup
+
+GDM ports are stored at id - 1. Checking slot 3 as GDM3 instead
+inspects the HG5585F GDM4 LAN1 device and falsely rejects WED with
+EBUSY. Keep managed device link removal with the driver core and
+report the exact failure stage even when verbose diagnostics are off.
+
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
+index 576259f6aad5ecd0b7637f6882bc8b5aca88747e..f7a48321a0d9b99aba36e626429f206659f32a58 100644
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -394,14 +394,21 @@ static int airoha_ppe_set_wed(struct airoha_ppe_dev *dev, bool enable)
+ {
+ 	struct airoha_ppe *ppe = dev->priv;
+ 	struct airoha_eth *eth = ppe->eth;
++	struct airoha_gdm_port *port;
+ 	int err = 0, i;
+ 
+ 	mutex_lock(&flow_offload_mutex);
+-	/* WED uses GDM3; GDM2 is the independent PON MAC. */
+-	if (enable && eth->ports[AIROHA_GDM3_IDX]) {
+-		for (i = 0; i < ARRAY_SIZE(eth->ports[AIROHA_GDM3_IDX]->devs); i++) {
+-			if (!eth->ports[AIROHA_GDM3_IDX]->devs[i])
++	/* Hardware GDM IDs start at 1; airoha_alloc_gdm_port() stores id - 1.
++	 * GDM4 is the HG5585F LAN1 port and does not conflict with WED GDM3.
++	 */
++	port = eth->ports[AIROHA_GDM3_IDX - 1];
++	if (enable && port) {
++		for (i = 0; i < ARRAY_SIZE(port->devs); i++) {
++			if (!port->devs[i])
+ 				continue;
++			dev_err(eth->dev,
++				"hg5585f-wifi: component=ppe event=wed_port_busy port=%d nbq=%d\n",
++				port->id, port->devs[i]->nbq);
+ 			err = -EBUSY;
+ 			goto out;
+ 		}
