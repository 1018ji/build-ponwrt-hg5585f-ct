diff --git a/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch b/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch
new file mode 100644
index 0000000000000000000000000000000000000000..a1d0c87aa18e204567e8fdf71f190757d6ef8d2d
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch
@@ -0,0 +1,228 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: trace WED attach stages, guard IRQ storms, default diagnostics on
+
+HG5585F mt7915e probe stalls after "enabling device" and CPU0 is
+starved in softirq. Log WED attach stages and raw WED status through
+airoha_wlan_dbg(), and default that switch on so the log exists while
+probing. Count interrupts at the WED irq_set_mask(0) entry called first
+by the mt7915 hard IRQ handler; past 20000 per second mask the WED
+sources and disable the line once with disable_irq_nosync(), reporting
+an error record. DMA ownership state (poisoned) is left untouched.
+
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -1,9 +1,12 @@
+ // SPDX-License-Identifier: GPL-2.0-only
+ /* EN7581 WED1/WDMA1 transmit provider for MT7916D. */
++#include <linux/atomic.h>
+ #include <linux/bitfield.h>
+ #include <linux/dma-mapping.h>
+ #include <linux/debugfs.h>
++#include <linux/interrupt.h>
+ #include <linux/iopoll.h>
++#include <linux/jiffies.h>
+ #include <linux/module.h>
+ #include <linux/of_address.h>
+ #include <linux/of_platform.h>
+@@ -68,6 +71,9 @@
+ 	const char *last_attach_stage;
+ 	int last_attach_error;
+ 	u32 last_wdma_cfg;
++	atomic_t irq_count;
++	unsigned long irq_window;
++	atomic_t irq_storm;
+ };
+ 
+ static struct airoha_wed *airoha_wed1;
+@@ -225,9 +231,44 @@
+ 	return 0;
+ }
+ 
++#define AIROHA_WED_IRQ_STORM_LIMIT	20000
++
++/* Called from the mt7915 hard IRQ handler with mask 0 on every interrupt. */
++static void airoha_wed_irq_storm_check(struct airoha_wed *aw)
++{
++	unsigned long now = jiffies, window = READ_ONCE(aw->irq_window);
++	u32 raw, ext;
++
++	if (atomic_read(&aw->irq_storm))
++		return;
++	if (time_after(now, window + HZ) &&
++	    cmpxchg(&aw->irq_window, window, now) == window)
++		atomic_set(&aw->irq_count, 0);
++	if (atomic_inc_return(&aw->irq_count) <= AIROHA_WED_IRQ_STORM_LIMIT ||
++	    atomic_cmpxchg(&aw->irq_storm, 0, 1))
++		return;
++	/* Hard IRQ context: only the _nosync variant is safe here. */
++	raw = readl(aw->base + MTK_WED_INT_STATUS);
++	ext = readl(aw->base + MTK_WED_EXT_INT_STATUS);
++	writel(0, aw->base + MTK_WED_INT_MASK);
++	writel(0, aw->base + MTK_WED_EXT_INT_MASK);
++	/* irq_storm was won above, so this runs once. quarantine/detach test
++	 * irq_disabled under airoha_wed_lock and must not disable it again.
++	 */
++	WRITE_ONCE(aw->irq_disabled, true);
++	disable_irq_nosync(aw->irq);
++	dev_err(aw->dev,
++		"hg5585f-wifi: component=wed event=irq_storm count=%d raw=%08x ext=%08x; WED irq %d disabled\n",
++		atomic_read(&aw->irq_count), raw, ext, aw->irq);
++}
++
+ static void airoha_wed_irq_mask(struct mtk_wed_device *wed, u32 mask)
+ {
+-	if (airoha_wed_priv(wed)->poisoned)
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++
++	if (!mask)
++		airoha_wed_irq_storm_check(aw);
++	if (aw->poisoned || atomic_read(&aw->irq_storm))
+ 		mask = 0;
+ 	airoha_wed_write(wed, MTK_WED_INT_MASK, mask);
+ 	airoha_wed_read(wed, MTK_WED_INT_MASK);
+@@ -235,9 +276,15 @@
+ 
+ static u32 airoha_wed_irq_get(struct mtk_wed_device *wed, u32 mask)
+ {
+-	u32 status = airoha_wed_read(wed, MTK_WED_INT_STATUS) & mask;
+-	u32 errors = airoha_wed_read(wed, MTK_WED_EXT_INT_STATUS) & EN7581_WED_EXT_ERRORS;
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	u32 raw = airoha_wed_read(wed, MTK_WED_INT_STATUS);
++	u32 ext = airoha_wed_read(wed, MTK_WED_EXT_INT_STATUS);
++	u32 status = raw & mask;
++	u32 errors = ext & EN7581_WED_EXT_ERRORS;
+ 
++	/* Which status bits keep asserting; rate limited by the dbg macro. */
++	airoha_wlan_dbg(aw->dev, "wed", "event=irq raw=%08x mask=%08x ext=%08x",
++			raw, mask, ext);
+ 	if (status)
+ 		airoha_wed_write(wed, MTK_WED_INT_STATUS, status);
+ 	if (errors) {
+@@ -315,9 +362,9 @@
+ quarantine:
+ 	wed->dma_quarantined = true;
+ 	aw->poisoned = true;
+-	if (!aw->irq_disabled) {
++	if (!READ_ONCE(aw->irq_disabled)) {
++		WRITE_ONCE(aw->irq_disabled, true);
+ 		disable_irq(aw->irq);
+-		aw->irq_disabled = true;
+ 	}
+ 	return err;
+ }
+@@ -570,20 +617,24 @@
+ 		goto out;
+ 	if (aw->wlan || aw->poisoned) {
+ 		stage = "ownership";
++		airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=ownership");
+ 		err = -EBUSY;
+ 		goto out;
+ 	}
+ 	stage = "pcie";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=pcie");
+ 	if (pci_domain_nr(pci->bus) != 1 ||
+ 	    upper_32_bits(pci_resource_start(pci, 0)))
+ 		goto out;
+ 	stage = "npu_supplier";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=npu_supplier");
+ 	npu = airoha_npu_get(&pci->dev);
+ 	if (IS_ERR(npu)) {
+ 		err = PTR_ERR(npu);
+ 		goto out;
+ 	}
+ 	stage = "firmware_abi";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=firmware_abi");
+ 	legacy = npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024;
+ 	if (legacy) {
+ 		/* Firmware names were checked by the supplier. PPE must be host-managed. */
+@@ -600,6 +651,7 @@
+ 	if (err)
+ 		goto out;
+ 	stage = "ppe_supplier";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=ppe_supplier");
+ 	aw->ppe = airoha_ppe_get_dev(&pci->dev);
+ 	if (IS_ERR(aw->ppe)) {
+ 		err = PTR_ERR(aw->ppe);
+@@ -608,6 +660,7 @@
+ 	}
+ 	if (legacy) {
+ 		stage = "ppe_prepare";
++		airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=ppe_prepare");
+ 		err = aw->ppe->ops.prepare_legacy(aw->ppe);
+ 		if (err) {
+ 			airoha_ppe_put_dev(aw->ppe);
+@@ -616,6 +669,7 @@
+ 		}
+ 	}
+ 	stage = "device_link";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=device_link");
+ 	link = device_link_add(&pci->dev, aw->dev, DL_FLAG_AUTOREMOVE_CONSUMER);
+ 	if (!link) {
+ 		airoha_ppe_put_dev(aw->ppe);
+@@ -624,6 +678,7 @@
+ 		goto out;
+ 	}
+ 	stage = "wdma_busy";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=wdma_busy");
+ 	wdma_cfg = readl(aw->wdma + MTK_WDMA_GLO_CFG);
+ 	if (wdma_cfg & (MTK_WDMA_GLO_CFG_TX_DMA_EN |
+ 			MTK_WDMA_GLO_CFG_TX_DMA_BUSY)) {
+@@ -639,25 +694,30 @@
+ 	wed->version = 1;
+ 	wed->airoha = true;
+ 	stage = "quiesce";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=quiesce");
+ 	err = airoha_wed_quiesce(wed);
+ 	if (err)
+ 		goto error;
+ 	stage = "reset";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=reset");
+ 	err = airoha_wed_reset(wed, MTK_WED_RESET_WED);
+ 	if (err)
+ 		goto error;
+ 	stage = "buffers";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=buffers");
+ 	err = airoha_wed_buffers_alloc(wed);
+ 	if (err)
+ 		goto error;
+ 	aw->tokens_reserved = true;
+ 	stage = "tokens";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=tokens");
+ 	err = wed->wlan.offload_enable(wed);
+ 	if (err) {
+ 		err = -ETIMEDOUT;
+ 		goto error;
+ 	}
+ 	stage = "ppe_enable";
++	airoha_wlan_dbg(&pci->dev, "wed", "event=stage stage=ppe_enable");
+ 	err = aw->ppe->ops.set_wed(aw->ppe, true);
+ 	if (err)
+ 		goto error;
+@@ -716,9 +776,9 @@
+ 		}
+ 	} else {
+ 		aw->poisoned = true;
+-		if (!aw->irq_disabled) {
++		if (!READ_ONCE(aw->irq_disabled)) {
++			WRITE_ONCE(aw->irq_disabled, true);
+ 			disable_irq(aw->irq);
+-			aw->irq_disabled = true;
+ 		}
+ 	}
+ 	airoha_ppe_put_dev(aw->ppe);
+diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
+--- a/drivers/net/ethernet/airoha/airoha_npu.c
++++ b/drivers/net/ethernet/airoha/airoha_npu.c
+@@ -19,9 +19,9 @@
+ #include "airoha_eth.h"
+ #include <linux/soc/airoha/airoha_wlan_legacy.h>
+ 
+-static bool wlan_debug;
++static bool wlan_debug = true;
+ module_param(wlan_debug, bool, 0644);
+-MODULE_PARM_DESC(wlan_debug, "HG5585F wireless lifecycle diagnostics (default off)");
++MODULE_PARM_DESC(wlan_debug, "HG5585F wireless lifecycle diagnostics (default on)");
+ 
+ bool airoha_wlan_debug_enabled(void)
+ {
