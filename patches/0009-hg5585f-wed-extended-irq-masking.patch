index 0000000000000000000000000000000000000000..6e1990feca4360080e11e74b0bddc9bc70657884
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/941-net-airoha-mask-wed-extended-interrupts.patch
@@ -0,0 +1,35 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: mask extended WED interrupts with normal IRQs
+
+An extended error such as RX_DRV_INIT_WDMA_EN can keep the shared WED
+interrupt asserted when the hard IRQ handler masks only INT_MASK. Mask
+EXT_INT_MASK at the same time, and restore both sources after the tasklet
+has acknowledged the pending status. Keep the existing storm guard and
+avoid enabling extended sources before DMA startup reaches irq_mask().
+
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+index 6a1bf83e732b667f05e8be848f53833ed8bd3755..4b8026061100978894b1d5eed3cefd5714640d00 100644
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -270,6 +270,12 @@ static void airoha_wed_irq_mask(struct mtk_wed_device *wed, u32 mask)
+ 		airoha_wed_irq_storm_check(aw);
+ 	if (aw->poisoned || atomic_read(&aw->irq_storm))
+ 		mask = 0;
++	/* An extended error asserts the same IRQ even if INT_MASK is zero.
++	 * Keep both sources masked until the tasklet acknowledges the status.
++	 */
++	airoha_wed_write(wed, MTK_WED_EXT_INT_MASK,
++			 mask ? EN7581_WED_EXT_ERRORS : 0);
++	airoha_wed_read(wed, MTK_WED_EXT_INT_MASK);
+ 	airoha_wed_write(wed, MTK_WED_INT_MASK, mask);
+ 	airoha_wed_read(wed, MTK_WED_INT_MASK);
+ }
+@@ -511,7 +517,7 @@ static void airoha_wed_start(struct mtk_wed_device *wed, u32 mask)
+ 	writel(GENMASK(17, 16), aw->wdma + MTK_WDMA_INT_MASK);
+ 	writel(GENMASK(17, 16), aw->wdma + MTK_WDMA_INT_GRP2);
+ 	airoha_wed_write(wed, MTK_WED_WPDMA_INT_MASK, mask);
+-	airoha_wed_write(wed, MTK_WED_EXT_INT_MASK, EN7581_WED_EXT_ERRORS);
++	/* airoha_wed_irq_mask() enables both IRQ sources after DMA setup. */
+ 	dma_wmb();
+ 	airoha_wed_rmw(wed, MTK_WED_WPDMA_GLO_CFG, 0, EN7581_WED_DMA_ENABLE);
+ 	airoha_wed_rmw(wed, MTK_WED_WDMA_GLO_CFG, 0, BIT(2));
