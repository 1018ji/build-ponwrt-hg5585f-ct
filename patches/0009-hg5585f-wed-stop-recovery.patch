From: PonWrt developers <noreply@localhost>
Subject: [PATCH] net: airoha: stop WED producers before waiting for DMA idle

Fix stop ordering and revalidate all DMA engines after WED reset. Retain
terminal DMA ownership protection and record the failing stop stage.
Include fault-injection tests and separate mt7915 WED/NPU diagnostics.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/target/linux/airoha/patches-6.18/952-net-airoha-wed-stop-recovery.patch b/target/linux/airoha/patches-6.18/952-net-airoha-wed-stop-recovery.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/952-net-airoha-wed-stop-recovery.patch
@@ -0,0 +1,160 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: stop producers before polling WED DMA idle
+
+Disable WDMA RX and both WED DMA drivers before polling idle. Retry all
+four idle checks after the existing bounded WED reset; never reset RX
+indices while an external DMA engine may still be active. Keep terminal
+quarantine on failed reset, busy status, PPE flush failure or prior fault.
+Expose stop stages, error codes and reset attempt/result counters.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -89,6 +89,12 @@
+ 	struct work_struct irq_fault_work;
+ 	/* Serialize consumer teardown with deferred fault draining. */
+ 	struct mutex quiesce_lock;
++	const char *last_stop_stage;
++	int last_stop_error;
++	int last_dma_stop_error;
++	int last_flush_error;
++	u32 stop_reset_attempts;
++	u32 stop_reset_successes;
+ };
+ 
+ static struct airoha_wed *airoha_wed1;
+@@ -695,11 +701,11 @@
+ 				 10, 100000);
+ }
+ 
+-static int airoha_wed_quiesce(struct mtk_wed_device *wed)
++/* Disable every producer before polling a consumer that it can keep busy. */
++static void airoha_wed_disable_dma(struct mtk_wed_device *wed)
+ {
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	u32 val;
+-	int err;
+ 
+ 	airoha_wed_irq_mask(wed, 0);
+ 	airoha_wed_write(wed, MTK_WED_EXT_INT_MASK, 0);
+@@ -707,27 +713,76 @@
+ 	writel(0, aw->wdma + MTK_WDMA_INT_GRP2);
+ 	val = readl(aw->wdma + MTK_WDMA_GLO_CFG);
+ 	writel(val & ~MTK_WDMA_GLO_CFG_RX_DMA_EN, aw->wdma + MTK_WDMA_GLO_CFG);
+-	err = airoha_wdma_rx_idle(aw);
+ 	airoha_wed_rmw(wed, MTK_WED_GLO_CFG, EN7581_WED_DMA_ENABLE, 0);
+ 	airoha_wed_rmw(wed, MTK_WED_WPDMA_GLO_CFG, EN7581_WED_DMA_ENABLE, 0);
+ 	airoha_wed_rmw(wed, MTK_WED_WDMA_GLO_CFG, BIT(2), 0);
+-	if (airoha_wed_poll(aw, MTK_WED_GLO_CFG, EN7581_WED_DMA_BUSY) ||
+-	    airoha_wed_poll(aw, MTK_WED_WPDMA_GLO_CFG, EN7581_WED_DMA_BUSY) ||
+-	    airoha_wed_poll(aw, MTK_WED_WDMA_GLO_CFG, BIT(3)))
+-		err = -ETIMEDOUT;
++	/* Complete posted disable writes before reading any busy status. */
++	airoha_wed_read(wed, MTK_WED_WDMA_GLO_CFG);
++}
++
++static int airoha_wed_dma_idle(struct mtk_wed_device *wed)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	int err;
++
++	aw->last_stop_stage = "wdma_rx";
++	err = airoha_wdma_rx_idle(aw);
++	if (err)
++		return err;
++	aw->last_stop_stage = "wed_dma";
++	err = airoha_wed_poll(aw, MTK_WED_GLO_CFG, EN7581_WED_DMA_BUSY);
++	if (err)
++		return err;
++	aw->last_stop_stage = "wpdma_drv";
++	err = airoha_wed_poll(aw, MTK_WED_WPDMA_GLO_CFG, EN7581_WED_DMA_BUSY);
++	if (err)
++		return err;
++	aw->last_stop_stage = "wdma_drv";
++	err = airoha_wed_poll(aw, MTK_WED_WDMA_GLO_CFG, BIT(3));
++	if (!err)
++		aw->last_stop_stage = "idle";
++	return err;
++}
++
++static int airoha_wed_quiesce(struct mtk_wed_device *wed)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
++	int err;
++
++	airoha_wed_disable_dma(wed);
++	err = airoha_wed_dma_idle(wed);
+ 	if (err) {
+-		/* Hardware reset is the fallback; never treat a busy timeout as idle. */
++		dev_warn(aw->dev,
++			 "hg5585f-wifi: component=wed event=stop_retry stage=%s error=%d wdma=%08x wed=%08x wpdma=%08x drv=%08x\n",
++			 aw->last_stop_stage, err,
++			 readl(aw->wdma + MTK_WDMA_GLO_CFG),
++			 airoha_wed_read(wed, MTK_WED_GLO_CFG),
++			 airoha_wed_read(wed, MTK_WED_WPDMA_GLO_CFG),
++			 airoha_wed_read(wed, MTK_WED_WDMA_GLO_CFG));
++		aw->stop_reset_attempts++;
++		aw->last_stop_stage = "wed_reset";
+ 		err = airoha_wed_reset(wed, MTK_WED_RESET_WED);
+ 		wed->init_done = false;
+-		if (!err)
+-			err = airoha_wdma_rx_idle(aw);
++		if (!err) {
++			airoha_wed_disable_dma(wed);
++			/* A WED reset does not prove that the external WDMA stopped. */
++			err = airoha_wed_dma_idle(wed);
++			if (!err) {
++				aw->stop_reset_successes++;
++				dev_info(aw->dev,
++					 "hg5585f-wifi: component=wed event=stop_recovered\n");
++			}
++		}
+ 	}
+ 	airoha_wed_write(wed, MTK_WED_WPDMA_INT_TRIGGER, 0);
+ 	airoha_wed_write(wed, MTK_WED_WDMA_INT_TRIGGER, 0);
+ 	wed->running = false;
++	aw->last_dma_stop_error = err;
+ 	if (err) {
+ 		aw->poisoned = true;
+-		dev_err(aw->dev, "hg5585f-wifi: component=wed event=reset_failed dma_memory=retained\n");
++		dev_err(aw->dev,
++			"hg5585f-wifi: component=wed event=reset_failed stage=%s error=%d dma_memory=retained\n",
++			aw->last_stop_stage, err);
+ 	}
+ 
+ 	return err;
+@@ -739,13 +794,20 @@
+ 	int err, dma_err;
+ 
+ 	mutex_lock(&aw->quiesce_lock);
++	/* Reject new flow replacements while the existing rules are drained. */
++	WRITE_ONCE(wed->running, false);
+ 	err = aw->ppe->ops.flush_wed(aw->ppe, U16_MAX);
++	aw->last_flush_error = err;
+ 	dma_err = airoha_wed_quiesce(wed);
+ 	if (!err)
+ 		err = dma_err;
+ 	if (!err && (aw->poisoned || wed->dma_quarantined))
+ 		err = -EIO;
++	aw->last_stop_error = err;
+ 	if (err) {
++		dev_err(aw->dev,
++			"hg5585f-wifi: component=wed event=stop_failed ppe_error=%d dma_error=%d error=%d stage=%s\n",
++			aw->last_flush_error, dma_err, err, aw->last_stop_stage);
+ 		wed->dma_quarantined = true;
+ 		aw->poisoned = true;
+ 		if (!xchg(&aw->irq_disabled, true))
+@@ -1303,6 +1365,11 @@
+ 		   atomic_read(&aw->irq_count), atomic_read(&aw->irq_error_count));
+ 	seq_printf(s, "irq_last_status: %08x\nirq_last_errors: %08x\n",
+ 		   READ_ONCE(aw->irq_last_status), READ_ONCE(aw->irq_last_errors));
++	seq_printf(s, "last_stop_stage: %s\nlast_stop_error: %d\nlast_dma_stop_error: %d\nlast_flush_error: %d\n",
++		   READ_ONCE(aw->last_stop_stage) ?: "none", READ_ONCE(aw->last_stop_error),
++		   READ_ONCE(aw->last_dma_stop_error), READ_ONCE(aw->last_flush_error));
++	seq_printf(s, "stop_reset_attempts: %u\nstop_reset_successes: %u\n",
++		   READ_ONCE(aw->stop_reset_attempts), READ_ONCE(aw->stop_reset_successes));
+ 	seq_printf(s, "tx_path: ppe-wdma1-wed1-mt7916\nrx_path: %s\n",
+ 		   aw->legacy ? "npu" : "native");
+ 	seq_printf(s, "ppe_configured: %u\ntokens_reserved: %u\n",
diff --git a/package/kernel/mt76/patches/129-mt7915-report-dma-quiesce-errors.patch b/package/kernel/mt76/patches/129-mt7915-report-dma-quiesce-errors.patch
new file mode 100644
--- /dev/null
+++ b/package/kernel/mt76/patches/129-mt7915-report-dma-quiesce-errors.patch
@@ -0,0 +1,22 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt7915: report separate WED and NPU stop errors
+
+Report WED and NPU quiesce errors before the existing joint terminal
+quarantine. Do not treat WED stop failure as proof of an NPU stop error.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/mt7915/dma.c b/mt7915/dma.c
+--- a/mt7915/dma.c
++++ b/mt7915/dma.c
+@@ -264,6 +264,10 @@
+ 		if (mtk_wed_device_active(wed))
+ 			wed_err = mtk_wed_device_quiesce(wed);
+ 		err = mt7915_npu_legacy_quiesce(dev);
++		if (err || wed_err)
++			dev_err(dev->mt76.dev,
++				"hg5585f-wifi: component=mt7915 event=dma_quiesce_failed wed_error=%d npu_error=%d\n",
++				wed_err, err);
+ #ifdef CONFIG_NET_AIROHA_WED
+ 		if ((err || wed_err) && mtk_wed_device_active(wed)) {
+ 			struct airoha_npu *npu;
diff --git a/scripts/check-hg5585f-offload.py b/scripts/check-hg5585f-offload.py
--- a/scripts/check-hg5585f-offload.py
+++ b/scripts/check-hg5585f-offload.py
@@ -26,6 +26,7 @@
     '949-net-airoha-classify-wed-irqs-and-drain-faults.patch',
     '950-net-airoha-record-wed-first-error-and-txfree.patch',
     '951-net-airoha-mask-benign-tkid-without-payload.patch',
+    '952-net-airoha-wed-stop-recovery.patch',
 )]
 patches += sorted((root / 'package/kernel/mt76/patches').glob('*.patch'))
 for patch in patches:
diff --git a/scripts/tests/test-wed-stop.py b/scripts/tests/test-wed-stop.py
new file mode 100644
--- /dev/null
+++ b/scripts/tests/test-wed-stop.py
@@ -0,0 +1,213 @@
+#!/usr/bin/env python3
+"""Execute the real WED stop functions with DMA and reset failure injection."""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def function(text, name, kind):
+    match = re.search(r'^'+re.escape(kind)+r'\s+'+name+r'\(', text, re.M)
+    assert match, name
+    brace = text.index('{', match.start())
+    end, depth = brace+1, 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[match.start():end]
+
+
+MODEL = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+#include <errno.h>
+typedef uint32_t u32;
+typedef uint16_t u16;
+#define BIT(n) (1U<<(n))
+#define GENMASK(h,l) ((UINT32_MAX>>(31-(h))) & (UINT32_MAX<<(l)))
+#define U16_MAX UINT16_MAX
+#define READ_ONCE(x) (x)
+#define WRITE_ONCE(x,v) ((x)=(v))
+#define xchg(p,v) ({ __typeof__(*(p)) old=*(p);*(p)=(v);old; })
+struct device { int unused; };
+struct mutex { bool held; };
+struct airoha_ppe_dev { struct { int (*flush_wed)(struct airoha_ppe_dev *,u16); } ops; };
+struct airoha_wed {
+    char *base,*wdma; struct device *dev; struct airoha_ppe_dev *ppe;
+    struct mutex quiesce_lock; bool poisoned,irq_disabled; int irq;
+    const char *last_stop_stage;
+    int last_stop_error,last_dma_stop_error,last_flush_error;
+    u32 stop_reset_attempts,stop_reset_successes;
+};
+struct mtk_wed_device { struct airoha_wed *priv; bool running,init_done,dma_quarantined; };
+static u32 wed_regs[0xb00/4],wdma_regs[0x400/4];
+static unsigned int reset_calls,irq_disables,flush_calls,index_writes,idle_calls;
+static int before_stage,after_stage,reset_error,flush_error;
+static bool unreadable;
+static char messages[8192];
+static struct airoha_wed *airoha_wed_priv(struct mtk_wed_device *wed) { return wed->priv; }
+static void note(const char *format,...)
+{
+    va_list args;va_start(args,format);
+    size_t used=strlen(messages);
+    vsnprintf(messages+used,sizeof(messages)-used,format,args);va_end(args);
+}
+#define dev_err(dev,...) do { (void)(dev);note(__VA_ARGS__); } while(0)
+#define dev_warn(dev,...) do { (void)(dev);note(__VA_ARGS__); } while(0)
+#define dev_info(dev,...) do { (void)(dev);note(__VA_ARGS__); } while(0)
+static u32 readl(const void *p) { return *(const u32 *)p; }
+static void writel(u32 v,void *p)
+{
+    if(p==(void *)((char *)wdma_regs+MTK_WDMA_RESET_IDX))index_writes++;
+    *(u32 *)p=v;
+}
+static u32 airoha_wed_read(struct mtk_wed_device *wed,u32 offset)
+{ return readl(wed->priv->base+offset); }
+static void airoha_wed_write(struct mtk_wed_device *wed,u32 offset,u32 value)
+{ writel(value,wed->priv->base+offset); }
+static void airoha_wed_rmw(struct mtk_wed_device *wed,u32 offset,u32 mask,u32 value)
+{ airoha_wed_write(wed,offset,(airoha_wed_read(wed,offset)&~mask)|value); }
+static void airoha_wed_irq_mask(struct mtk_wed_device *wed,u32 mask)
+{
+    airoha_wed_write(wed,MTK_WED_INT_MASK,mask);
+    airoha_wed_write(wed,MTK_WED_EXT_INT_MASK,mask?0xffffffff:0);
+}
+static bool producers_enabled(void)
+{
+    return (wdma_regs[MTK_WDMA_GLO_CFG/4]&MTK_WDMA_GLO_CFG_RX_DMA_EN) ||
+           (wed_regs[MTK_WED_GLO_CFG/4]&EN7581_WED_DMA_ENABLE) ||
+           (wed_regs[MTK_WED_WPDMA_GLO_CFG/4]&EN7581_WED_DMA_ENABLE) ||
+           (wed_regs[MTK_WED_WDMA_GLO_CFG/4]&BIT(2));
+}
+static int idle_result(unsigned int stage)
+{
+    idle_calls++;
+    if(producers_enabled() || unreadable)return -ETIMEDOUT;
+    assert(!wed_regs[MTK_WED_INT_MASK/4] && !wed_regs[MTK_WED_EXT_INT_MASK/4]);
+    assert(!wdma_regs[MTK_WDMA_INT_MASK/4] && !wdma_regs[MTK_WDMA_INT_GRP2/4]);
+    return (reset_calls?after_stage:before_stage)==(int)stage?-ETIMEDOUT:0;
+}
+static int airoha_wdma_rx_idle(struct airoha_wed *aw)
+{ (void)aw;return idle_result(1); }
+static int airoha_wed_poll(struct airoha_wed *aw,u32 reg,u32 mask)
+{
+    (void)aw;(void)mask;
+    if(reg==MTK_WED_GLO_CFG)return idle_result(2);
+    if(reg==MTK_WED_WPDMA_GLO_CFG)return idle_result(3);
+    assert(reg==MTK_WED_WDMA_GLO_CFG);return idle_result(4);
+}
+static int airoha_wed_reset(struct mtk_wed_device *wed,u32 mask)
+{
+    assert(mask==MTK_WED_RESET_WED && !producers_enabled());reset_calls++;
+    /* Successful reset can restore enable bits; the caller must disable again. */
+    if(!reset_error)wed_regs[MTK_WED_GLO_CFG/4]=EN7581_WED_DMA_ENABLE;
+    (void)wed;return reset_error;
+}
+static void mutex_lock(struct mutex *m) { assert(!m->held);m->held=true; }
+static void mutex_unlock(struct mutex *m) { assert(m->held);m->held=false; }
+static void disable_irq(int irq) { assert(irq==27);irq_disables++; }
+static struct mtk_wed_device *active;
+static int flush_wed(struct airoha_ppe_dev *ppe,u16 wcid)
+{ (void)ppe;assert(wcid==U16_MAX && !active->running);flush_calls++;return flush_error; }
+static void initialize(struct airoha_wed *aw,struct mtk_wed_device *wed,
+                       struct airoha_ppe_dev *ppe)
+{
+    memset(aw,0,sizeof(*aw));memset(wed,0,sizeof(*wed));
+    memset(wed_regs,0,sizeof(wed_regs));memset(wdma_regs,0,sizeof(wdma_regs));
+    aw->base=(char *)wed_regs;aw->wdma=(char *)wdma_regs;aw->irq=27;aw->ppe=ppe;
+    ppe->ops.flush_wed=flush_wed;wed->priv=aw;wed->running=wed->init_done=true;active=wed;
+    reset_calls=irq_disables=flush_calls=index_writes=idle_calls=0;
+    before_stage=after_stage=reset_error=flush_error=0;unreadable=false;messages[0]=0;
+    wdma_regs[MTK_WDMA_GLO_CFG/4]=MTK_WDMA_GLO_CFG_RX_DMA_EN;
+    wed_regs[MTK_WED_GLO_CFG/4]=EN7581_WED_DMA_ENABLE;
+    wed_regs[MTK_WED_WPDMA_GLO_CFG/4]=EN7581_WED_DMA_ENABLE;
+    wed_regs[MTK_WED_WDMA_GLO_CFG/4]=BIT(2);
+    wed_regs[MTK_WED_INT_MASK/4]=wed_regs[MTK_WED_EXT_INT_MASK/4]=0xffffffff;
+    wdma_regs[MTK_WDMA_INT_MASK/4]=wdma_regs[MTK_WDMA_INT_GRP2/4]=0xffffffff;
+}
+'''
+
+TESTS = r'''
+int main(void)
+{
+    struct airoha_wed aw;struct mtk_wed_device wed;struct airoha_ppe_dev ppe;
+    initialize(&aw,&wed,&ppe);
+    assert(!airoha_wed_quiesce(&wed));
+    assert(!reset_calls && !aw.poisoned && !wed.running && wed.init_done);
+    assert(!strcmp(aw.last_stop_stage,"idle") && idle_calls==4 && !index_writes);
+    puts("PASS: disable all producers before polling; normal stop needs no reset or index writes");
+    for(int stage=1;stage<=4;stage++) {
+        initialize(&aw,&wed,&ppe);before_stage=stage;
+        assert(!airoha_wed_quiesce(&wed));
+        assert(reset_calls==1 && aw.stop_reset_attempts==1 && aw.stop_reset_successes==1);
+        assert(!aw.poisoned && !wed.init_done && !index_writes);
+        assert(!strcmp(aw.last_stop_stage,"idle") && strstr(messages,"stop_recovered"));
+    }
+    puts("PASS: one bounded WED reset retries all four DMA stages before permitting recovery");
+    for(int stage=1;stage<=4;stage++) {
+        initialize(&aw,&wed,&ppe);before_stage=1;after_stage=stage;
+        assert(airoha_wed_stop_sync(&wed)==-ETIMEDOUT);
+        assert(wed.dma_quarantined && aw.poisoned && aw.irq_disabled && irq_disables==1);
+        assert(aw.last_dma_stop_error==-ETIMEDOUT && aw.last_stop_error==-ETIMEDOUT);
+        assert(!aw.stop_reset_successes && reset_calls==1 && !index_writes);
+        const char *names[]={"wdma_rx","wed_dma","wpdma_drv","wdma_drv"};
+        assert(!strcmp(aw.last_stop_stage,names[stage-1]) && strstr(messages,"stop_failed"));
+    }
+    puts("PASS: busy external WDMA or WED drivers after reset retain quarantine and DMA ownership");
+    initialize(&aw,&wed,&ppe);before_stage=1;reset_error=-EIO;
+    assert(airoha_wed_stop_sync(&wed)==-EIO);
+    assert(!strcmp(aw.last_stop_stage,"wed_reset") && !aw.stop_reset_successes && !index_writes);
+    initialize(&aw,&wed,&ppe);unreadable=true;
+    assert(airoha_wed_stop_sync(&wed)==-ETIMEDOUT && wed.dma_quarantined);
+    assert(!aw.stop_reset_successes && !index_writes);
+    initialize(&aw,&wed,&ppe);flush_error=-EBUSY;
+    assert(airoha_wed_stop_sync(&wed)==-EBUSY);
+    assert(flush_calls==1 && !aw.last_dma_stop_error && aw.last_flush_error==-EBUSY);
+    assert(wed.dma_quarantined && !reset_calls && !aw.quiesce_lock.held);
+    initialize(&aw,&wed,&ppe);wed.dma_quarantined=true;
+    assert(airoha_wed_stop_sync(&wed)==-EIO && wed.dma_quarantined && aw.poisoned);
+    puts("PASS: reset failure, unreadable status, PPE flush failure and previous faults cannot report success");
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--kernel', type=Path, required=True)
+    parser.add_argument('--cc', default='cc')
+    parser.add_argument('--baseline', type=Path)
+    args = parser.parse_args()
+    text = (args.baseline or args.kernel/'drivers/net/ethernet/airoha/airoha_wed.c').read_text()
+    registers = (args.kernel/'drivers/net/ethernet/mediatek/mtk_wed_regs.h').read_text()
+    names = ('MTK_WDMA_RESET_IDX', 'MTK_WDMA_GLO_CFG', 'MTK_WDMA_GLO_CFG_RX_DMA_EN',
+             'MTK_WDMA_INT_MASK', 'MTK_WDMA_INT_GRP2', 'MTK_WED_RESET_WED',
+             'MTK_WED_INT_MASK', 'MTK_WED_EXT_INT_MASK', 'MTK_WED_GLO_CFG',
+             'MTK_WED_WPDMA_GLO_CFG', 'MTK_WED_WDMA_GLO_CFG',
+             'MTK_WED_WPDMA_INT_TRIGGER', 'MTK_WED_WDMA_INT_TRIGGER')
+    defines = [re.search(r'^#define '+name+r'\b[^\n]*', registers, re.M)[0] for name in names]
+    defines += [re.search(r'^#define '+name+r'\b[^\n]*', text, re.M)[0]
+                for name in ('EN7581_WED_DMA_ENABLE', 'EN7581_WED_DMA_BUSY')]
+    functions = []
+    for name, kind in (('airoha_wed_disable_dma', 'static void'),
+                       ('airoha_wed_dma_idle', 'static int')):
+        if name+'(' in text:
+            functions.append(function(text, name, kind))
+    functions += [function(text, name, 'static int') for name in
+                  ('airoha_wed_quiesce', 'airoha_wed_stop_sync')]
+    with tempfile.TemporaryDirectory(prefix='hg5585f-wed-stop-') as temporary:
+        source, binary = Path(temporary)/'stop.c', Path(temporary)/'stop'
