diff --git a/package/kernel/mt76/patches/124-mt7915-airoha-wed-native-rx-irq-map.patch b/package/kernel/mt76/patches/124-mt7915-airoha-wed-native-rx-irq-map.patch
new file mode 100644
index 0000000..71b0a52
--- /dev/null
+++ b/package/kernel/mt76/patches/124-mt7915-airoha-wed-native-rx-irq-map.patch
@@ -0,0 +1,90 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt7915: preserve WED logical events for native Airoha RX
+
+WED can consume the primary PCIe INTx status and report native RX through
+its logical bits 18/19. Forcing the native WPDMA bits 22/23 in the RX queue
+map masks the actual WED event. RX descriptors then complete without NAPI
+being scheduled, filling the ring and eventually blocking association.
+
+Keep the existing MT7916 WED event map, including native HIF2 events when
+present, and translate the primary native mask/status in both directions.
+The RX descriptor rings and packet ownership remain native.
+
+diff --git a/mt7915/dma.c b/mt7915/dma.c
+--- a/mt7915/dma.c
++++ b/mt7915/dma.c
+@@ -118,14 +118,6 @@
+ 				   MT7915_TXQ_BAND1);
+ 		}
+ 	}
+-
+-	/* WED1 handles TX only. Data RX stays on both native PCIe HIFs. */
+-	if (mt76_wed_is_airoha(&dev->mt76)) {
+-		RXQ_CONFIG(MT_RXQ_MAIN, WFDMA0, MT_INT_RX_DONE_BAND0_MT7916,
+-			   MT7916_RXQ_BAND0);
+-		RXQ_CONFIG(MT_RXQ_BAND1, WFDMA0, MT_INT_RX_DONE_BAND1_MT7916,
+-			   MT7916_RXQ_BAND1);
+-	}
+ }
+ 
+ static void __mt7915_dma_prefetch(struct mt7915_dev *dev, u32 ofs)
+diff --git a/mt7915/mmio.c b/mt7915/mmio.c
+--- a/mt7915/mmio.c
++++ b/mt7915/mmio.c
+@@ -795,17 +795,40 @@
+ 	return 0;
+ }
+ 
+-/* The native WA event and WED TX-free interrupt both use bit 1. Keep
+- * the native event at its existing WED logical bit 17 in the poll mask.
++/* WED reports RX through logical bits 18/19 while native WPDMA uses
++ * bits 22/23. The primary PCIe interrupt can be consumed by WED polling,
++ * so native RX DMA queues must still listen to the WED logical events.
++ * Native WA bit 1 is represented by logical bit 17 to avoid TX-free.
+  */
+ static u32 mt7915_airoha_native_irq_mask(u32 mask)
+ {
+ 	u32 native = mask & ~(MT_INT_WED_RX_DONE_WA_MAIN_MT7916 |
+-			      MT_INT_WED_RX_DONE_WA_MT7916);
++			      MT_INT_WED_RX_DONE_WA_MT7916 |
++			      MT_INT_WED_RX_DONE_BAND0_MT7916 |
++			      MT_INT_WED_RX_DONE_BAND1_MT7916);
+ 
+ 	if (mask & MT_INT_WED_RX_DONE_WA_MT7916)
+ 		native |= MT_INT_RX_DONE_WA;
++	if (mask & MT_INT_WED_RX_DONE_BAND0_MT7916)
++		native |= MT_INT_RX_DONE_BAND0_MT7916;
++	if (mask & MT_INT_WED_RX_DONE_BAND1_MT7916)
++		native |= MT_INT_RX_DONE_BAND1_MT7916;
+ 	return native;
++}
++
++static u32 mt7915_airoha_native_irq_status(struct mt7915_dev *dev, u32 native)
++{
++	u32 intr = native & ~(MT_INT_RX_DONE_WA |
++			      MT_INT_RX_DONE_BAND0_MT7916 |
++			      MT_INT_RX_DONE_BAND1_MT7916);
++
++	if (native & MT_INT_RX_DONE_WA)
++		intr |= MT_INT_WED_RX_DONE_WA_MT7916;
++	if (native & MT_INT_RX_DONE_BAND0_MT7916)
++		intr |= MT_INT_RX(MT_RXQ_MAIN);
++	if (native & MT_INT_RX_DONE_BAND1_MT7916)
++		intr |= MT_INT_RX(MT_RXQ_BAND1);
++	return intr;
+ }
+ 
+ void mt7915_dual_hif_set_irq_mask(struct mt7915_dev *dev,
+@@ -865,11 +888,7 @@
+ 			native = mt76_rr(dev, MT_INT_SOURCE_CSR) &
+ 				 mt7915_airoha_native_irq_mask(dev->mt76.mmio.irqmask);
+ 			mt76_wr(dev, MT_INT_SOURCE_CSR, native);
+-			if (native & MT_INT_RX_DONE_WA) {
+-				native &= ~MT_INT_RX_DONE_WA;
+-				native |= MT_INT_WED_RX_DONE_WA_MT7916;
+-			}
+-			intr |= native;
++			intr |= mt7915_airoha_native_irq_status(dev, native);
+ 		}
+ 	} else {
+ 		mt76_wr(dev, MT_INT_MASK_CSR, 0);
diff --git a/scripts/check-hg5585f-wed-rx-irq.py b/scripts/check-hg5585f-wed-rx-irq.py
new file mode 100644
index 0000000..e834d9b
--- /dev/null
+++ b/scripts/check-hg5585f-wed-rx-irq.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Exercise actual MT7916 RX queue/event maps and primary native IRQ translation."""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+
+def function(text, name):
+    match = re.search(r'^static (?:void|u32) ' + name + r'\(', text, re.M)
+    assert match, name
+    brace = text.index('{', match.start())
+    end, depth = brace + 1, 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[match.start():end]
+
+
+def enum(text, name):
+    return re.search(r'enum ' + name + r'\s*\{[\s\S]*?\};', text).group()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--mt76', type=Path, required=True)
+    parser.add_argument('--cc', default='cc')
+    args = parser.parse_args()
+    root = args.mt76
+    header = (root/'mt76.h').read_text()
+    mt7915 = (root/'mt7915/mt7915.h').read_text()
+    regs = (root/'mt7915/regs.h').read_text()
+    dma = function((root/'mt7915/dma.c').read_text(), 'mt7915_dma_config')
+    mmio = (root/'mt7915/mmio.c').read_text()
+    pieces = [r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint32_t u32;
+#define BIT(n) (1U << (n))
+#define WFDMA0 0
+#define WFDMA1 1
+''', enum(header, 'mt76_mcuq_id'), enum(header, 'mt76_rxq_id'),
+              enum(mt7915, 'mt7915_txq_id'), enum(mt7915, 'mt7915_rxq_id'),
+              enum(mt7915, 'mt7916_rxq_id')]
+    # Use the real register bit definitions and queue index macros.
+    names = set(re.findall(r'\bMT_INT_[A-Z0-9_]+', dma))
+    names |= {'MT_INT_RX_DONE_BAND0_MT7916', 'MT_INT_RX_DONE_BAND1_MT7916',
+              'MT_INT_RX_DONE_WA', 'MT_INT_WED_RX_DONE_BAND0_MT7916',
+              'MT_INT_WED_RX_DONE_BAND1_MT7916', 'MT_INT_WED_RX_DONE_WA_MT7916',
+              'MT_INT_WED_RX_DONE_WA_MAIN_MT7916'}
+    for name in sorted(names):
+        pieces.append(re.search(r'^#define ' + name + r'\s+[^\n]+', regs, re.M).group())
+    for name in ('__RXQ', '__TXQ', 'MT_INT_RX'):
+        pieces.append(re.search(r'^#define ' + name + r'\([^\n]+', regs, re.M).group())
+    pieces.append(r'''
+struct wed { bool active; };
+struct mt76_dev { int chip; bool airoha; struct { struct wed wed; } mmio; };
+struct mt7915_dev { struct mt76_dev mt76; void *hif2; u32 q_int_mask[64], q_id[64], wfdma_mask; };
+static bool is_mt7915(struct mt76_dev *dev) { return dev->chip == 0x7915; }
+static bool is_mt7916(struct mt76_dev *dev) { return dev->chip == 0x7906; }
+static bool mt76_wed_is_airoha(struct mt76_dev *dev) __attribute__((unused));
+static bool mt76_wed_is_airoha(struct mt76_dev *dev) { return dev->airoha; }
+static bool mtk_wed_device_active(struct wed *wed) { return wed->active; }
+''')
+    pieces += [dma, function(mmio, 'mt7915_airoha_native_irq_mask'),
+               function(mmio, 'mt7915_airoha_native_irq_status')]
+    pieces.append(r'''
+static void wed_case(bool hif2)
+{
+    struct mt7915_dev store = {.mt76 = {.chip = 0x7906, .airoha = true, .mmio.wed.active = true}};
+    struct mt7915_dev *dev = &store;
+    dev->hif2 = hif2 ? dev : NULL;
+    mt7915_dma_config(dev);
+    u32 main = MT_INT_RX(MT_RXQ_MAIN), band1 = MT_INT_RX(MT_RXQ_BAND1);
+    u32 wa = MT_INT_RX(MT_RXQ_MCU_WA), txfree = MT_INT_RX(MT_RXQ_MAIN_WA);
+    assert(main == BIT(18));
+    assert(band1 == (hif2 ? BIT(23) : BIT(19)));
+    assert(wa == BIT(17) && txfree == BIT(1));
+    assert(dev->q_id[__RXQ(MT_RXQ_MAIN)] == MT7916_RXQ_BAND0);
+    assert(dev->q_id[__RXQ(MT_RXQ_BAND1)] == MT7916_RXQ_BAND1);
+
+    /* Real failure: a done RX descriptor and WED status 0x00040000,
+     * masked out when the old Airoha override selected native bit 22.
+     */
+    u32 pending = BIT(18), descriptor = 0xc1db0000;
+    assert(descriptor & BIT(31));
+    assert((pending & main) == pending); /* schedules the native RX NAPI */
+    assert(!(pending & (BIT(22) | BIT(23)))); /* old queue map loses it */
+
+    u32 logical = main | band1 | wa | txfree | BIT(29);
+    u32 native = mt7915_airoha_native_irq_mask(logical);
+    assert(native == (BIT(22) | BIT(23) | BIT(1) | BIT(29)));
+    assert(mt7915_airoha_native_irq_status(dev, native) == (main | band1 | wa | BIT(29)));
+    assert(mt7915_airoha_native_irq_status(dev, BIT(1)) == wa); /* never TX-free */
+    assert(mt7915_airoha_native_irq_status(dev, BIT(22)) == main);
+    assert(mt7915_airoha_native_irq_status(dev, BIT(23)) == band1);
+    assert(!mt7915_airoha_native_irq_status(dev, 0));
+
+    /* NAPI masks/re-enables the same physical cause as it drains the ring. */
+    assert(!(mt7915_airoha_native_irq_mask(logical & ~main) & BIT(22)));
+    assert(mt7915_airoha_native_irq_mask(logical) & BIT(22));
+    assert(!(mt7915_airoha_native_irq_mask(logical & ~wa) & BIT(1)));
+    assert(!(mt7915_airoha_native_irq_mask(txfree) & BIT(1)));
+    assert(!(mt7915_airoha_native_irq_mask(logical & ~(main | band1)) & (BIT(22) | BIT(23))));
+}
+int main(void)
+{
+    wed_case(false); wed_case(true);
+    struct mt7915_dev store = {.mt76.chip = 0x7906};
+    struct mt7915_dev *dev = &store;
+    mt7915_dma_config(dev);
+    assert(MT_INT_RX(MT_RXQ_MAIN) == BIT(22) && MT_INT_RX(MT_RXQ_BAND1) == BIT(23));
+    memset(dev, 0, sizeof(*dev)); dev->mt76.chip = 0x7915;
+    mt7915_dma_config(dev);
+    assert(MT_INT_RX(MT_RXQ_MAIN) == BIT(16) && MT_INT_RX(MT_RXQ_BAND1) == BIT(17));
+    puts("PASS: WED bit 18 wakes native RX; single/dual HIF and WA/TX-free mappings preserve native masking and acknowledgement");
+}
+''')
+    with tempfile.TemporaryDirectory(prefix='hg5585f-wed-rx-irq-') as temporary:
+        source, binary = Path(temporary)/'test.c', Path(temporary)/'test'
+        source.write_text('\n'.join(pieces))
+        subprocess.run([args.cc, '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                        '-fsanitize=address,undefined', str(source), '-o', str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+
+if __name__ == '__main__':
+    main()
