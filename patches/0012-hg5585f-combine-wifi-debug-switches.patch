From: PonWrt developers <noreply@localhost>
Subject: [PATCH] hg5585f: combine firmware and lifecycle debug controls

Make hg5585f-wifi-diag control the Airoha lifecycle switch and both MT7915
WA/WM firmware debugfs log switches together. Keep every switch disabled by
default and restore the persistent setting at boot.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/files/usr/sbin/hg5585f-wifi-diag b/files/usr/sbin/hg5585f-wifi-diag
index 901230f115ec5b390388e8631662dc654db989f7..59f27a2f7fca0d81af323626660ad52b08fd93f2 100755
--- a/files/usr/sbin/hg5585f-wifi-diag
+++ b/files/usr/sbin/hg5585f-wifi-diag
@@ -5,6 +5,24 @@ umask 077
 
 parameter=/sys/module/airoha_npu/parameters/wlan_debug
 
+fw_log_paths() {
+	for path in /sys/kernel/debug/ieee80211/phy*/mt76/fw_debug_wa \
+		/sys/kernel/debug/ieee80211/phy*/mt76/fw_debug_wm; do
+		[ -w "$path" ] && printf '%s\n' "$path"
+	done
+}
+
+fw_log_runtime() {
+	kind=$1
+	value=unavailable
+	for path in /sys/kernel/debug/ieee80211/phy*/mt76/fw_debug_$kind; do
+		[ -r "$path" ] || continue
+		value=$(cat "$path" 2>/dev/null || echo unavailable)
+		break
+	done
+	printf '%s' "$value"
+}
+
 configured() {
 	value=$(uci -q get hg5585f_wifi.main.enabled 2>/dev/null || true)
 	case "$value" in
@@ -29,6 +47,9 @@ apply_runtime() {
 		return 1
 	}
 	printf '%s\n' "$1" > "$parameter"
+	for path in $(fw_log_paths); do
+		printf '%s\n' "$1" > "$path" || return 1
+	done
 	logger -t hg5585f-wifi "component=diag event=debug enabled=$1" || true
 }
 
@@ -41,7 +62,8 @@ capture() {
 
 snapshot() {
 	printf 'format=hg5585f-wifi-diag-v1\n'
-	printf 'configured=%s runtime=%s\n' "$(configured)" "$(runtime)"
+	printf 'configured=%s runtime=%s fw_wa=%s fw_wm=%s\n' \
+		"$(configured)" "$(runtime)" "$(fw_log_runtime wa)" "$(fw_log_runtime wm)"
 	capture kernel uname -a
 	capture uptime cat /proc/uptime
 	capture interrupts cat /proc/interrupts
diff --git a/scripts/check-hg5585f-wifi-diagnostics.py b/scripts/check-hg5585f-wifi-diagnostics.py
index f9b0be704113e4db5f882ef96ec1d10a0d62887a..00c0011dcc419cfbe7df9a285e7db5a02baef488 100644
--- a/scripts/check-hg5585f-wifi-diagnostics.py
+++ b/scripts/check-hg5585f-wifi-diagnostics.py
@@ -219,6 +219,8 @@ def tool_test(root):
         parameter=directory/'parameter';parameter.write_text('N\n')
         state=directory/'state';state.write_text('0')
         reports=directory/'reports';reports.mkdir()
+        debugfs=directory/'debugfs/phy0/mt76';debugfs.mkdir(parents=True)
+        wa=debugfs/'fw_debug_wa';wm=debugfs/'fw_debug_wm';wa.write_text('0\n');wm.write_text('0\n')
         device_tree=directory/'device-tree';device_tree.mkdir()
         (device_tree/'compatible').write_bytes(b'fiberhome,hg5585f-ct\0airoha,an7581\0')
         init=directory/'init';init.write_text('#!/bin/sh\nexit 0\n');init.chmod(0o755)
@@ -244,6 +246,7 @@ elif command in ('logger','sleep'):pass
         for name in ['uci','iw','logread','dmesg','logger','sleep']:
             (commands/name).symlink_to(mock)
         tool=tool.replace('/sys/module/airoha_npu/parameters/wlan_debug',str(parameter))
+        tool=tool.replace('/sys/kernel/debug/ieee80211/phy*/mt76',str(debugfs))
         tool=tool.replace('/etc/init.d/hg5585f-wifi-diag',str(init))
         tool=tool.replace('/tmp/hg5585f-wifi-diag.XXXXXX',str(reports/'hg5585f-wifi-diag.XXXXXX'))
         tool=tool.replace('/proc/device-tree/',str(device_tree)+'/')
@@ -253,6 +256,7 @@ elif command in ('logger','sleep'):pass
             return subprocess.run(['sh',str(executable),*args],env=env,capture_output=True,text=True)
         assert 'configured=0 runtime=0' in call('status').stdout
         assert call('on').returncode==0 and state.read_text()=='1' and parameter.read_text()=='1\n'
+        assert wa.read_text()=='1\n' and wm.read_text()=='1\n'
         snapshot=call('snapshot');assert not snapshot.returncode
         assert 'SECRET' not in snapshot.stdout and 'field=htmode value=HE160' in snapshot.stdout
         assert '\0' not in snapshot.stdout and 'fiberhome,hg5585f-ct\nairoha,an7581\n' in snapshot.stdout
@@ -263,6 +267,7 @@ elif command in ('logger','sleep'):pass
         for path in archive.with_suffix('').with_suffix('').glob('*.txt'):
             assert 'SECRET' not in path.read_text()
         assert call('off').returncode==0 and state.read_text()=='0' and parameter.read_text()=='0\n'
+        assert wa.read_text()=='0\n' and wm.read_text()=='0\n'
         for invalid in ['0','61','abc','-1']:
             assert call('collect',invalid).returncode==2
     print('PASS: persistent on/off, private bounded report, radio fields without passwords and real newlines')
diff --git a/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch b/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch
index a1d0c87aa18e204567e8fdf71f190757d6ef8d2d..b327548ce371a13b88aab72bd671a67c8a803a15 100644
--- a/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch
+++ b/target/linux/airoha/patches-6.18/940-net-airoha-trace-wed-attach-and-stop-irq-storm.patch
@@ -219,10 +219,10 @@ diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/air
  #include <linux/soc/airoha/airoha_wlan_legacy.h>
  
 -static bool wlan_debug;
-+static bool wlan_debug = true;
++static bool wlan_debug;
  module_param(wlan_debug, bool, 0644);
 -MODULE_PARM_DESC(wlan_debug, "HG5585F wireless lifecycle diagnostics (default off)");
-+MODULE_PARM_DESC(wlan_debug, "HG5585F wireless lifecycle diagnostics (default on)");
++MODULE_PARM_DESC(wlan_debug, "HG5585F wireless lifecycle diagnostics (default off)");
  
  bool airoha_wlan_debug_enabled(void)
  {
