From: PonWrt developers <noreply@localhost>
Subject: [PATCH] hg5585f: disable WED diagnostic hot path by default

The WED TX-free and IRQ diagnostic collectors previously ran for every
notification even when hg5585f-wifi-diag was off. Gate both callers and the
collectors on the existing wlan_debug switch, preserving full snapshots when
diagnostics are explicitly enabled while removing the normal traffic cost.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/package/kernel/mt76/patches/128-mt7915-record-airoha-txfree-diagnostics.patch b/package/kernel/mt76/patches/128-mt7915-record-airoha-txfree-diagnostics.patch
--- a/package/kernel/mt76/patches/128-mt7915-record-airoha-txfree-diagnostics.patch
+++ b/package/kernel/mt76/patches/128-mt7915-record-airoha-txfree-diagnostics.patch
@@ -11,10 +11,11 @@
 diff --git a/mt7915/mac.c b/mt7915/mac.c
 --- a/mt7915/mac.c
 +++ b/mt7915/mac.c
-@@ -3,6 +3,7 @@
+@@ -3,6 +3,8 @@
  
  #include <linux/etherdevice.h>
  #include <linux/timekeeping.h>
++#include <linux/soc/airoha/airoha_offload.h>
 +#include <linux/soc/airoha/airoha_wed_diag.h>
  #include "coredump.h"
  #include "mt7915.h"
@@ -23,7 +24,7 @@
  	u32 txd = le32_to_cpu(free->txd);
  	__le32 *cur_info;
  
-+	if (mt76_wed_is_airoha(mdev))
++	if (mt76_wed_is_airoha(mdev) && airoha_wlan_debug_enabled())
 +		airoha_wed_diag_txfree(&mdev->mmio.wed, data, len, false,
 +				       mdev->token_start, mdev->token_size);
 +
@@ -35,7 +36,7 @@
  	bool wake = false;
  	u8 i, count;
 +
-+	if (mt76_wed_is_airoha(mdev))
++	if (mt76_wed_is_airoha(mdev) && airoha_wlan_debug_enabled())
 +		airoha_wed_diag_txfree(&mdev->mmio.wed, data, len, true,
 +				       mdev->token_start, mdev->token_size);
  
diff --git a/scripts/tests/test-wed-exceptions.py b/scripts/tests/test-wed-exceptions.py
--- a/scripts/tests/test-wed-exceptions.py
+++ b/scripts/tests/test-wed-exceptions.py
