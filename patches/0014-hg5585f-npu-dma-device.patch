diff --git a/package/kernel/mt76/patches/125-mt7915-airoha-npu-preserve-dma-device.patch b/package/kernel/mt76/patches/125-mt7915-airoha-npu-preserve-dma-device.patch
new file mode 100644
index 0000000..60643e8
--- /dev/null
+++ b/package/kernel/mt76/patches/125-mt7915-airoha-npu-preserve-dma-device.patch
@@ -0,0 +1,22 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt7915: preserve NPU DMA device across WED setup
+
+NPU legacy RX allocates descriptors from the NPU DMA device. WED setup
+overwrote mt76->dma_dev with the WED device immediately before RX queue
+initialization, making the NPU queue reject the devices as mismatched with
+-EINVAL. Keep the NPU owner for the NPU profile and retain the native WED
+assignment for the TX-only profile.
+
+diff --git a/mt7915/mmio.c b/mt7915/mmio.c
+--- a/mt7915/mmio.c
++++ b/mt7915/mmio.c
+@@ -730,7 +730,8 @@
+ 	}
+ 
+ 	*irq = wed->irq;
+-	dev->mt76.dma_dev = wed->dev;
++	if (!dev->mt76.mmio.npu_legacy_rx)
++		dev->mt76.dma_dev = wed->dev;
+ 
+ 	ret = dma_set_mask(wed->dev, DMA_BIT_MASK(32));
+ 	if (ret)
diff --git a/scripts/tests/check-npu-dma-device.py b/scripts/tests/check-npu-dma-device.py
new file mode 100644
index 0000000..88dd804
--- /dev/null
+++ b/scripts/tests/check-npu-dma-device.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Check NPU RX keeps its DMA owner when WED is initialized."""
+import argparse
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--source', type=Path, required=True)
+    args = parser.parse_args()
+    text = args.source.read_text()
+    start = text.index('int mt7915_mmio_wed_init(')
+    end = text.index('\n}\n', start) + 2
+    function = text[start:end]
+    assignment = '\tdev->mt76.dma_dev = wed->dev;'
+    assert function.count(assignment) == 1
+    guard = function.index('if (!dev->mt76.mmio.npu_legacy_rx)')
+    assert guard < function.index(assignment)
+    assert function[guard:function.index(assignment)+len(assignment)].count('dma_dev') == 1
+    print('PASS: NPU RX keeps its DMA owner while native WED receives the WED DMA device')
+
+
+if __name__ == '__main__':
+    main()
