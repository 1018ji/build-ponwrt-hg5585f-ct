From: PonWrt developers <noreply@localhost>
Subject: [PATCH] tests: stub WED diagnostic switch in IRQ test

The WED IRQ test compiles the real IRQ helper in isolation. Provide the
existing runtime debug-switch stub so the default-off diagnostic guard is
covered without requiring the Airoha module at test link time.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/scripts/tests/test-wed-irq-storm.py b/scripts/tests/test-wed-irq-storm.py
--- a/scripts/tests/test-wed-irq-storm.py
+++ b/scripts/tests/test-wed-irq-storm.py
@@ -95,6 +95,7 @@
 #define dev_err(dev,...) do { (void)(dev);note(__VA_ARGS__); } while(0)
 #define dev_warn_ratelimited(dev,...) do { (void)(dev);exceptions++; } while(0)
 #define airoha_wlan_dbg(dev,...) do { (void)(dev); } while(0)
+static bool airoha_wlan_debug_enabled(void) { return false; }
 static u32 airoha_wed_read(struct mtk_wed_device *w,u32 off)
 { return w->priv->regs[off/4]; }
 static void airoha_wed_write(struct mtk_wed_device *w,u32 off,u32 value)
