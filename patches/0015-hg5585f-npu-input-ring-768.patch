+++ b/package/kernel/mt76/patches/126-mt7915-airoha-npu-input-ring-768.patch
@@ -0,0 +1,19 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt7915: initialize 768 input descriptors for HG5585F NPU RX
+
+The firmware RX loops use a fixed maximum input index of 767. Match its
+768-entry ring rather than stopping at 512 initialized entries. The ABI
+static assertion also checks the kernel header matches this queue size.
+
+diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
+--- a/mt7915/mt7915.h
++++ b/mt7915/mt7915.h
+@@ -24,7 +24,7 @@
+ #define MT7915_TX_FWDL_RING_SIZE	128
+ 
+ #define MT7915_RX_RING_SIZE		1536
+-#define MT7915_NPU_RX_RING_SIZE		512
++#define MT7915_NPU_RX_RING_SIZE		768
+ #define MT7915_RX_MCU_RING_SIZE		512
+ 
+ #define MT7915_FIRMWARE_WA		"mediatek/mt7915_wa.bin"
diff --git a/scripts/check-hg5585f-npu-input-ring.py b/scripts/check-hg5585f-npu-input-ring.py
new file mode 100644
index 0000000..e1b012e
--- /dev/null
+++ b/scripts/check-hg5585f-npu-input-ring.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Compare input geometry against the verified RV32 firmware's actual wrap code."""
+import argparse
+import hashlib
+from pathlib import Path
+import re
+import struct
+
+FIRMWARE_SHA256 = 'a8757aabc872c31d20683aeb4c05dbb9f7f590bdd6a1102c8a6902385bb5e9a6'
+
+
+def constant(text, name):
+    match = re.search(r'^#define ' + name + r'\s+(\d+)\s*$', text, re.M)
+    assert match, 'Missing numeric definition: ' + name
+    return int(match[1])
+
+
+def firmware_bound(code, offset):
+    word = struct.unpack_from('<I', code, offset)[0]
+    # RV32 ADDI a0,zero,imm; band0/band1 use the same literal upper index.
+    assert word & 0xfffff == 0x00513, hex(word)
+    immediate = word >> 20
+    return immediate - 4096 if immediate & 2048 else immediate
+
+
+def firmware_next(code, current, bound):
+    """Execute 0x8400322a..0x84003234: ADDI, SLTU, ADDI, AND."""
+    registers = [0] * 32
+    registers[9] = current  # s1, firmware consumer
+    registers[10] = bound  # a0
+    offset = 0x322a
+    while offset < 0x3234:
+        half = struct.unpack_from('<H', code, offset)[0]
+        if half & 3 != 3:
+            rd = (half >> 7) & 31
+            if half & 0xe003 == 0x0001:  # C.ADDI
+                immediate = ((half >> 2) & 31) | ((half >> 12) & 1) << 5
+                if immediate & 32:
+                    immediate -= 64
+                registers[rd] = (registers[rd] + immediate) & 0xffffffff
+            elif half & 0xfc63 == 0x8c61:  # C.AND
+                rd, rs2 = 8 + ((half >> 7) & 7), 8 + ((half >> 2) & 7)
+                registers[rd] &= registers[rs2]
+            else:
+                raise AssertionError('Unexpected compressed instruction: ' + hex(half))
+            offset += 2
+        else:
+            word = struct.unpack_from('<I', code, offset)[0]
+            assert word & 0xfe00707f == 0x3033, hex(word)  # SLTU
+            rd, rs1, rs2 = (word >> 7) & 31, (word >> 15) & 31, (word >> 20) & 31
+            registers[rd] = int(registers[rs1] < registers[rs2])
+            offset += 4
+        registers[0] = 0
+    assert offset == 0x3234
+    return registers[9]
+
+
+def first_bad_index(code, capacity, bound):
+    cursor = 0
+    for _ in range(3 * (bound + 1)):
+        if cursor >= capacity:
+            return cursor
+        cursor = firmware_next(code, cursor, bound)
+    return None
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--header', type=Path, required=True)
+    parser.add_argument('--mt76', type=Path, required=True)
+    parser.add_argument('--firmware', type=Path, required=True)
+    args = parser.parse_args()
+    code = args.firmware.read_bytes()
+    assert hashlib.sha256(code).hexdigest() == FIRMWARE_SHA256, 'NPU firmware differs from the audited ROM'
+    bound0, bound1 = firmware_bound(code, 0x3204), firmware_bound(code, 0x344e)
+    assert bound0 == bound1 == 767
+    assert firmware_next(code, 511, bound0) == 512
+    assert firmware_next(code, 767, bound0) == 0
+    assert first_bad_index(code, 512, bound0) == 512  # old driver stalls here
+    header = args.header.read_text()
+    capacity = constant(header, 'AIROHA_WLAN_LEGACY_INPUT_COUNT')
+    queue_size = constant((args.mt76/'mt7915/mt7915.h').read_text(), 'MT7915_NPU_RX_RING_SIZE')
+    assert capacity == queue_size == bound0 + 1, \
+        f'NPU input rings require {bound0+1} entries, got ABI={capacity} MT76={queue_size}'
+    assert first_bad_index(code, capacity, bound0) is None
+    assert constant(header, 'AIROHA_WLAN_LEGACY_RX_DESC_COUNT') == 256
+    setup = (args.mt76/'mt7915/npu_legacy.c').read_text()
+    assert 'writel(AIROHA_WLAN_LEGACY_INPUT_COUNT, &input->regs->ring_size)' in setup
+    assert 'writel(AIROHA_WLAN_LEGACY_INPUT_COUNT - 1, &input->regs->cpu_idx)' in setup
+    print('PASS: stock RV32 consumer passes index 511 and wraps at 768; both input rings match; host return rings remain 256')
+
+
+if __name__ == '__main__':
+    main()
