diff --git a/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch b/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/948-netfilter-flowtable-use-wifi-bridge-endpoint.patch
@@ -0,0 +1,29 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] netfilter: flowtable: use the IEEE80211 endpoint for bridge paths
+
+Route path discovery opts into DEV_PATH_IEEE80211, allowing mac80211 to
+return a regular netdev endpoint to Netfilter. Bridge discovery left the
+context flag clear and obtained the driver-specific Airoha WDMA path.
+The generic path parser rejects that path before any flow replace reaches
+PPE. Request the same IEEE80211 endpoint for bridge discovery. The PPE
+continues to discover WDMA details separately when preparing its egress.
+
+On HG5585F with an associated MT7916 client, dev_fill_bridge_path() returns
+DEV_PATH_AIROHA_WDMA without this flag and DEV_PATH_IEEE80211 with it.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/net/netfilter/nf_flow_table_path.c b/net/netfilter/nf_flow_table_path.c
+--- a/net/netfilter/nf_flow_table_path.c
++++ b/net/netfilter/nf_flow_table_path.c
+@@ -340,7 +340,9 @@
+ 				    unsigned char *dst_ha)
+ {
+ 	struct flow_offload_tuple_rhash *th = flow->tuplehash;
+-	struct net_device_path_ctx ctx = {};
++	struct net_device_path_ctx ctx = {
++		.ieee80211 = true,
++	};
+ 	struct net_device_path_stack stack;
+ 	struct nft_forward_info info = {};
+ 	int i, j = 0;
