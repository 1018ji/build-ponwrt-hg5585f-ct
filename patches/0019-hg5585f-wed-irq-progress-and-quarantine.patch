+ 	atomic_t irq_count;
++	atomic_t irq_error_count;
+ 	unsigned long irq_window;
+ 	atomic_t irq_storm;
++	u32 irq_progress[MTK_WED_TX_QUEUES * 2];
++	u32 irq_last_status;
++	u32 irq_last_errors;
++	struct work_struct irq_fault_work;
++	/* Serialize consumer teardown with deferred fault draining. */
++	struct mutex quiesce_lock;
+ };
