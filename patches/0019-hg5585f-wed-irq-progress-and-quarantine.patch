+ #define AIROHA_WED_IRQ_STORM_LIMIT	20000
+ 
+-/* Called from the mt7915 hard IRQ handler with mask 0 on every interrupt. */
+-static void airoha_wed_irq_storm_check(struct airoha_wed *aw)
+-{
++static bool airoha_wed_irq_progress(struct airoha_wed *aw)
++{
++	bool progress = false;
++	unsigned int i;
++
++	for (i = 0; i < MTK_WED_TX_QUEUES; i++) {
++		u32 tx = readl(aw->base + MTK_WED_TX_MIB(i));
++		u32 rx = readl(aw->base + MTK_WED_WDMA_RX_PROCESSED_MIB(i));
++
++		progress |= tx != aw->irq_progress[i * 2] ||
++			    rx != aw->irq_progress[i * 2 + 1];
++		aw->irq_progress[i * 2] = tx;
++		aw->irq_progress[i * 2 + 1] = rx;
++	}
++
++	return progress;
++}
++
++/* The mt7915 tasklet serializes service passes. Masking is not an IRQ. */
++static void airoha_wed_irq_storm_check(struct mtk_wed_device *wed,
++				       u32 status, u32 errors)
++{
++	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 	unsigned long now = jiffies, window = READ_ONCE(aw->irq_window);
+-	u32 raw, ext;
+-
+-	if (atomic_read(&aw->irq_storm))
++	bool error_flood;
++
++	if ((!status && !errors) || atomic_read(&aw->irq_storm))
+ 		return;
+-	if (time_after(now, window + HZ) &&
+-	    cmpxchg(&aw->irq_window, window, now) == window)
++	WRITE_ONCE(aw->irq_last_status, status);
++	WRITE_ONCE(aw->irq_last_errors, errors);
++	if (time_after(now, window + HZ)) {
++		WRITE_ONCE(aw->irq_window, now);
+ 		atomic_set(&aw->irq_count, 0);
+-	if (atomic_inc_return(&aw->irq_count) <= AIROHA_WED_IRQ_STORM_LIMIT ||
+-	    atomic_cmpxchg(&aw->irq_storm, 0, 1))
++		atomic_set(&aw->irq_error_count, 0);
++		airoha_wed_irq_progress(aw);
++	}
++	if (errors)
++		atomic_inc(&aw->irq_error_count);
++	error_flood = atomic_read(&aw->irq_error_count) > AIROHA_WED_IRQ_STORM_LIMIT;
++	if (atomic_inc_return(&aw->irq_count) <= AIROHA_WED_IRQ_STORM_LIMIT &&
++	    !error_flood)
+ 		return;
+-	/* Hard IRQ context: only the _nosync variant is safe here. */
+-	raw = readl(aw->base + MTK_WED_INT_STATUS);
+-	ext = readl(aw->base + MTK_WED_EXT_INT_STATUS);
++	/* Sample only at the threshold/window boundary, not on every packet. */
++	if (airoha_wed_irq_progress(aw) && !error_flood) {
++		atomic_set(&aw->irq_count, 0);
++		return;
++	}
++	if (atomic_cmpxchg(&aw->irq_storm, 0, 1))
++		return;
++	/* Block new rules and retain DMA ownership until the fault is drained. */
++	WRITE_ONCE(wed->dma_quarantined, true);
+ 	writel(0, aw->base + MTK_WED_INT_MASK);
+ 	writel(0, aw->base + MTK_WED_EXT_INT_MASK);
+-	/* irq_storm was won above, so this runs once. quarantine/detach test
+-	 * irq_disabled under airoha_wed_lock and must not disable it again.
+-	 */
+-	WRITE_ONCE(aw->irq_disabled, true);
+-	disable_irq_nosync(aw->irq);
++	if (!xchg(&aw->irq_disabled, true))
++		disable_irq_nosync(aw->irq);
++	schedule_work(&aw->irq_fault_work);
+ 	dev_err(aw->dev,
+-		"hg5585f-wifi: component=wed event=irq_storm count=%d raw=%08x ext=%08x; WED irq %d disabled\n",
+-		atomic_read(&aw->irq_count), raw, ext, aw->irq);
++		"hg5585f-wifi: component=wed event=irq_fault cause=%s count=%d errors=%d status=%08x ext=%08x; quarantining WED irq %d\n",
++		error_flood ? "errors" : "no_progress", atomic_read(&aw->irq_count),
++		atomic_read(&aw->irq_error_count), status, errors, aw->irq);
+ }
+ 
+ static void airoha_wed_irq_mask(struct mtk_wed_device *wed, u32 mask)
+ {
+ 	struct airoha_wed *aw = airoha_wed_priv(wed);
+ 
+-	if (!mask)
+-		airoha_wed_irq_storm_check(aw);
+ 	if (aw->poisoned || atomic_read(&aw->irq_storm))
+ 		mask = 0;
+ 	/* An extended error asserts the same IRQ even if INT_MASK is zero.
+@@ -298,7 +338,8 @@
+ 		dev_warn_ratelimited(wed->dev, "hg5585f-wifi: component=wed event=exception status=0x%08x\n", errors);
+ 	}
+ 
+-	return status;
++	airoha_wed_irq_storm_check(wed, status, errors);
++	return atomic_read(&aw->irq_storm) ? 0 : status;
+ }
