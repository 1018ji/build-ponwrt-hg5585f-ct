From: PonWrt developers <noreply@localhost>
Subject: [PATCH] debug: retain complete TX-free notification records

Increase the bounded diagnostic capture to 256 words (1 KiB), enough for
the version-0 advertised 127-record notification, and emit real newlines
through debugfs. Update the parser regression for the complete record.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/scripts/tests/test-wed-exceptions.py b/scripts/tests/test-wed-exceptions.py
index d815b15..feea1da 100644
--- a/scripts/tests/test-wed-exceptions.py
+++ b/scripts/tests/test-wed-exceptions.py
@@ -95,7 +95,7 @@ static void decode_tests(void)
     }
     memset(data,0,sizeof(data));put16(data+2,100);put32(data+4,4U<<16);
     airoha_wed_diag_decode(&r,data,sizeof(data),false,0,4096,4096,4096);
-    assert(r.truncated && !r.malformed && r.raw_words==32 && r.decoded==60);
+    assert(!r.truncated && !r.malformed && r.raw_words==256 && r.decoded==100);
     assert(r.saved_tokens==16);
     airoha_wed_diag_decode(&r,data,12,false,0,4096,4096,4096);
     assert(r.malformed && !r.truncated);
diff --git a/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch b/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
index 7c02636..f8b4fd0 100644
--- a/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
+++ b/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
@@ -290,16 +290,16 @@ diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/air
 +	memcpy(&copy->state, &aw->diag->state, sizeof(copy->state));
 +	spin_unlock_irqrestore(&aw->diag->lock, flags);
 +
-+	seq_printf(s, "format=1 atomic=0 before_w1c=1 services=%llu notifications=%llu\\n",
++	seq_printf(s, "format=1 atomic=0 before_w1c=1 services=%llu notifications=%llu\n",
 +		   copy->state.services, copy->state.notifications);
-+	seq_puts(s, "host_view=after_hardware candidates_are_not_fault_ids=1\\n");
++	seq_puts(s, "host_view=after_hardware candidates_are_not_fault_ids=1\n");
 +	for (bit = 0; bit < 32; bit++) {
 +		if (!(EN7581_WED_EXT_ERRORS & BIT(bit)))
 +			continue;
-+		seq_printf(s, "bit=%u count=%llu first=%llu last=%llu\\n", bit,
++		seq_printf(s, "bit=%u count=%llu first=%llu last=%llu\n", bit,
 +			   copy->state.count[bit], copy->state.first_ns[bit],
 +			   copy->state.last_ns[bit]);
-+		seq_printf(s, "wdma=%u,%u last=%u,%u\\n",
++		seq_printf(s, "wdma=%u,%u last=%u,%u\n",
 +			   copy->state.first_wdma[bit][0], copy->state.first_wdma[bit][1],
 +			   copy->state.last_wdma[bit][0], copy->state.last_wdma[bit][1]);
 +	}
@@ -307,24 +307,24 @@ diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/air
 +	for (i = 0; i < ARRAY_SIZE(copy->state.first); i++) {
 +		const struct airoha_wed_error_record *r = &copy->state.first[i];
 +
-+		seq_printf(s, "first bit=%u valid=%u ns=%llu service=%llu\\n",
++		seq_printf(s, "first bit=%u valid=%u ns=%llu service=%llu\n",
 +			   i ? 18 : 1, r->valid, r->ns, r->services);
-+		seq_printf(s, "status=%08x errors=%08x token_start=%u token_count=%u\\n",
++		seq_printf(s, "status=%08x errors=%08x token_start=%u token_count=%u\n",
 +			   r->status, r->errors, r->token_start, r->token_count);
 +		if (!r->valid)
 +			continue;
 +		for (j = 0; j < AIROHA_WED_DIAG_REGS; j++) {
-+			seq_printf(s, "reg=%03x value=%08x\\n",
++			seq_printf(s, "reg=%03x value=%08x\n",
 +				   airoha_wed_diag_registers[j], r->registers[j]);
 +		}
 +		seq_puts(s, "native_txfree before=");
-+		seq_printf(s, "%08x,%08x,%08x,%08x after=%08x,%08x,%08x,%08x\\n",
++		seq_printf(s, "%08x,%08x,%08x,%08x after=%08x,%08x,%08x,%08x\n",
 +			   r->native_before[0], r->native_before[1],
 +			   r->native_before[2], r->native_before[3],
 +			   r->native_after[0], r->native_after[1],
 +			   r->native_after[2], r->native_after[3]);
 +		seq_puts(s, "wpdma_txfree before=");
-+		seq_printf(s, "%08x,%08x,%08x,%08x after=%08x,%08x,%08x,%08x\\n",
++		seq_printf(s, "%08x,%08x,%08x,%08x after=%08x,%08x,%08x,%08x\n",
 +			   r->wpdma_before[0], r->wpdma_before[1],
 +			   r->wpdma_before[2], r->wpdma_before[3],
 +			   r->wpdma_after[0], r->wpdma_after[1],
@@ -332,16 +332,16 @@ diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/air
 +		for (j = 0; j < AIROHA_WED_DIAG_RINGS; j++) {
 +			const struct airoha_wed_ring_record *ring = &r->rings[j];
 +
-+			seq_printf(s, "ring=%u valid=%u before=%08x,%08x,%08x,%08x\\n",
++			seq_printf(s, "ring=%u valid=%u before=%08x,%08x,%08x,%08x\n",
 +				   j, ring->valid, ring->before[0], ring->before[1],
 +				   ring->before[2], ring->before[3]);
-+			seq_printf(s, "ring_after=%08x,%08x,%08x,%08x\\n",
++			seq_printf(s, "ring_after=%08x,%08x,%08x,%08x\n",
 +				   ring->after[0], ring->after[1], ring->after[2],
 +				   ring->after[3]);
 +			if (!ring->valid)
 +				continue;
 +			for (k = 0; k < AIROHA_WED_DIAG_DESCS; k++) {
-+				seq_printf(s, "desc=%u index=%u words=%08x,%08x,%08x,%08x\\n",
++				seq_printf(s, "desc=%u index=%u words=%08x,%08x,%08x,%08x\n",
 +					   j, ring->index[k], ring->descriptor[k][0],
 +					   ring->descriptor[k][1], ring->descriptor[k][2],
 +					   ring->descriptor[k][3]);
@@ -352,13 +352,13 @@ diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/air
 +
 +			if (!b->valid)
 +				continue;
-+			seq_printf(s, "buffer=%u dma=%08x token=%u length=%u ptr=%08x\\n",
++			seq_printf(s, "buffer=%u dma=%08x token=%u length=%u ptr=%08x\n",
 +				   b->pool_index, b->dma, b->token, b->length,
 +				   b->payload_ptr);
-+			seq_printf(s, "buffer_meta rept=%u bss=%u nbuf=%u source=%u matches=%u\\n",
++			seq_printf(s, "buffer_meta rept=%u bss=%u nbuf=%u source=%u matches=%u\n",
 +				   b->rept, b->bss, b->nbuf, b->source,
 +				   b->token_matches);
-+			seq_printf(s, "payload_valid=%u payload=%*phN\\n",
++			seq_printf(s, "payload_valid=%u payload=%*phN\n",
 +				   b->payload_valid, (int)sizeof(b->payload), b->payload);
 +		}
 +		airoha_wed_diag_show_free(s, "host_before", &r->host_before);
@@ -429,7 +429,7 @@ new file mode 100644
 +#ifndef __AIROHA_WED_DIAG_PRIVATE_H
 +#define __AIROHA_WED_DIAG_PRIVATE_H
 +
-+#define AIROHA_WED_DIAG_WORDS	32
++#define AIROHA_WED_DIAG_WORDS	256
 +#define AIROHA_WED_DIAG_TOKENS	16
 +#define AIROHA_WED_DIAG_DESCS	4
 +#define AIROHA_WED_DIAG_RINGS	5
@@ -450,7 +450,7 @@ new file mode 100644
 +	u16 station_words;
 +	u16 mpdu_words;
 +	u8 version;
-+	u8 raw_words;
++	u16 raw_words;
 +	u8 saved_tokens;
 +	bool truncated;
 +	bool malformed;
