From: PonWrt developers <noreply@localhost>
Subject: [PATCH] debug: capture TX-free candidates after first error

When the first WED error arrives before the following host notification,
attach the subsequent TX-free token candidates to the saved first-error
record. This preserves invalid pointer/length metadata for the exact
notification that follows the error and distinguishes a missing snapshot
from an invalid payload association.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/scripts/tests/test-wed-exceptions.py b/scripts/tests/test-wed-exceptions.py
index feea1da..c898794 100644
--- a/scripts/tests/test-wed-exceptions.py
+++ b/scripts/tests/test-wed-exceptions.py
@@ -147,6 +147,7 @@ static void capture_tests(void)
     assert(diag->state.count[18]==1 && diag->state.first[1].valid && diag->state.first[1].ns>stamp);
     airoha_wed_diag_txfree(&wed,data,sizeof(data),false,0,4096);
     assert(diag->state.first[0].host_after.sequence==2 && diag->state.first[1].host_after.sequence==2);
+    assert(diag->state.first[0].buffers[0].valid && diag->state.first[0].buffers[0].payload_valid);
     airoha_wed_diag_txfree(&wed,data,sizeof(data),false,0,4096);
     assert(diag->state.first[0].host_after.sequence==2 && diag->state.latest.sequence==3);
     /* Invalid geometry and pointers are recorded, never followed. */
diff --git a/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch b/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
index f8b4fd0..6310815 100644
--- a/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
+++ b/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
@@ -237,7 +237,7 @@ diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/air
 +	struct airoha_wed_free_record record;
 +	struct airoha_wed_diag *diag;
 +	unsigned long flags;
-+	unsigned int i;
++	unsigned int i, candidate;
 +
 +	if (!wed->airoha || !wed->priv)
 +		return;
@@ -250,10 +250,23 @@ diff --git a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/air
 +	spin_lock_irqsave(&diag->lock, flags);
 +	record.sequence = ++diag->state.notifications;
 +	diag->state.latest = record;
-+	for (i = 0; i < ARRAY_SIZE(diag->state.first); i++)
-+		if (diag->state.first[i].valid && record.ns >= diag->state.first[i].ns &&
-+		    !diag->state.first[i].host_after.sequence)
-+			diag->state.first[i].host_after = record;
++	for (i = 0; i < ARRAY_SIZE(diag->state.first); i++) {
++		if (!diag->state.first[i].valid || record.ns < diag->state.first[i].ns ||
++		    diag->state.first[i].host_after.sequence)
++			continue;
++		diag->state.first[i].host_after = record;
++		for (candidate = 0; candidate < record.saved_tokens &&
++		     candidate < AIROHA_WED_DIAG_BUFS; candidate++) {
++			u32 token = record.token[candidate];
++
++			if (token < wed->wlan.token_start ||
++			    token - wed->wlan.token_start >= wed->wlan.nbuf)
++				continue;
++			airoha_wed_diag_buffer(wed, &diag->state.first[i].buffers[candidate],
++				token - wed->wlan.token_start);
++			diag->state.first[i].buffers[candidate].source = 0x40 + candidate;
++		}
++	}
 +	spin_unlock_irqrestore(&diag->lock, flags);
 +}
 +EXPORT_SYMBOL_GPL(airoha_wed_diag_txfree);
