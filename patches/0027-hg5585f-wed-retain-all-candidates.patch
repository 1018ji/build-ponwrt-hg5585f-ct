From: PonWrt developers <noreply@localhost>
Subject: [PATCH] debug: retain all WED token and buffer candidates

Expand the bounded diagnostic records to retain all tokens and buffer
candidates observed in the captured TX-free notification. Keep the full
token count in a wide field so debugfs can print the complete sequence.
Give each first-error snapshot its own candidate capacity and update the
parser regression to exercise the complete 256-token storage.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/scripts/tests/test-wed-exceptions.py b/scripts/tests/test-wed-exceptions.py
--- a/scripts/tests/test-wed-exceptions.py
+++ b/scripts/tests/test-wed-exceptions.py
@@ -96,7 +96,11 @@
     memset(data,0,sizeof(data));put16(data+2,100);put32(data+4,4U<<16);
     airoha_wed_diag_decode(&r,data,sizeof(data),false,0,4096,4096,4096);
     assert(!r.truncated && !r.malformed && r.raw_words==256 && r.decoded==100);
-    assert(r.saved_tokens==16);
+    assert(r.saved_tokens==100);
+    memset(data,0,sizeof(data));put16(data+2,256);put32(data+4,4U<<16);
+    airoha_wed_diag_decode(&r,data,sizeof(data),false,0,4096,4096,4096);
+    assert(!r.truncated && !r.malformed && r.decoded==256 && r.saved_tokens==256);
+    assert(r.token[255]==0);
     airoha_wed_diag_decode(&r,data,12,false,0,4096,4096,4096);
     assert(r.malformed && !r.truncated);
     memset(data,0,sizeof(data));put16(data+2,1);put32(data+4,4U<<16);
diff --git a/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch b/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
--- a/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
+++ b/target/linux/airoha/patches-6.18/950-net-airoha-record-wed-first-error-and-txfree.patch
@@ -145,7 +145,7 @@
 +		airoha_wed_diag_ring(aw, &record->rings[3 + i], &wed->tx_ring[i], 0x600 + i * 16);
 +	}
 +	/* Candidate tokens from the preceding host view, not a claimed fault ID. */
-+	for (i = 0; i < diag->state.latest.saved_tokens && saved < AIROHA_WED_DIAG_BUFS / 2; i++) {
++	for (i = 0; i < diag->state.latest.saved_tokens && saved < AIROHA_WED_DIAG_BUFS; i++) {
 +		u32 token = diag->state.latest.token[i];
 +
 +		if (token < wed->wlan.token_start ||
@@ -231,7 +231,7 @@
 +	struct airoha_wed_free_record record;
 +	struct airoha_wed_diag *diag;
 +	unsigned long flags;
-+	unsigned int i, saved = 0;
++	unsigned int i;
 +
 +	if (!wed->airoha || !wed->priv)
 +		return;
@@ -245,7 +245,7 @@
 +	record.sequence = ++diag->state.notifications;
 +	diag->state.latest = record;
 +	for (i = 0; i < ARRAY_SIZE(diag->state.first); i++) {
-+		unsigned int candidate;
++		unsigned int candidate, saved = 0;
 +
 +		if (!diag->state.first[i].valid || record.ns < diag->state.first[i].ns ||
 +		    diag->state.first[i].host_after.sequence)
@@ -438,11 +438,11 @@
 +#define __AIROHA_WED_DIAG_PRIVATE_H
 +
 +#define AIROHA_WED_DIAG_WORDS	256
-+#define AIROHA_WED_DIAG_TOKENS	16
++#define AIROHA_WED_DIAG_TOKENS	256
 +#define AIROHA_WED_DIAG_DESCS	4
 +#define AIROHA_WED_DIAG_RINGS	5
 +#define AIROHA_WED_DIAG_REGS	12
-+#define AIROHA_WED_DIAG_BUFS	4
++#define AIROHA_WED_DIAG_BUFS	256
 +
 +struct airoha_wed_free_record {
 +	u64 ns;
@@ -459,7 +459,7 @@
 +	u16 mpdu_words;
 +	u8 version;
 +	u16 raw_words;
-+	u8 saved_tokens;
++	u16 saved_tokens;
 +	bool truncated;
 +	bool malformed;
 +	bool unsupported;
