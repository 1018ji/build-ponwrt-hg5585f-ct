From: PonWrt developers <noreply@localhost>
Subject: [PATCH] net: airoha: mask benign TKID without-payload status

The stock HG5585F token path reports CPU TX-free entries through the
shared notification stream. On Airoha WED, status bit 1 describes those
entries and otherwise creates a continuous interrupt/log storm while DMA
continues to make progress and the WED payload buffers remain valid.
Exclude only this status from the WED extended interrupt mask; retain all
other error bits and the existing progress/quarantine handling.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/target/linux/airoha/patches-6.18/951-net-airoha-mask-benign-tkid-without-payload.patch b/target/linux/airoha/patches-6.18/951-net-airoha-mask-benign-tkid-without-payload.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/951-net-airoha-mask-benign-tkid-without-payload.patch
@@ -0,0 +1,23 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: mask benign TKID without-payload status
+
+The stock HG5585F token path reports CPU TX-free entries through the
+shared notification stream. On Airoha WED, status bit 1 describes those
+entries and otherwise creates a continuous interrupt/log storm while DMA
+continues to make progress and the WED payload buffers remain valid.
+Exclude only this status from the WED extended interrupt mask; retain all
+other error bits and the existing progress/quarantine handling.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+--- a/drivers/net/ethernet/airoha/airoha_wed.c
++++ b/drivers/net/ethernet/airoha/airoha_wed.c
+@@ -47,7 +47,7 @@
+ #define EN7581_WED_BUFFER_SIZE		2048
+ #define EN7581_WED_BUFS_PER_PAGE		(PAGE_SIZE / EN7581_WED_BUFFER_SIZE)
+ #define EN7581_WED_PAYLOAD_SIZE		1900
+-#define EN7581_WED_EXT_ERRORS		0x006f0013
++#define EN7581_WED_EXT_ERRORS		0x006f0011
+ #define EN7581_WED_WDMA_CFG			0x50710060
+ #define EN7581_WDMA_CFG			0x5c000450
+ #define EN7581_WED_WDMA_RX_THRESH(n)	(0x940 + (n) * 4)
diff --git a/scripts/check-hg5585f-offload.py b/scripts/check-hg5585f-offload.py
--- a/scripts/check-hg5585f-offload.py
+++ b/scripts/check-hg5585f-offload.py
@@ -25,6 +25,7 @@
     '948-netfilter-flowtable-use-wifi-bridge-endpoint.patch',
     '949-net-airoha-classify-wed-irqs-and-drain-faults.patch',
     '950-net-airoha-record-wed-first-error-and-txfree.patch',
+    '951-net-airoha-mask-benign-tkid-without-payload.patch',
 )]
 patches += sorted((root / 'package/kernel/mt76/patches').glob('*.patch'))
 for patch in patches:
diff --git a/scripts/tests/test-wed-irq-storm.py b/scripts/tests/test-wed-irq-storm.py
--- a/scripts/tests/test-wed-irq-storm.py
+++ b/scripts/tests/test-wed-irq-storm.py
@@ -143,6 +143,14 @@
     initialize(&aw,&wed,&ppe);
     u32 error=MTK_WED_EXT_INT_STATUS_RX_DRV_INIT_WDMA_EN;
+    u32 benign=BIT(1);
+    airoha_wed_irq_mask(&wed,0x20);
+    aw.regs[MTK_WED_EXT_INT_STATUS/4]=benign;
+    assert(!asserted(&aw));
+    assert(!airoha_wed_irq_get(&wed,0x20));
+    assert(aw.regs[MTK_WED_EXT_INT_STATUS/4]==benign);
+    assert(aw.irq_count.v==0 && exceptions==0);
+
     airoha_wed_irq_mask(&wed,0x20);aw.regs[MTK_WED_EXT_INT_STATUS/4]=error;
     assert(error==0x80000 && asserted(&aw));
     airoha_wed_irq_mask(&wed,0);assert(!asserted(&aw));
     assert(aw.regs[MTK_WED_EXT_INT_STATUS/4]==error);
