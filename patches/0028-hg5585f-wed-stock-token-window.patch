From: PonWrt developers <noreply@localhost>
Subject: [PATCH] mt76: match stock Airoha WED token windows

Export the stock HG5585F token window split into the mt76 package patch
set. Airoha WED owns the low window while CPU TX tokens stay in the upper
window; generic MediaTek WED keeps its existing layout.

Signed-off-by: PonWrt developers <noreply@localhost>
---
diff --git a/package/kernel/mt76/patches/129-mt7915-airoha-wed-token-windows.patch b/package/kernel/mt76/patches/129-mt7915-airoha-wed-token-windows.patch
new file mode 100644
--- /dev/null
+++ b/package/kernel/mt76/patches/129-mt7915-airoha-wed-token-windows.patch
@@ -0,0 +1,105 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] mt76: match stock Airoha WED token windows
+
+The stock HG5585F path reserves the low hardware token window for WED
+buffers and keeps CPU tokens in the upper window. Select that layout only
+for the Airoha WED backend, and bound WED token accounting to its exact
+window so CPU TX-free IDs cannot be counted as WED completions.
+
+Signed-off-by: PonWrt developers <noreply@localhost>
+---
+diff --git a/mt7915/mmio.c b/mt7915/mmio.c
+index 321f3b2..51669fa 100644
+--- a/mt7915/mmio.c
++++ b/mt7915/mmio.c
+@@ -694,7 +694,15 @@ int mt7915_mmio_wed_init(struct mt7915_dev *dev, void *pdev_ptr,
+ 	wed->wlan.tx_tbit[0] = is_mt7915(&dev->mt76) ? 4 : 30;
+ 	wed->wlan.tx_tbit[1] = is_mt7915(&dev->mt76) ? 5 : 31;
+ 	wed->wlan.txfree_tbit = is_mt798x(&dev->mt76) ? 2 : 1;
+-	wed->wlan.token_start = MT7915_TOKEN_SIZE - wed->wlan.nbuf;
++	if (of_property_present(dev->mt76.dev->of_node, "airoha,wed")) {
++		/* The stock Airoha path owns the low token window; keep
++		 * mt76 CPU tokens in the upper window.
++		 */
++		dev->mt76.token_start = MT7915_HW_TOKEN_SIZE;
++		wed->wlan.token_start = 0;
++	} else {
++		wed->wlan.token_start = MT7915_TOKEN_SIZE - wed->wlan.nbuf;
++	}
+ 	wed->wlan.wcid_512 = !is_mt7915(&dev->mt76);
+ 
+ 	wed->wlan.rx_nbuf = 65536;
+diff --git a/tx.c b/tx.c
+index 4684043..cd6a646 100644
+--- a/tx.c
++++ b/tx.c
+@@ -970,6 +970,24 @@ void __mt76_set_tx_blocked(struct mt76_dev *dev, bool blocked)
+ }
+ EXPORT_SYMBOL_GPL(__mt76_set_tx_blocked);
+ 
++#ifdef CONFIG_NET_MEDIATEK_SOC_WED
++static bool mt76_token_is_wed(struct mt76_dev *dev, int token)
++{
++	struct mtk_wed_device *wed = &dev->mmio.wed;
++
++	return mtk_wed_device_active(wed) &&
++		token >= wed->wlan.token_start &&
++		token - wed->wlan.token_start < wed->wlan.nbuf;
++}
++#else
++static bool mt76_token_is_wed(struct mt76_dev *dev, int token)
++{
++	(void)dev;
++	(void)token;
++	return false;
++}
++#endif
++
+ int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi)
+ {
+ 	int token;
+@@ -989,8 +1005,7 @@ int mt76_token_consume(struct mt76_dev *dev, struct mt76_txwi_cache **ptxwi)
+ 	}
+ 
+ #ifdef CONFIG_NET_MEDIATEK_SOC_WED
+-	if (mtk_wed_device_active(&dev->mmio.wed) &&
+-	    token >= dev->mmio.wed.wlan.token_start)
++	if (mt76_token_is_wed(dev, token))
+ 		dev->wed_token_count++;
+ #endif
+ 
+@@ -1039,8 +1054,7 @@ mt76_token_release(struct mt76_dev *dev, int token, bool *wake)
+ 		}
+ 
+ #ifdef CONFIG_NET_MEDIATEK_SOC_WED
+-		if (mtk_wed_device_active(&dev->mmio.wed) &&
+-		    token >= dev->mmio.wed.wlan.token_start &&
++		if (mt76_token_is_wed(dev, token) &&
+ 		    --dev->wed_token_count == 0)
+ 			wake_up(&dev->tx_wait);
+ #endif
+diff --git a/wed.c b/wed.c
+index ae2c0f7..06c9a26 100644
+--- a/wed.c
++++ b/wed.c
+@@ -106,7 +106,7 @@ int mt76_wed_offload_enable(struct mtk_wed_device *wed)
+ 	struct mt76_dev *dev = mt76_wed_to_dev(wed);
+ 
+ 	spin_lock_bh(&dev->token_lock);
+-	dev->token_size = wed->wlan.token_start;
++	dev->token_size = wed->airoha ? wed->wlan.nbuf : wed->wlan.token_start;
+ 	spin_unlock_bh(&dev->token_lock);
+ 
+ 	return !wait_event_timeout(dev->tx_wait, !dev->wed_token_count, HZ);
+@@ -190,7 +190,10 @@ void mt76_wed_offload_disable(struct mtk_wed_device *wed)
+ 	struct mt76_dev *dev = mt76_wed_to_dev(wed);
+ 
+ 	spin_lock_bh(&dev->token_lock);
+-	dev->token_size = dev->drv->token_size;
++	if (!wed->airoha)
++		dev->token_size = dev->drv->token_size;
++	else
++		dev->token_size = wed->wlan.nbuf;
+ 	spin_unlock_bh(&dev->token_lock);
+ }
+ EXPORT_SYMBOL_GPL(mt76_wed_offload_disable);
