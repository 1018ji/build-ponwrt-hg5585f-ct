--- /dev/null
+++ b/target/linux/airoha/patches-6.18/948-net-airoha-manage-legacy-rx-DMA-lifetime.patch
@@ -0,0 +1,771 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: manage HG5585F RX DMA ownership and restart
+
+Own the NPU and independent RX copy GDMA reset resources. Stop request
+producers, wait for the copy channel, and hold both blocks in reset before
+releasing mailbox or descriptor memory. Retain DMA allocations on any
+stop failure. Reload firmware for a new RX owner after a successful stop.
+
+Validate and initialize the exact legacy packet pool and BA node memory.
+Keep the upstream PPE mailbox guard: this receive mode returns frames to
+Linux for forwarding.
+
+---
+--- a/drivers/net/ethernet/airoha/Kconfig
++++ b/drivers/net/ethernet/airoha/Kconfig
+@@ -23,7 +23,8 @@
+ 	  Support the fixed-size WLAN mailbox protocol used by the 2024
+ 	  HG5585F MT7916 firmware. Selection also requires an explicit
+ 	  airoha,wlan-firmware-abi device-tree property and firmware-name.
+-	  This provides protocol diagnostics, not a Wi-Fi data path.
++	  The MT7916 RX frontend requires a separate explicit Wi-Fi overlay.
++	  It returns received frames to Linux for forwarding.
+ 	  Upstream PPE operations are rejected for this firmware ABI.
+ 
+ config NET_AIROHA_WLAN_DIAG
+--- a/drivers/net/ethernet/airoha/airoha_npu.c
++++ b/drivers/net/ethernet/airoha/airoha_npu.c
+@@ -12,6 +12,7 @@
+ #include <linux/of_platform.h>
+ #include <linux/of_reserved_mem.h>
+ #include <linux/regmap.h>
++#include <linux/reset.h>
+ 
+ #include "airoha_eth.h"
+ #include <linux/soc/airoha/airoha_wlan_legacy.h>
+@@ -169,6 +170,314 @@
+ 	DECLARE_FLEX_ARRAY(u8, d);
+ };
+ 
++#define LEGACY_GDMA_CTRL0(_n)	(0x8 + ((_n) << 4))
++#define LEGACY_GDMA_BUSY		BIT(1)
++#define LEGACY_RX_COPY_CHANNEL	3
++
++enum airoha_npu_legacy_state {
++	LEGACY_STOPPED,
++	LEGACY_RUNNING,
++	LEGACY_FAULT,
++};
++
++struct airoha_npu_legacy_dma {
++	struct list_head list;
++	void *data;
++	dma_addr_t address;
++	size_t size;
++};
++
++struct airoha_npu_legacy {
++	/* Serializes owner changes, reset state and coherent allocations. */
++	struct mutex lock;
++	struct reset_control *npu_reset;
++	struct reset_control *gdma_reset;
++	struct device *owner;
++	void __iomem *gdma;
++	void __iomem *base;
++	void __iomem *firmware;
++	void __iomem *ba;
++	struct resource region;
++	enum airoha_npu_legacy_state state;
++	bool blocked;
++	int mbox_irq;
++	int wdt_irq[NPU_NUM_CORES];
++	int work_count;
++	struct list_head allocations;
++};
++
++static bool airoha_npu_legacy_blocked(struct airoha_npu *npu)
++{
++	return npu->legacy && READ_ONCE(npu->legacy->blocked);
++}
++
++static int airoha_npu_boot(struct airoha_npu *npu, void __iomem *base,
++			   struct resource *region);
++static int airoha_npu_legacy_stop(struct airoha_npu *npu);
++
++static void airoha_npu_legacy_free_dma(struct airoha_npu *npu)
++{
++	struct airoha_npu_legacy_dma *allocation, *tmp;
++
++	lockdep_assert_held(&npu->legacy->lock);
++	list_for_each_entry_safe(allocation, tmp, &npu->legacy->allocations, list) {
++		dma_free_coherent(npu->dev, allocation->size,
++				  allocation->data, allocation->address);
++		list_del(&allocation->list);
++		kfree(allocation);
++	}
++}
++
++void *airoha_npu_wlan_legacy_alloc(struct airoha_npu *npu, struct device *owner,
++				   size_t size, dma_addr_t *address)
++{
++	struct airoha_npu_legacy *legacy = npu->legacy;
++	struct airoha_npu_legacy_dma *allocation;
++	void *data = NULL;
++
++	if (!legacy || !owner || !size || !address)
++		return NULL;
++	mutex_lock(&legacy->lock);
++	if (legacy->owner != owner || legacy->state == LEGACY_FAULT)
++		goto out;
++	allocation = kzalloc(sizeof(*allocation), GFP_KERNEL);
++	if (!allocation)
++		goto out;
++	data = dma_alloc_coherent(npu->dev, size, address, GFP_KERNEL);
++	if (!data) {
++		kfree(allocation);
++		goto out;
++	}
++	allocation->data = data;
++	allocation->address = *address;
++	allocation->size = size;
++	list_add_tail(&allocation->list, &legacy->allocations);
++out:
++	mutex_unlock(&legacy->lock);
++	return data;
++}
++EXPORT_SYMBOL_GPL(airoha_npu_wlan_legacy_alloc);
++
++void airoha_npu_wlan_legacy_poison(struct airoha_npu *npu, struct device *owner)
++{
++	struct airoha_npu_legacy *legacy = npu->legacy;
++
++	if (!legacy)
++		return;
++	mutex_lock(&legacy->lock);
++	if (legacy->owner == owner) {
++		airoha_npu_legacy_stop(npu);
++		legacy->state = LEGACY_FAULT;
++	}
++	mutex_unlock(&legacy->lock);
++}
++EXPORT_SYMBOL_GPL(airoha_npu_wlan_legacy_poison);
++
++static int airoha_npu_assert_reset(struct reset_control *reset)
++{
++	int state, err;
++
++	err = reset_control_assert(reset);
++	if (err)
++		return err;
++	err = read_poll_timeout(reset_control_status, state, state != 0,
++				100, 10000, false, reset);
++	return state < 0 ? state : err;
++}
++
++static int airoha_npu_legacy_stop(struct airoha_npu *npu)
++{
++	struct airoha_npu_legacy *legacy = npu->legacy;
++	struct airoha_npu_core *core = &npu->cores[0];
++	int err, dma_err, drain_err = 0, i;
++	u32 value;
++
++	lockdep_assert_held(&legacy->lock);
++	if (legacy->state == LEGACY_STOPPED)
++		return 0;
++	if (legacy->state == LEGACY_FAULT) {
++		airoha_npu_assert_reset(legacy->npu_reset);
++		airoha_npu_assert_reset(legacy->gdma_reset);
++		return -EIO;
++	}
++
++	/* Finish any mailbox transaction before preventing all new requests. */
++	spin_lock_bh(&core->lock);
++	WRITE_ONCE(legacy->blocked, true);
++	spin_unlock_bh(&core->lock);
++	if (reset_control_status(legacy->npu_reset) == 0) {
++		regmap_write(npu->regmap, REG_CR_MBOX_INT_STATUS,
++			     MBOX_INT_STATUS_MASK);
++		for (i = 0; i < 2; i++)
++			regmap_clear_bits(npu->regmap, REG_IRQ_RXDONE(i),
++					  NPU_IRQ_RX_MASK(i));
++		for (i = 0; i < NPU_NUM_CORES; i++)
++			regmap_set_bits(npu->regmap, REG_WDT_TIMER_CTRL(i),
++					WDT_INTR_MASK);
++	}
++	if (legacy->mbox_irq >= 0)
++		synchronize_irq(legacy->mbox_irq);
++	for (i = 0; i < ARRAY_SIZE(npu->irqs); i++)
++		if (npu->irqs[i] > 0)
++			synchronize_irq(npu->irqs[i]);
++	for (i = 0; i < legacy->work_count; i++) {
++		if (legacy->wdt_irq[i] >= 0)
++			synchronize_irq(legacy->wdt_irq[i]);
++		cancel_work_sync(&npu->cores[i].wdt_work);
++	}
++
++	/* Stop request producers, drain the independent copy engine, then hold
++	 * both blocks in reset. A timeout never grants permission to free DMA.
++	 */
++	err = airoha_npu_assert_reset(legacy->npu_reset);
++	if (!err)
++		drain_err = readl_poll_timeout(legacy->gdma +
++			LEGACY_GDMA_CTRL0(LEGACY_RX_COPY_CHANNEL), value,
++			!(value & LEGACY_GDMA_BUSY), 10, 100000);
++	dma_err = airoha_npu_assert_reset(legacy->gdma_reset);
++	if (!err)
++		err = drain_err ? drain_err : dma_err;
++	legacy->state = err ? LEGACY_FAULT : LEGACY_STOPPED;
++
++	return err;
++}
++
++int airoha_npu_wlan_legacy_acquire(struct airoha_npu *npu, struct device *owner)
++{
++	struct airoha_npu_legacy *legacy = npu->legacy;
++	int err = 0;
++
++	if (!legacy || !owner)
++		return -EOPNOTSUPP;
++	mutex_lock(&legacy->lock);
++	if (legacy->owner && legacy->owner != owner) {
++		err = -EBUSY;
++		goto out;
++	}
++	if (legacy->state == LEGACY_FAULT) {
++		err = -EIO;
++		goto out;
++	}
++	if (legacy->state == LEGACY_STOPPED) {
