+++ b/target/linux/airoha/patches-6.18/943-net-airoha-validate-legacy-station-and-BA-controls.patch
@@ -0,0 +1,91 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: validate legacy STA/BA controls and scope RX IRQ status
+
+Command 6 resets all eight reorder sessions for the supplied WCID on
+both station insertion and removal. Validate the stock 8-bit WCID and
+3/8/9/12-bit BA fields before sending them to firmware.
+
+Return only the requested RX queue interrupt bit so acknowledging one
+shared interrupt cannot discard another queue's pending event.
+
+---
+--- a/drivers/net/ethernet/airoha/airoha_npu.c
++++ b/drivers/net/ethernet/airoha/airoha_npu.c
+@@ -533,6 +533,24 @@
+ 		wire_id = airoha_wlan_legacy_set_id(func_id);
+ 		if (wire_id < 0)
+ 			return wire_id;
++		if (func_id == WLAN_FUNC_SET_WAIT_DEL_STA ||
++		    func_id == WLAN_FUNC_SET_WAIT_BA_WIN_SIZE) {
++			__le32 payload;
++			u32 val, encoded;
++
++			if (ifindex > 1 || data_len != sizeof(payload))
++				return -EINVAL;
++			memcpy(&payload, data, sizeof(payload));
++			val = le32_to_cpu(payload);
++			if (func_id == WLAN_FUNC_SET_WAIT_DEL_STA)
++				err = airoha_wlan_legacy_sta_encode(val, &encoded);
++			else
++				err = airoha_wlan_legacy_ba_encode((val >> 3) & 0xff,
++								   val & 7, (val >> 11) & 0x1ff,
++								   val >> 20, &encoded);
++			if (err)
++				return err;
++		}
+ 	}
+ 
+ 	len = sizeof(*wlan_data) + data_len;
+@@ -668,10 +686,10 @@
+ 
+ static u32 airoha_npu_wlan_irq_status_get(struct airoha_npu *npu, int q)
+ {
+-	u32 val;
++	u32 val = 0;
+ 
+ 	regmap_read(npu->regmap, REG_IRQ_STATUS, &val);
+-	return val;
++	return val & NPU_IRQ_RX_MASK(q);
+ }
+ 
+ static void airoha_npu_wlan_irq_enable(struct airoha_npu *npu, int q)
+--- a/include/linux/soc/airoha/airoha_wlan_legacy.h
++++ b/include/linux/soc/airoha/airoha_wlan_legacy.h
+@@ -26,6 +26,7 @@
+ 	case WLAN_FUNC_SET_WAIT_TRAN_TO_CPU:
+ 	case WLAN_FUNC_SET_WAIT_BA_WIN_SIZE:
+ 	case WLAN_FUNC_SET_WAIT_DRIVER_MODEL:
++	case WLAN_FUNC_SET_WAIT_DEL_STA:
+ 	case WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR:
+ 	case WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR:
+ 	case WLAN_FUNC_SET_WAIT_IS_TEST_NOBA:
+@@ -54,6 +55,29 @@
+ 	default:
+ 		return -EOPNOTSUPP;
+ 	}
++}
++
++/* The same command resets all eight reorder sessions on STA add and delete. */
++static inline int airoha_wlan_legacy_sta_encode(unsigned int wcid, u32 *value)
++{
++	if (wcid > 255)
++		return -ERANGE;
++	*value = wcid;
++
++	return 0;
++}
++
++/* A zero window/SSN deletes the session. Never truncate a WCID or TID. */
++static inline int
++airoha_wlan_legacy_ba_encode(unsigned int wcid, unsigned int tid,
++			     unsigned int window, unsigned int ssn, u32 *value)
++{
++	if (wcid > 255 || tid > 7 || window > 511 || ssn > 4095 ||
++	    (!window && ssn))
++		return -ERANGE;
++	*value = (ssn << 20) | (window << 11) | (wcid << 3) | tid;
++
++	return 0;
+ }
+ 
+ #define AIROHA_WLAN_LEGACY_RX_DONE	BIT(0)
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/944-net-airoha-add-en7581-wed-transmit-offload.patch
@@ -0,0 +1,1238 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] net: airoha: add opt-in EN7581 WED transmit offload
+
+Provide the HG5585F WED1/WDMA1 transmit transport for MT7916 while keeping
+upstream NPU firmware for PPE and native wireless receive. Route WED flows
+through PSE port 3 with an explicit path type, queue and firmware
+destination lookup encoding.
+
+Reserve hardware tokens before publishing DMA buffers, acknowledge reset
+completion before releasing DMA memory and quarantine failed stops. Flush
+station flows using software station IDs and disable cached templates
+before WCID reuse. Keep NPU
+wireless egress and WED transport metadata separate.
+
+---
+--- a/drivers/net/ethernet/airoha/Kconfig
++++ b/drivers/net/ethernet/airoha/Kconfig
+@@ -47,6 +47,18 @@
+ 	  This driver supports the gigabit ethernet MACs in the
+ 	  Airoha SoC family.
+ 
++config NET_AIROHA_WED
++	bool "EN7581 MT7916 WED transmit offload (experimental)"
++	depends on ARCH_AIROHA && NET_AIROHA=y && OF && PCI && EXPERT
++	select NET_VENDOR_MEDIATEK
++	select NET_MEDIATEK_SOC_WED
++	default n
++	help
++	  Enable the HG5585F WED1/WDMA1 transmit provider for MT7916D.
++	  Requires an explicit WED device-tree overlay and mt7915e.wed_enable=1.
++	  Retains the upstream NPU firmware for PPE and software Wi-Fi RX.
++	  This provider does not support NPU receive offloading.
++
+ config NET_AIROHA_FLOW_STATS
+ 	default y
+ 	bool "Airoha flow stats"
+--- a/drivers/net/ethernet/airoha/Makefile
++++ b/drivers/net/ethernet/airoha/Makefile
+@@ -8,3 +8,4 @@
+ airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
+ obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
+ obj-$(CONFIG_NET_AIROHA_WLAN_DIAG) += airoha_wlan_diag.o
++obj-$(CONFIG_NET_AIROHA_WED) += airoha_wed.o
+--- a/drivers/net/ethernet/airoha/airoha_eth.h
++++ b/drivers/net/ethernet/airoha/airoha_eth.h
+@@ -25,6 +25,7 @@
+ #define AIROHA_MAX_NUM_RSTS		3
+ #define AIROHA_MAX_MTU			9220
+ #define AIROHA_MAX_RX_SIZE		16128
++#define AIROHA_WED_MTU			1518
+ #define AIROHA_MAX_PACKET_SIZE		2048
+ #define AIROHA_NUM_QOS_CHANNELS		4
+ #define AIROHA_NUM_QOS_QUEUES		8
+@@ -514,6 +515,8 @@
+ };
+ 
+ struct airoha_flow_data {
++	bool wed;
++	u16 wed_sta_id;
+ 	struct ethhdr eth;
+ 
+ 	union {
+@@ -567,6 +570,9 @@
+ 
+ 	struct rhash_head node;
