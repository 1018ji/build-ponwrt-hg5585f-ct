++
++#include "mt7915.h"
++
++static bool mt7915_npu_is_legacy(struct airoha_npu *npu)
++{
++	return npu && npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024;
++}
++
++bool mt7915_npu_legacy_active(struct mt7915_dev *dev)
++{
++	struct airoha_npu *npu;
++	bool legacy;
++
++	rcu_read_lock();
++	npu = rcu_dereference(dev->mt76.mmio.npu);
++	legacy = mt7915_npu_is_legacy(npu);
++	rcu_read_unlock();
++
++	return legacy;
++}
++
++static void mt7915_npu_legacy_fail(struct mt7915_dev *dev,
++				    struct airoha_npu *npu, int error)
++{
++	int q;
++
++	WRITE_ONCE(dev->npu_legacy_failed, true);
++	for (q = MT_RXQ_NPU0; q <= MT_RXQ_NPU1; q++) {
++		WRITE_ONCE(dev->mt76.q_rx[q].stopped, true);
++		airoha_npu_wlan_disable_irq(npu, q - MT_RXQ_NPU0);
++	}
++	/* Descriptor/page ownership stays with the queues until DMA is quiesced. */
++	dev_err_ratelimited(dev->mt76.dev, "legacy NPU state synchronization failed: %d\n",
++			    error);
++}
++
++static int mt7915_npu_legacy_send(struct mt7915_dev *dev, unsigned int band,
++				 enum airoha_npu_wlan_set_cmd command, u32 value)
++{
++	struct airoha_npu *npu;
++	__le32 payload = cpu_to_le32(value);
++	int err = 0;
++
++	rcu_read_lock();
++	npu = rcu_dereference(dev->mt76.mmio.npu);
++	if (!mt7915_npu_is_legacy(npu))
++		goto out;
++	if (READ_ONCE(dev->npu_legacy_failed)) {
++		err = -EIO;
++		goto out;
++	}
++	if (band > 1) {
++		err = -EINVAL;
++		goto out;
++	}
++	/* BAR updates also run from NAPI; never sleep inside the RCU section. */
++	err = airoha_npu_wlan_send_msg(npu, band, command, &payload,
++					 sizeof(payload), GFP_ATOMIC);
++	if (err)
++		mt7915_npu_legacy_fail(dev, npu, err);
++out:
++	rcu_read_unlock();
++
++	return err;
++}
++
++int mt7915_npu_legacy_sta_reset(struct mt7915_dev *dev, unsigned int band,
++				 unsigned int wcid)
++{
++	u32 value;
++	int err;
++
++	if (!mt7915_npu_legacy_active(dev))
++		return 0;
++	err = airoha_wlan_legacy_sta_encode(wcid, &value);
++	if (err)
++		return err;
++
++	return mt7915_npu_legacy_send(dev, band, WLAN_FUNC_SET_WAIT_DEL_STA, value);
++}
++
++int mt7915_npu_legacy_ba(struct mt7915_dev *dev, struct mt76_wcid *wcid,
++			  unsigned int tid, unsigned int window, unsigned int ssn)
++{
++	u32 value;
++	int err;
++
++	if (!mt7915_npu_legacy_active(dev))
++		return 0;
++	err = airoha_wlan_legacy_ba_encode(wcid->idx, tid, window, ssn, &value);
++	if (err)
++		return err;
++
++	return mt7915_npu_legacy_send(dev,
++		mt76_dev_phy(&dev->mt76, wcid->phy_idx)->band_idx,
++				     WLAN_FUNC_SET_WAIT_BA_WIN_SIZE, value);
++}
++
++int mt7915_npu_legacy_bar(struct mt7915_dev *dev, struct mt76_wcid *wcid,
++			   const struct sk_buff *skb)
++{
++	const struct ieee80211_bar *bar = (const void *)skb->data;
++	u32 value;
++	u16 control;
++	int err;
++
++	if (!mt7915_npu_legacy_active(dev) || !wcid)
++		return 0;
++	if (skb_headlen(skb) < sizeof(*bar))
++		return -EINVAL;
++	control = le16_to_cpu(bar->control);
++	/* The stock command represents a single TID only. */
++	if (control & IEEE80211_BAR_CTRL_MULTI_TID)
++		return -EOPNOTSUPP;
++	err = airoha_wlan_legacy_bar_encode(wcid->idx, control >> 12,
++					  le16_to_cpu(bar->start_seq_num) >> 4, &value);
++	if (err)
++		return err;
++
++	return mt7915_npu_legacy_send(dev,
++		mt76_dev_phy(&dev->mt76, wcid->phy_idx)->band_idx,
++				     WLAN_FUNC_SET_WAIT_BAR_INFO, value);
++}
++
++bool mt7915_npu_legacy_poll_complete(struct mt76_dev *mdev, enum mt76_rxq_id q)
++{
++	struct mt7915_dev *dev = container_of(mdev, struct mt7915_dev, mt76);
++	struct airoha_npu *npu;
++
++	if (q != MT_RXQ_NPU0 && q != MT_RXQ_NPU1)
++		return false;
++	rcu_read_lock();
++	npu = rcu_dereference(mdev->mmio.npu);
++	if (mt7915_npu_is_legacy(npu) && !READ_ONCE(dev->npu_legacy_failed) &&
++	    !READ_ONCE(mdev->q_rx[q].stopped))
++		airoha_npu_wlan_enable_irq(npu, q - MT_RXQ_NPU0);
++	rcu_read_unlock();
++
++	/* NPU queue IDs must never index the chip's native interrupt map. */
++	return true;
++}
