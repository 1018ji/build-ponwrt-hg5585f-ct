++static int
++mt76_npu_legacy_rx_peek(struct mt76_queue *q,
++			struct airoha_wlan_legacy_rx_meta *meta)
++{
++	struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
++	unsigned int index = q->tail;
++	int count = 1, i, err;
++
++	for (i = 0; i < count; i++) {
++		struct mt76_queue_entry *e = &q->entry[index];
++		u32 ctrl = le32_to_cpu(READ_ONCE(desc[index].ctrl));
++
++		if (!(ctrl & AIROHA_WLAN_LEGACY_RX_DONE))
++			return -EAGAIN;
++		dma_rmb();
++		if (!e->buf || e->dma_len[0] != AIROHA_WLAN_LEGACY_RX_BUF_BYTES ||
++		    upper_32_bits(e->dma_addr[0]) ||
++		    le32_to_cpu(READ_ONCE(desc[index].dma_addr)) != e->dma_addr[0])
++			return -EIO;
++		err = airoha_wlan_legacy_rx_decode(ctrl,
++			le32_to_cpu(READ_ONCE(desc[index].info)),
++			le32_to_cpu(READ_ONCE(desc[index].data)),
++			AIROHA_WLAN_LEGACY_RX_BUF_BYTES, &meta[i]);
++		if (err)
++			return err;
++		if (!i) {
++			count = meta[0].fragments;
++			if (count > q->queued || count > AIROHA_WLAN_LEGACY_RX_MAX_FRAGS)
++				return -EBADMSG;
++		}
++		index = (index + 1) % q->ndesc;
++	}
++
++	err = airoha_wlan_legacy_rx_chain(meta, count);
++	return err ? err : count;
++}
++
++static void mt76_npu_legacy_rx_retire(struct mt76_dev *dev, struct mt76_queue *q,
++				     unsigned int count, struct sk_buff *skb,
++				     const struct airoha_wlan_legacy_rx_meta *meta)
++{
++	struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
++	unsigned int i;
++
++	for (i = 0; i < count; i++) {
++		struct mt76_queue_entry *e = &q->entry[q->tail];
++
++		dma_sync_single_for_cpu(dev->dma_dev, e->dma_addr[0], e->dma_len[0],
++					page_pool_get_dma_dir(q->page_pool));
++		if (skb)
++			skb_put_data(skb, e->buf, meta[i].length);
++		dma_sync_single_for_device(dev->dma_dev, e->dma_addr[0], e->dma_len[0],
++					   page_pool_get_dma_dir(q->page_pool));
++		/* Copying keeps the page and mapping owned by this queue until stop. */
++		desc[q->tail].info = 0;
++		desc[q->tail].data = 0;
++		desc[q->tail].dma_addr = cpu_to_le32(e->dma_addr[0]);
++		desc[q->tail].software_cookie = 0;
++		dma_wmb();
++		WRITE_ONCE(desc[q->tail].ctrl, 0);
++		q->tail = (q->tail + 1) % q->ndesc;
++	}
++	dma_wmb();
++	Q_WRITE(q, dma_idx, q->tail);
++}
++
++struct sk_buff *mt76_npu_legacy_rx_dequeue(struct mt76_dev *dev,
++					 struct mt76_queue *q, u32 *info)
++{
++	struct airoha_wlan_legacy_rx_meta meta[AIROHA_WLAN_LEGACY_RX_MAX_FRAGS];
++	struct sk_buff *skb;
++	int count;
++
++	if (q->stopped || !q->queued || q->queued != q->ndesc)
++		return NULL;
++
++	count = mt76_npu_legacy_rx_peek(q, meta);
++	if (count == -EAGAIN)
++		return NULL;
++	if (count == -EIO) {
++		/* Preserve buffers and descriptors for teardown after DMA is stopped. */
++		q->stopped = true;
++		dev_err_ratelimited(dev->dev, "legacy NPU RX descriptor ownership mismatch\n");
++		return NULL;
++	}
++	if (count < 0) {
++		mt76_npu_legacy_rx_retire(dev, q, 1, NULL, NULL);
++		return ERR_PTR(count);
++	}
++
++	/* Copy into one linear skb; no partial page ownership passes to mac80211. */
++	skb = napi_alloc_skb(&dev->napi[q - dev->q_rx], meta[0].total);
++	mt76_npu_legacy_rx_retire(dev, q, count, skb, meta);
++	if (!skb)
++		return ERR_PTR(-ENOMEM);
++	*info = meta[0].info;
++	skb_reset_mac_header(skb);
++
++	return skb;
++}
++
++void mt76_npu_legacy_rx_cleanup(struct mt76_dev *dev, struct mt76_queue *q)
++{
++	int i;
++
++	/* No NPU pointer lookup: teardown can already have detached the supplier. */
++	for (i = 0; i < q->ndesc; i++) {
++		struct mt76_queue_entry *e = &q->entry[i];
++
++		if (!e->buf)
++			continue;
++		dma_sync_single_for_cpu(dev->dma_dev, e->dma_addr[0], e->dma_len[0],
++					page_pool_get_dma_dir(q->page_pool));
++		mt76_put_page_pool_buf(e->buf, false);
++		memset(e, 0, sizeof(*e));
++	}
++	memset(q->desc, 0, q->ndesc * AIROHA_WLAN_LEGACY_RX_DESC_BYTES);
++	q->head = 0;
++	q->tail = 0;
++	q->queued = 0;
++	q->stopped = false;
++}
