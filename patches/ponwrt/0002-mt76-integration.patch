++	return mt76_is_mmio(dev) && mtk_wed_device_active(&dev->mmio.wed) &&
++	       !dev->mmio.wed.airoha;
++#else
++	return false;
++#endif
++}
++
+ static inline bool mt76_npu_device_active(struct mt76_dev *dev)
+ {
+ 	return mt76_is_mmio(dev) && !!rcu_access_pointer(dev->mmio.npu);
+--- a/mt76_connac_mcu.c
++++ b/mt76_connac_mcu.c
+@@ -1326,7 +1326,8 @@
