From: PonWrt developers <noreply@localhost>
Subject: [PATCH] HG5585F mt76 integration and enabled runtime diagnostics

Apply this patch to the PonWrt root before feeds and package preparation.

---
diff --git a/package/kernel/mt76/Makefile b/package/kernel/mt76/Makefile
index 777e9d8890..116d7822a6 100644
--- a/package/kernel/mt76/Makefile
+++ b/package/kernel/mt76/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=mt76
-PKG_RELEASE:=2
+PKG_RELEASE:=13
 
 PKG_LICENSE:=BSD-3-Clause-Clear
 PKG_LICENSE_FILES:=
@@ -25,6 +25,10 @@ PKG_CONFIG_DEPENDS += \
 	CONFIG_PACKAGE_kmod-mt76x2 \
 	CONFIG_PACKAGE_kmod-mt76x2u \
 	CONFIG_PACKAGE_kmod-mt7603 \
+	CONFIG_PACKAGE_MT7915_NPU_PROBE \
+	CONFIG_PACKAGE_MT7915_NPU_RX_BACKEND \
+	CONFIG_PACKAGE_MT7915_NPU_RX \
+	CONFIG_KERNEL_NET_AIROHA_WED \
 	CONFIG_PACKAGE_CFG80211_TESTMODE
 
 STAMP_CONFIGURED_DEPENDS := $(STAGING_DIR)/usr/include/mac80211-backport/backport/autoconf.h
@@ -238,9 +242,12 @@ define KernelPackage/mt7915e
   DEPENDS+=@PCI_SUPPORT +kmod-mt76-connac +kmod-hwmon-core +kmod-thermal +@DRIVER_11AX_SUPPORT +@KERNEL_RELAY
   FILES:= $(PKG_BUILD_DIR)/mt7915/mt7915e.ko
   AUTOLOAD:=$(call AutoProbe,mt7915e)
-ifneq ($(CONFIG_TARGET_mediatek_filogic)$(CONFIG_TARGET_mediatek_mt7622),)
+ifneq ($(CONFIG_TARGET_mediatek_filogic)$(CONFIG_TARGET_mediatek_mt7622)$(CONFIG_KERNEL_NET_AIROHA_WED),)
   MODPARAMS.mt7915e:=wed_enable=Y
 endif
+ifdef CONFIG_PACKAGE_MT7915_NPU_PROBE
+  MODPARAMS.mt7915e+=npu_probe=Y
+endif
 endef
 
 define KernelPackage/mt7916-firmware
@@ -249,6 +256,38 @@ define KernelPackage/mt7916-firmware
   TITLE:=MediaTek MT7916 firmware
 endef
 
+define KernelPackage/mt7915e/config
+	config PACKAGE_MT7915_NPU_PROBE
+		bool "MT7916 Airoha NPU capability diagnostics"
+		depends on PACKAGE_kmod-mt7915e && TARGET_airoha_an7581
+		default n
+		help
+		  Build the opt-in npu_probe module parameter and debugfs snapshot.
+		  This queries NPU firmware without redirecting Wi-Fi traffic.
+
+	config PACKAGE_MT7915_NPU_RX_BACKEND
+		bool "Compile HG5585F legacy NPU RX backend (experimental)"
+		depends on PACKAGE_kmod-mt7915e && TARGET_airoha_an7581
+		default n
+		help
+		  Build the 256-slot host RX queue and packet reassembly backend.
+		  This option alone does not redirect Wi-Fi traffic. The separate
+		  RX FIT configuration enables the input ring handoff.
+
+	config PACKAGE_MT7915_NPU_RX
+		bool "HG5585F NPU receive/reorder with Linux forwarding (experimental)"
+		depends on PACKAGE_kmod-mt7915e && TARGET_airoha_an7581
+		depends on KERNEL_NET_AIROHA_NPU_HG5585F
+		select PACKAGE_MT7915_NPU_RX_BACKEND
+		select PACKAGE_airoha-hg5585f-npu-firmware
+		default n
+		help
+		  Build a separate HG5585F FIT overlay for stock NPU receive DMA
+		  and packet reordering. Receive forwarding stays in Linux.
+		  Host-managed legacy PPE plus WED adds a combined FIT overlay
+		  with WED transmit and NPU receive/reorder.
+endef
+
 define KernelPackage/mt7981-firmware
   $(KernelPackage/mt76-default)
   DEPENDS:=@TARGET_mediatek_filogic
@@ -479,6 +518,14 @@ ifdef CONFIG_PACKAGE_kmod-mt7663u
 endif
 ifdef CONFIG_PACKAGE_kmod-mt7915e
   PKG_MAKE_FLAGS += CONFIG_MT7915E=m
+  ifdef CONFIG_PACKAGE_MT7915_NPU_PROBE
+    PKG_MAKE_FLAGS += CONFIG_MT7915_NPU_PROBE=y
+    NOSTDINC_FLAGS += -DCONFIG_MT7915_NPU_PROBE
+  endif
+  ifdef CONFIG_PACKAGE_MT7915_NPU_RX_BACKEND
+    PKG_MAKE_FLAGS += CONFIG_MT76_NPU=y CONFIG_MT76_NPU_LEGACY=y
+    NOSTDINC_FLAGS += -DCONFIG_MT76_NPU -DCONFIG_MT76_NPU_LEGACY
+  endif
   ifdef CONFIG_TARGET_mediatek_filogic
     PKG_MAKE_FLAGS += CONFIG_MT798X_WMAC=y
     NOSTDINC_FLAGS += -DCONFIG_MT798X_WMAC
diff --git a/package/kernel/mt76/patches/120-mt7915-airoha-npu-capability-probe.patch b/package/kernel/mt76/patches/120-mt7915-airoha-npu-capability-probe.patch
new file mode 100644
index 0000000000..14751d2776
--- /dev/null
+++ b/package/kernel/mt76/patches/120-mt7915-airoha-npu-capability-probe.patch
@@ -0,0 +1,189 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] wifi: mt76: mt7915: add opt-in Airoha NPU capability snapshot
+
+Query verified GET operations and expose the result through debugfs.
+Do not attach the generic NPU layer, reassign DMA queues or enable PPE.
+The fixed-size stock ABI still needs a dedicated RX data path adapter.
+
+---
+--- a/mt7915/Makefile
++++ b/mt7915/Makefile
+@@ -9,3 +9,4 @@
+ mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
+ mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
+ mt7915e-$(CONFIG_DEV_COREDUMP) += coredump.o
++mt7915e-$(CONFIG_MT7915_NPU_PROBE) += npu_probe.o
+--- a/mt7915/Kconfig
++++ b/mt7915/Kconfig
+@@ -14,6 +14,16 @@
+ 
+ 	  To compile this driver as a module, choose M here.
+ 
++config MT7915_NPU_PROBE
++	bool "MT7916 Airoha NPU capability diagnostics"
++	depends on MT7915E && NET_AIROHA_NPU
++	default n
++	help
++	  Add an opt-in, read-only capability probe for an Airoha NPU
++	  referenced by the wireless PCIe node. This does not redirect
++	  wireless traffic or enable RX/TX hardware offloading.
++	  The result is exposed in the read-only npu_probe debugfs file.
++
+ config MT798X_WMAC
+ 	bool "MT798x (SoC) WMAC support"
+ 	depends on MT7915E
+--- a/mt7915/mt7915.h
++++ b/mt7915/mt7915.h
+@@ -253,6 +253,15 @@
+ 		u8 spe_idx;
+ 	} test;
+ #endif
++};
++
++struct mt7915_npu_probe {
++	bool attempted;
++	u32 abi;
++	u32 version;
++	u32 support_map;
++	u32 rx_base[2];
++	int error;
+ };
+ 
+ struct mt7915_dev {
+@@ -262,6 +271,7 @@
+ 	};
+ 
+ 	struct mt7915_hif *hif2;
++	struct mt7915_npu_probe npu_probe;
+ 	struct mt7915_reg_desc reg;
+ 	u8 q_id[MT7915_MAX_QUEUE];
+ 	u32 q_int_mask[MT7915_MAX_QUEUE];
+@@ -660,6 +670,14 @@
+ int mt7915_mcu_muru_debug_set(struct mt7915_dev *dev, bool enable);
+ int mt7915_mcu_muru_debug_get(struct mt7915_phy *phy);
+ int mt7915_mcu_wed_enable_rx_stats(struct mt7915_dev *dev);
++#ifdef CONFIG_MT7915_NPU_PROBE
++void mt7915_npu_probe(struct mt7915_dev *dev);
++void mt7915_npu_probe_debugfs(struct mt7915_dev *dev, struct dentry *dir);
++#else
++static inline void mt7915_npu_probe(struct mt7915_dev *dev) {}
++static inline void mt7915_npu_probe_debugfs(struct mt7915_dev *dev,
++					 struct dentry *dir) {}
++#endif
+ int mt7915_init_debugfs(struct mt7915_phy *phy);
+ void mt7915_debugfs_rx_fw_monitor(struct mt7915_dev *dev, const void *data, int len);
+ bool mt7915_debugfs_rx_log(struct mt7915_dev *dev, const void *data, int len);
+--- a/mt7915/pci.c
++++ b/mt7915/pci.c
+@@ -135,6 +135,7 @@
+ 
+ 	mdev = &dev->mt76;
+ 	mt7915_wfsys_reset(dev);
++	mt7915_npu_probe(dev);
+ 
+ 	ret = mt7915_mmio_wed_init(dev, pdev, true, &irq);
+ 	if (ret < 0)
+--- a/mt7915/debugfs.c
++++ b/mt7915/debugfs.c
+@@ -1308,6 +1308,7 @@
+ 	struct dentry *dir;
+ 
+ 	dir = mt76_register_debugfs_fops(phy->mt76, NULL);
++	mt7915_npu_probe_debugfs(dev, dir);
+ 
+ 	debugfs_create_file("muru_debug", 0600, dir, dev, &fops_muru_debug);
+ 	debugfs_create_file("muru_stats", 0400, dir, phy,
+--- /dev/null
++++ b/mt7915/npu_probe.c
+@@ -0,0 +1,91 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* MT7916 / Airoha NPU capability snapshot. No DMA rings are redirected. */
++#include <linux/debugfs.h>
++#include <linux/module.h>
++#include <linux/seq_file.h>
++#include <linux/soc/airoha/airoha_wlan_legacy.h>
++
++#include "mt7915.h"
++
++static bool npu_probe;
++module_param(npu_probe, bool, 0444);
++MODULE_PARM_DESC(npu_probe, "Query Airoha NPU capabilities without enabling offload");
++
++void mt7915_npu_probe(struct mt7915_dev *dev)
++{
++	struct mt7915_npu_probe *probe = &dev->npu_probe;
++	struct airoha_npu *npu;
++	u32 value;
++	int i, err;
++
++	if (!npu_probe || !is_mt7916(&dev->mt76))
++		return;
++
++	probe->attempted = true;
++	npu = airoha_npu_get(dev->mt76.dev);
++	if (IS_ERR(npu)) {
++		probe->error = PTR_ERR(npu);
++		dev_info(dev->mt76.dev, "NPU probe unavailable: %d\n", probe->error);
++		return;
++	}
++
++	probe->abi = npu->wlan_abi;
++	if (probe->abi == AIROHA_NPU_WLAN_ABI_UPSTREAM) {
++		err = mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
++				       &value, GFP_KERNEL);
++		if (err)
++			goto out;
++		probe->version = value;
++		err = mt76_npu_get_msg(npu, 0, WLAN_FUNC_GET_WAIT_NPU_SUPPORT_MAP,
++				       &value, GFP_KERNEL);
++		if (err)
++			goto out;
++		probe->support_map = value;
++	}
++
++	for (i = 0; i < ARRAY_SIZE(probe->rx_base); i++) {
++		err = mt76_npu_get_msg(npu, i, WLAN_FUNC_GET_WAIT_RXDESC_BASE,
++				       &value, GFP_KERNEL);
++		if (err)
++			goto out;
++		probe->rx_base[i] = value;
++	}
++
++out:
++	probe->error = err;
++	airoha_npu_put(npu);
++	dev_info(dev->mt76.dev,
++		 "NPU probe ABI=%u result=%d RX bases=%08x/%08x; offload disabled\n",
++		 probe->abi, probe->error, probe->rx_base[0], probe->rx_base[1]);
++}
++
++static int mt7915_npu_probe_show(struct seq_file *s, void *unused)
++{
++	struct mt7915_dev *dev = s->private;
++	struct mt7915_npu_probe *probe = &dev->npu_probe;
++
++	seq_printf(s, "attempted: %u\n", probe->attempted);
++	seq_printf(s, "error: %d\n", probe->error);
++	seq_printf(s, "abi: %u\n", probe->abi);
++	seq_printf(s, "version: %08x\n", probe->version);
++	seq_printf(s, "support_map: %08x\n", probe->support_map);
++	seq_printf(s, "rx_base_0: %08x\n", probe->rx_base[0]);
++	seq_printf(s, "rx_base_1: %08x\n", probe->rx_base[1]);
++	if (probe->abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024) {
++		seq_printf(s, "legacy_rx_desc_bytes: %u\n",
++			   AIROHA_WLAN_LEGACY_RX_DESC_BYTES);
++		seq_printf(s, "legacy_rx_desc_count: %u\n",
++			   AIROHA_WLAN_LEGACY_RX_DESC_COUNT);
++		seq_printf(s, "legacy_rx_buf_bytes: %u\n",
++			   AIROHA_WLAN_LEGACY_RX_BUF_BYTES);
++	}
++	seq_puts(s, "rx_offload: disabled\ntx_offload: disabled\n");
++	return 0;
++}
++DEFINE_SHOW_ATTRIBUTE(mt7915_npu_probe);
++
++void mt7915_npu_probe_debugfs(struct mt7915_dev *dev, struct dentry *dir)
++{
++	debugfs_create_file("npu_probe", 0400, dir, dev,
++			    &mt7915_npu_probe_fops);
++}
diff --git a/package/kernel/mt76/patches/121-npu-hg5585f-transactional-rx-backend.patch b/package/kernel/mt76/patches/121-npu-hg5585f-transactional-rx-backend.patch
new file mode 100644
index 0000000000..9cc2e2a20f
--- /dev/null
+++ b/package/kernel/mt76/patches/121-npu-hg5585f-transactional-rx-backend.patch
@@ -0,0 +1,409 @@
+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] wifi: mt76: add transactional HG5585F host RX backend
+
+Preflight complete stock-format fragment chains before touching packet
+buffers. Copy into one skb, synchronize the persistent DMA mappings back
+to the device, and only then return the descriptors. Keep malformed
+packet drops bounded, wait without consuming incomplete chains, and
+quarantine ownership mismatches.
+
+Dispatch through the NPU RX queue, NAPI and cleanup hooks only when the
+experimental backend is compiled and a queue explicitly uses the legacy
+ABI. The generic NPU initializer still rejects the legacy firmware: chip
+ring, STA/BA and PPE initialization must be implemented before hardware
+activation.
+
+---
+--- a/Makefile
++++ b/Makefile
+@@ -14,6 +14,7 @@
+ 	tx.o agg-rx.o mcu.o wed.o scan.o channel.o
+ 
+ mt76-$(CONFIG_MT76_NPU) += npu.o
++mt76-$(CONFIG_MT76_NPU_LEGACY) += npu_rx_legacy.o
+ mt76-$(CONFIG_PCI) += pci.o
+ mt76-$(CONFIG_NL80211_TESTMODE) += testmode.o
+ 
+--- a/mt76.h
++++ b/mt76.h
+@@ -44,6 +44,7 @@
+ #define MT_QFLAG_WED_RRO_EN	BIT(7)
+ #define MT_QFLAG_EMI_EN		BIT(8)
+ #define MT_QFLAG_NPU		BIT(9)
++#define MT_QFLAG_NPU_LEGACY	BIT(10)
+ 
+ #define __MT_WED_Q(_type, _n)	(MT_QFLAG_WED | \
+ 				 FIELD_PREP(MT_QFLAG_WED_TYPE, _type) | \
+@@ -1689,6 +1690,34 @@
+ int mt76_testmode_set_state(struct mt76_phy *phy, enum mt76_testmode_state state);
+ int mt76_testmode_alloc_skb(struct mt76_phy *phy, u32 len);
+ 
++#ifdef CONFIG_MT76_NPU_LEGACY
++int mt76_npu_legacy_rx_fill(struct mt76_dev *dev, struct mt76_queue *q);
++struct sk_buff *mt76_npu_legacy_rx_dequeue(struct mt76_dev *dev,
++					 struct mt76_queue *q, u32 *info);
++void mt76_npu_legacy_rx_cleanup(struct mt76_dev *dev, struct mt76_queue *q);
++#else
++static inline int mt76_npu_legacy_rx_fill(struct mt76_dev *dev, struct mt76_queue *q)
++{
++	return 0;
++}
++
++static inline struct sk_buff *
++mt76_npu_legacy_rx_dequeue(struct mt76_dev *dev, struct mt76_queue *q, u32 *info)
++{
++	return NULL;
++}
++
++static inline void
++mt76_npu_legacy_rx_cleanup(struct mt76_dev *dev, struct mt76_queue *q)
++{
++}
++#endif
++
++static inline bool mt76_queue_is_npu_legacy(struct mt76_queue *q)
++{
++	return IS_ENABLED(CONFIG_MT76_NPU_LEGACY) && (q->flags & MT_QFLAG_NPU_LEGACY);
++}
++
+ #ifdef CONFIG_MT76_NPU
+ void mt76_npu_check_ppe(struct mt76_dev *dev, struct sk_buff *skb,
+ 			u32 info);
+--- a/npu.c
++++ b/npu.c
+@@ -4,6 +4,7 @@
+  * Author: Lorenzo Bianconi <lorenzo@kernel.org>
+  */
+ #include <linux/kernel.h>
++#include <linux/soc/airoha/airoha_wlan_legacy.h>
+ #include <net/flow_offload.h>
+ #include <net/pkt_cls.h>
+ 
+@@ -17,6 +18,9 @@
+ int mt76_npu_fill_rx_queue(struct mt76_dev *dev, struct mt76_queue *q)
+ {
+ 	int nframes = 0;
++
++	if (mt76_queue_is_npu_legacy(q))
++		return mt76_npu_legacy_rx_fill(dev, q);
+ 
+ 	while (q->queued < q->ndesc - 1) {
+ 		struct airoha_npu_rx_dma_desc *desc = (void *)q->desc;
+@@ -46,6 +50,11 @@
+ void mt76_npu_queue_cleanup(struct mt76_dev *dev, struct mt76_queue *q)
+ {
+ 	spin_lock_bh(&q->lock);
++	if (mt76_queue_is_npu_legacy(q)) {
++		mt76_npu_legacy_rx_cleanup(dev, q);
++		spin_unlock_bh(&q->lock);
++		return;
++	}
+ 	while (q->queued > 0) {
+ 		struct mt76_queue_entry *e = &q->entry[q->tail];
+ 
+@@ -66,6 +75,9 @@
+ 	struct airoha_npu_rx_dma_desc *desc = (void *)q->desc;
+ 	int i, nframes, index = q->tail;
+ 	struct sk_buff *skb = NULL;
++
++	if (mt76_queue_is_npu_legacy(q))
++		return mt76_npu_legacy_rx_dequeue(dev, q, info);
+ 
+ 	nframes = FIELD_GET(NPU_RX_DMA_PKT_COUNT_MASK, desc[index].info);
+ 	nframes = max_t(int, nframes, 1);
+@@ -161,6 +173,10 @@
+ 		skb = mt76_npu_dequeue(dev, &dev->q_rx[qid], &info);
+ 		if (!skb)
+ 			break;
++		if (IS_ERR(skb)) {
++			done++;
++			continue;
++		}
+ 
+ 		dev->drv->rx_skb(dev, qid, skb, &info);
+ 		mt76_rx_poll_complete(dev, qid, napi);
+@@ -169,7 +185,8 @@
+ 
+ 	mt76_npu_fill_rx_queue(dev, &dev->q_rx[qid]);
+ out:
+-	if (done < budget && napi_complete(napi))
++	if (done < budget && napi_complete(napi) &&
++	    (!mt76_queue_is_npu_legacy(&dev->q_rx[qid]) || !dev->q_rx[qid].stopped))
+ 		dev->drv->rx_poll_complete(dev, qid);
+ 
+ 	rcu_read_unlock();
+@@ -259,26 +276,53 @@
+ {
+ 	int err, irq, qid = q - &dev->q_rx[0];
+ 	int size, index = qid - MT_RXQ_NPU0;
++	bool legacy = false, legacy_queue = false;
+ 	struct airoha_npu *npu;
+ 	const char *name;
+ 
+ 	mutex_lock(&dev->mutex);
+ 
+ 	npu = rcu_dereference_protected(dev->mmio.npu, &dev->mutex);
+-	irq = npu && index < ARRAY_SIZE(npu->irqs) ? npu->irqs[index]
++	irq = npu && index >= 0 && index < ARRAY_SIZE(npu->irqs) ? npu->irqs[index]
+ 						   : -EINVAL;
+ 	if (irq < 0) {
+ 		err = irq;
+ 		goto out;
+ 	}
+ 
++	legacy = npu->wlan_abi == AIROHA_NPU_WLAN_ABI_HG5585F_2024;
++	if (legacy && (!IS_ENABLED(CONFIG_MT76_NPU_LEGACY) || index > 1)) {
++		err = -EOPNOTSUPP;
++		goto out;
++	}
++	if (legacy && dev->dma_dev != npu->dev) {
++		err = -EINVAL;
++		goto out;
++	}
++	if (legacy && q->ndesc) {
++		err = -EBUSY;
++		goto out;
++	}
++	legacy_queue = legacy;
+ 	q->flags = MT_NPU_Q_RX(index);
++	if (legacy)
++		q->flags |= MT_QFLAG_NPU_LEGACY;
+ 	size = qid == MT_RXQ_NPU1 ? NPU_RX1_DESC_NUM : NPU_RX0_DESC_NUM;
++	if (legacy)
++		size = AIROHA_WLAN_LEGACY_RX_DESC_COUNT;
+ 	err = dev->queue_ops->alloc(dev, q, 0, size,
+ 				    MT76_NPU_RX_BUF_SIZE, 0);
+ 	if (err)
+ 		goto out;
+ 
++	if (legacy) {
++		mt76_npu_fill_rx_queue(dev, q);
++		if (q->stopped || q->queued != q->ndesc) {
++			err = -ENOMEM;
++			goto out;
++		}
++	}
++
+ 	name = devm_kasprintf(dev->dev, GFP_KERNEL, "mt76-npu.%d", index);
+ 	if (!name) {
+ 		err = -ENOMEM;
+@@ -291,9 +335,20 @@
+ 		goto out;
+ 
+ 	netif_napi_add(dev->napi_dev, &dev->napi[qid], mt76_npu_rx_poll);
+-	mt76_npu_fill_rx_queue(dev, q);
++	if (!legacy)
++		mt76_npu_fill_rx_queue(dev, q);
+ 	napi_enable(&dev->napi[qid]);
+ out:
++	if (err && legacy_queue) {
++		/* Initialization is called with the host RX DMA engines quiesced. */
++		if (q->desc && q->entry)
++			mt76_npu_legacy_rx_cleanup(dev, q);
++		if (q->page_pool) {
++			page_pool_destroy(q->page_pool);
++			q->page_pool = NULL;
++		}
++		q->ndesc = 0;
++	}
+ 	mutex_unlock(&dev->mutex);
+ 
+ 	return err;
+@@ -456,6 +511,12 @@
+ 		goto error_unlock;
+ 	}
+ 
++	/* Legacy host queues need a separate chip/STA/BA and firmware setup. */
++	if (npu->wlan_abi != AIROHA_NPU_WLAN_ABI_UPSTREAM) {
++		err = -EOPNOTSUPP;
++		goto error_npu_put;
++	}
++
+ 	ppe_dev = airoha_ppe_get_dev(dev->dev);
+ 	if (IS_ERR(ppe_dev)) {
+ 		request_module("airoha-eth");
+--- /dev/null
++++ b/npu_rx_legacy.c
+@@ -0,0 +1,182 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/* HG5585F host RX queues. The caller must quiesce DMA before cleanup. */
++#include <linux/soc/airoha/airoha_wlan_legacy.h>
++
++#include "mt76.h"
++#include "dma.h"
++
++int mt76_npu_legacy_rx_fill(struct mt76_dev *dev, struct mt76_queue *q)
++{
++	struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
++	int filled = 0;
++
++	if (q->stopped)
++		return 0;
++
++	/* Stock uses all 256 slots. Keep this initial allocation unpublished until full. */
++	while (q->queued < q->ndesc) {
++		struct mt76_queue_entry *e = &q->entry[q->head];
++		dma_addr_t address;
++		struct page *page;
++		void *buffer;
++		u32 offset;
++
++		if (e->buf) {
++			q->stopped = true;
++			dev_err_ratelimited(dev->dev, "legacy NPU RX refill owns a live slot\n");
++			break;
++		}
++		buffer = mt76_get_page_pool_buf(q, &offset, q->buf_size);
++		if (!buffer)
++			break;
++		page = virt_to_head_page(buffer);
++		address = page_pool_get_dma_addr(page) + offset;
++		if (upper_32_bits(address) ||
++		    upper_32_bits(address + AIROHA_WLAN_LEGACY_RX_BUF_BYTES - 1)) {
++			mt76_put_page_pool_buf(buffer, false);
++			q->stopped = true;
++			dev_err_ratelimited(dev->dev, "legacy NPU RX requires 32-bit DMA\n");
++			break;
++		}
++
++		e->buf = buffer;
++		e->dma_addr[0] = address;
++		e->dma_len[0] = AIROHA_WLAN_LEGACY_RX_BUF_BYTES;
++		memset(&desc[q->head], 0, sizeof(*desc));
++		desc[q->head].dma_addr = cpu_to_le32(address);
++		/* Software owns e->buf. Never trust a firmware-supplied host cookie. */
++		q->head = (q->head + 1) % q->ndesc;
++		q->queued++;
++		filled++;
++	}
++
++	if (filled && q->queued == q->ndesc) {
++		dma_wmb();
++		Q_WRITE(q, dma_idx, q->head);
++	}
