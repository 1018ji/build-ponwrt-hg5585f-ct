+From: PonWrt developers <noreply@localhost>
+Subject: [PATCH] wifi: mt76: respect the HG5585F RX producer commit
+
+The stock firmware sets DONE before writing metadata and advances its
+producer last. Bound complete fragment transactions by that committed
+index. Distinguish a full 256-slot ring from an empty ring by checking the
+predecessor and then re-reading the producer. Quarantine invalid indices
+without returning DMA pages.
+
+---
+--- a/npu_rx_legacy.c
++++ b/npu_rx_legacy.c
+@@ -78,13 +78,48 @@
+ 	return 0;
+ }
+ 
++static int mt76_npu_legacy_rx_available(struct mt76_queue *q)
++{
++	struct airoha_wlan_legacy_rx_desc *desc = (void *)q->desc;
++	u32 producer = Q_READ(q, cpu_idx);
++	unsigned int previous = (q->tail + q->ndesc - 1) % q->ndesc;
++
++	if (producer >= (unsigned int)q->ndesc)
++		return -EIO;
++	if (producer == q->tail) {
++		/* All slots are usable: DONE in the predecessor distinguishes full.
++		 * Firmware writes DONE before metadata and commits the producer last.
++		 * Re-read the producer after DONE so an in-progress wrap is not full.
++		 */
++		if (!(le32_to_cpu(READ_ONCE(desc[previous].ctrl)) &
++		      AIROHA_WLAN_LEGACY_RX_DONE))
++			return 0;
++		dma_rmb();
++		producer = Q_READ(q, cpu_idx);
++		if (producer >= (unsigned int)q->ndesc)
++			return -EIO;
++		if (producer == q->tail) {
++			dma_rmb();
++			return q->ndesc;
++		}
++	}
++	/* Metadata is valid only after the firmware's producer commit. */
++	dma_rmb();
++
++	return (producer + q->ndesc - q->tail) % q->ndesc;
++}
