From: PonWrt developers <noreply@localhost>
Subject: [PATCH] HG5585F WED TX board and FIT configuration

Apply this patch to the PonWrt root before feeds and package preparation.

---
diff --git a/target/linux/airoha/dts/an7581-fiberhome-hg5585f-common.dtsi b/target/linux/airoha/dts/an7581-fiberhome-hg5585f-common.dtsi
index 4b31b3b903..5c161d2f54 100644
--- a/target/linux/airoha/dts/an7581-fiberhome-hg5585f-common.dtsi
+++ b/target/linux/airoha/dts/an7581-fiberhome-hg5585f-common.dtsi
@@ -319,7 +319,7 @@
 	pcie@0,0 {
 		reg = <0x0000 0 0 0 0>;
 
-		wifi@0,0 {
+		hg5585f_wifi: wifi@0,0 {
 			compatible = "mediatek,mt76";
 			reg = <0x0000 0 0 0 0>;
 			nvmem-cells = <&wifi_eeprom>;
diff --git a/target/linux/airoha/dts/an7581-fiberhome-hg5585f-ct-wed.dts b/target/linux/airoha/dts/an7581-fiberhome-hg5585f-ct-wed.dts
new file mode 100644
index 0000000000..6fe0da064d
--- /dev/null
+++ b/target/linux/airoha/dts/an7581-fiberhome-hg5585f-ct-wed.dts
@@ -0,0 +1,4 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include "an7581-fiberhome-hg5585f-ct.dts"
+#include "an7581-hg5585f-wed-tx.dtsi"
diff --git a/target/linux/airoha/dts/an7581-hg5585f-wed-tx.dtsi b/target/linux/airoha/dts/an7581-hg5585f-wed-tx.dtsi
new file mode 100644
index 0000000000..f089ef74b8
--- /dev/null
+++ b/target/linux/airoha/dts/an7581-hg5585f-wed-tx.dtsi
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/reset/airoha,en7581-reset.h>
+
+/* HG5585F WED transmit with native MT7916 RX. */
+&npu {
+	reg = <0x0 0x1e900000 0x0 0x313000>,
+	      <0x0 0x1fb30000 0x0 0x2b0>;
+	reg-names = "npu", "rx-copy";
+	resets = <&scuclk EN7581_NPU_RST>, <&scuclk EN7581_GDMA_RST>;
+	reset-names = "npu", "rx-copy";
+	airoha,wlan-firmware-abi = "hg5585f-2024";
+	firmware-name = "airoha/hg5585f_npu_rv32.bin",
+			"airoha/hg5585f_npu_data.bin";
+};
+
+&eth {
+	airoha,hg5585f-ppe;
+};
+
+&{/soc} {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	hg5585f_wed1: wed@1fa03000 {
+		compatible = "airoha,en7581-wed";
+		reg = <0x0 0x1fa03000 0x0 0xb00>,
+		      <0x0 0x1fa06400 0x0 0x400>;
+		reg-names = "wed", "wdma";
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
+		airoha,pcie = <&pcie1>;
+	};
+};
+
+&hg5585f_wifi {
+	airoha,wed = <&hg5585f_wed1>;
+};
diff --git a/target/linux/airoha/image/an7581.mk b/target/linux/airoha/image/an7581.mk
index 4d697a635a..e4da15041b 100644
--- a/target/linux/airoha/image/an7581.mk
+++ b/target/linux/airoha/image/an7581.mk
@@ -199,11 +199,21 @@ define Device/fiberhome_hg5585f-images
 	append-metadata
 endef
 
+define Device/fiberhome_hg5585f-ct-wed
+  DEVICE_DTS := an7581-fiberhome-hg5585f-ct-wed
+  DEVICE_DTS_OVERLAY :=
+  DEVICE_DTC_FLAGS :=
+  DEVICE_PACKAGES += airoha-hg5585f-npu-firmware hg5585f-offload-tools
+endef
+
 define Device/fiberhome_hg5585f-ct
   $(call Device/fiberhome_hg5585f-common)
   DEVICE_MODEL := HG5585F
   DEVICE_VARIANT := CT
   DEVICE_DTS := an7581-fiberhome-hg5585f-ct
+  $(if $(and $(filter y,$(CONFIG_KERNEL_NET_AIROHA_PPE_HG5585F)), \
+      $(filter y,$(CONFIG_KERNEL_NET_AIROHA_WED))), \
+    $(call Device/fiberhome_hg5585f-ct-wed))
   DEVICE_PACKAGES += kmod-phy-maxlinear
   SUPPORTED_DEVICES += fiberhome,hg5585f-ct-usb-sfp
   $(call Device/fiberhome_hg5585f-images)
